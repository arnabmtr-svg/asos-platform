{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 ASOS Platform",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--port", "8000",
