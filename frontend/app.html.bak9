          strategies in real time. Current: VIX 13.4 · IVP 44.8% · ADX 17.2</div>
        <div class="grid4" style="margin-bottom:14px">
          <div class="card">
            <div style="font-size:10px;color:var(--t3)" class="mono">VIX</div>
            <div style="font-size:18px;font-weight:700;color:var(--gr)" id="sVix">13.4</div><input type="range" min="8"
              max="40" step=".5" value="13.4"
              oninput="document.getElementById('sVix').textContent=parseFloat(this.value).toFixed(1);scoreS()">
            <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--t3)" class="mono">
              <span>8</span><span>40</span>
            </div>
          </div>
          <div class="card">
            <div style="font-size:10px;color:var(--t3)" class="mono">IVP %</div>
            <div style="font-size:18px;font-weight:700;color:var(--am)" id="sIvp">44</div><input type="range" min="0"
              max="100" step="1" value="44" oninput="document.getElementById('sIvp').textContent=this.value;scoreS()">
            <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--t3)" class="mono">
              <span>0</span><span>100</span>
            </div>
          </div>
          <div class="card">
            <div style="font-size:10px;color:var(--t3)" class="mono">ADX (14)</div>
            <div style="font-size:18px;font-weight:700;color:var(--gr)" id="sAdx">17</div><input type="range" min="5"
              max="50" step="1" value="17" oninput="document.getElementById('sAdx').textContent=this.value;scoreS()">
            <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--t3)" class="mono">
              <span>5</span><span>50</span>
            </div>
          </div>
