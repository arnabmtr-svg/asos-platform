          <div style="font-size:12px;font-weight:700;margin-bottom:10px">Add holding manually</div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:8px">
            <div>
              <div
                style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:4px">
                Ticker</div><input id="ah-ticker" type="text" placeholder="CGPOWER"
                style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:8px 10px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none">
            </div>
            <div>
              <div
                style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:4px">
                Qty</div><input id="ah-qty" type="number" placeholder="100"
                style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:8px 10px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none">
            </div>
            <div>
              <div
                style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:4px">
                Avg price (₹)</div><input id="ah-avg" type="number" placeholder="620.50"
                style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:8px 10px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none">
            </div>
            <div>
              <div
                style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:4px">
                LTP (₹)</div><input id="ah-ltp" type="number" placeholder="935.10"
                style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:8px 10px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none">
            </div>
          </div>
          <div style="display:flex;gap:8px">
