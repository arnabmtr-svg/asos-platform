                  placeholder="Ask about your portfolio, any stock, or wealth creation..."
                  onkeydown="if(event.key==='Enter')sendScout()">
                <button class="csend" onclick="sendScout()">Ask →</button>
              </div>
            </div>
          </div>
          <div>
            <div class="sh" style="margin-top:0">Quick prompts</div>
            <div style="display:flex;flex-direction:column;gap:6px">
              <button
                style="background:var(--s2);border:1px solid var(--b1);border-radius:var(--r);padding:8px 12px;color:var(--t2);font-size:11px;text-align:left;cursor:pointer;font-family:'Space Grotesk',sans-serif;transition:all .2s"
                onmouseover="this.style.borderColor='var(--bl)'" onmouseout="this.style.borderColor='var(--b1)'"
                onclick="quickS('My CREDITACC position is showing 1 quarter of PAT decline. What should replace it in Bucket 3 that meets ROCE>22% and still targets 20% CAGR?')">🔄
                CREDITACC replacement candidate</button>
              <button
                style="background:var(--s2);border:1px solid var(--b1);border-radius:var(--r);padding:8px 12px;color:var(--t2);font-size:11px;text-align:left;cursor:pointer;font-family:'Space Grotesk',sans-serif;transition:all .2s"
                onmouseover="this.style.borderColor='var(--bl)'" onmouseout="this.style.borderColor='var(--b1)'"
                onclick="quickS('Scout 5 Indian mid-cap compounders that can deliver 20%+ CAGR over 10 years. Use ROCE>28%, D/E<0.5, Revenue CAGR>20%, FCF positive as filters. Explain each.')">🔍
                Scout next wealth creators</button>
              <button
                style="background:var(--s2);border:1px solid var(--b1);border-radius:var(--r);padding:8px 12px;color:var(--t2);font-size:11px;text-align:left;cursor:pointer;font-family:'Space Grotesk',sans-serif;transition:all .2s"
                onmouseover="this.style.borderColor='var(--bl)'" onmouseout="this.style.borderColor='var(--b1)'"
                onclick="quickS('My NIFTY Iron Condor (23400P/23300P | 24400C/24500C) is at 43% profit. ADX just crossed 19 on 15-min chart. Should I close early, hold, or add a straddle hedge?')">⚡
                IC position — should I close early?</button>
              <button
                style="background:var(--s2);border:1px solid var(--b1);border-radius:var(--r);padding:8px 12px;color:var(--t2);font-size:11px;text-align:left;cursor:pointer;font-family:'Space Grotesk',sans-serif;transition:all .2s"
                onmouseover="this.style.borderColor='var(--bl)'" onmouseout="this.style.borderColor='var(--b1)'"
