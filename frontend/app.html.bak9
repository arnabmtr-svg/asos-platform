              style="padding:7px 14px;border-radius:var(--r2);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">↻
              Refresh</button>
            <button onclick="showAddHolding()"
              style="padding:7px 14px;border-radius:var(--r2);border:none;background:var(--bl);color:#fff;font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">+
              Add manually</button>
          </div>
        </div>
        <!-- Corpus summary bar -->
        <div class="grid6" style="margin-bottom:14px" id="holdingsSummaryBar">
