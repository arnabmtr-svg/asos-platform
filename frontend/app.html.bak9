      <!-- ════ WATCHLIST ════ -->
      <div id="watchlist" class="page">
        <!-- DISCOVERY ENGINE — screener query -> ranked gems with entry plan -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px">
          <div>
            <div style="font-size:14px;font-weight:700">Discovery Engine</div>
            <div style="font-size:11px;color:var(--t2)">Screener query &rarr; live analysis &rarr; computed entry ladder, target &amp; horizon</div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <label style="padding:7px 14px;border-radius:var(--r2);border:none;background:linear-gradient(135deg,#4080ff,#00b8e0);color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">
              📊 Upload Screener export <input type="file" accept=".xlsx,.xls,.csv" style="display:none" onchange="uploadScreenerExport(this)">
            </label>
            <label style="padding:7px 12px;border-radius:var(--r2);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">
              📤 Bulk deals CSV <input type="file" accept=".csv" style="display:none" onchange="uploadBulkDeals(this)">
            </label>
            <button onclick="loadActionList()" style="padding:7px 14px;border-radius:var(--r2);border:none;background:linear-gradient(135deg,#18d490,#0a9d68);color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">🎯 What to buy today</button>
            <button onclick="loadSmartMoney()" style="padding:7px 12px;border-radius:var(--r2);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">🏦 Smart money</button>
            <button onclick="loadLastDiscovery()" style="padding:7px 12px;border-radius:var(--r2);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">↻ Last run</button>
          </div>
        </div>

        <!-- Query builder -->
        <div class="card" style="margin-bottom:12px">
          <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-bottom:8px">
            <div style="flex:1;min-width:220px">
              <div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Preset strategy</div>
              <select id="dscPreset" onchange="onPresetChange()" style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;outline:none;font-family:'Space Grotesk',sans-serif">
                <option value="">Loading presets…</option>
              </select>
            </div>
            <div style="width:130px">
              <div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Analyse top</div>
              <input id="dscMax" type="number" value="12" min="3" max="30" style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none">
            </div>
            <button onclick="runDiscovery()" id="dscRunBtn" style="padding:10px 22px;border-radius:var(--r2);border:none;background:linear-gradient(135deg,#4080ff,#00b8e0);color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">🔍 Run discovery</button>
          </div>
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Screener query (editable — this IS the strategy)</div>
          <textarea id="dscQuery" rows="2" style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:11px;font-family:var(--mono);outline:none;resize:vertical" placeholder="Return on capital employed > 20 AND Debt to equity < 0.5"></textarea>
          <div id="dscPresetDesc" style="font-size:11px;color:var(--t3);margin-top:6px"></div>
          <div style="margin-top:10px;padding:8px 12px;background:var(--s2);border-left:2px solid var(--bl);border-radius:0 var(--r) var(--r) 0;font-size:11px;color:var(--t2);line-height:1.7">
            <strong style="color:var(--bl)">Recommended workflow:</strong> run your query on
            <a href="https://www.screener.in/screen/new/" target="_blank" style="color:var(--bl)">screener.in</a>
            &rarr; click <strong>Export to Excel</strong> &rarr; upload it with the blue button above.
            More reliable than live scraping, and you keep full control of the query.
          </div>
        </div>

        <div id="dscStatus" style="display:none;margin-bottom:12px;padding:10px 14px;border-radius:var(--r);font-size:12px"></div>
        <div id="dscResults"></div>
      </div>

      <!-- ════ TRADE BUILDER ════ -->
      <div id="tradebuilder" class="page">
        <!-- Live market strip -->
        <div class="grid4" style="margin-bottom:14px">
          <div class="card" style="text-align:center"><div style="font-size:10px;color:var(--t3)" class="mono">NIFTY spot</div><div style="font-size:18px;font-weight:700;color:var(--bl)" id="tbSpot">—</div></div>
          <div class="card" style="text-align:center"><div style="font-size:10px;color:var(--t3)" class="mono">VIX</div><div style="font-size:18px;font-weight:700;color:var(--gr)" id="tbVix">—</div></div>
          <div class="card" style="text-align:center"><div style="font-size:10px;color:var(--t3)" class="mono">IVR</div><div style="font-size:18px;font-weight:700" id="tbIvr">—</div></div>
          <div class="card" style="text-align:center"><div style="font-size:10px;color:var(--t3)" class="mono">A1 GATE</div><div style="font-size:18px;font-weight:700" id="tbGate">—</div></div>
        </div>

        <!-- AI trade builder chat -->
        <div class="card" style="margin-bottom:14px">
          <div style="font-size:13px;font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px">✨ Describe your trade — AI builds it live</div>
          <div style="font-size:11px;color:var(--t3);margin-bottom:10px">e.g. "iron condor nifty 16 delta" · "bull put spread short 23500 long 23300" · "short strangle banknifty 10 delta 2 lots"</div>
          <div style="display:flex;gap:8px">
            <input id="tbPrompt" type="text" placeholder="Describe the options trade you want…"
              onkeydown="if(event.key==='Enter')tbAIBuild()"
              style="flex:1;background:var(--s2);border:1px solid var(--b1);border-radius:8px;padding:11px 14px;color:var(--tx);font-size:13px;outline:none">
            <button onclick="tbAIBuild()" id="tbBuildBtn" style="padding:11px 22px;border-radius:8px;border:none;background:linear-gradient(135deg,#a064ff,#4080ff);color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">Build →</button>
            <button onclick="tbBuildRecommended()" id="tbRecBtn" style="padding:11px 18px;border-radius:8px;border:1px solid var(--gr);background:rgba(24,212,144,.08);color:var(--gr);font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif" title="Build what the Strategy Matrix recommends for current market">🎯 Recommended</button>
          </div>
          <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">
            <span onclick="tbQuick('iron condor nifty 16 delta')" style="cursor:pointer;font-size:10px;padding:4px 10px;border-radius:99px;background:var(--s2);color:var(--t2);border:1px solid var(--b2)">Iron Condor 16Δ</span>
            <span onclick="tbQuick('bull put spread nifty 20 delta')" style="cursor:pointer;font-size:10px;padding:4px 10px;border-radius:99px;background:var(--s2);color:var(--t2);border:1px solid var(--b2)">Bull Put Spread</span>
            <span onclick="tbQuick('bear call spread nifty 20 delta')" style="cursor:pointer;font-size:10px;padding:4px 10px;border-radius:99px;background:var(--s2);color:var(--t2);border:1px solid var(--b2)">Bear Call Spread</span>
            <span onclick="tbQuick('iron butterfly nifty')" style="cursor:pointer;font-size:10px;padding:4px 10px;border-radius:99px;background:var(--s2);color:var(--t2);border:1px solid var(--b2)">Iron Butterfly</span>
            <span onclick="tbQuick('short strangle nifty 10 delta')" style="cursor:pointer;font-size:10px;padding:4px 10px;border-radius:99px;background:var(--s2);color:var(--t2);border:1px solid var(--b2)">Short Strangle</span>
          </div>
        </div>

        <div id="tbStatus" style="display:none;margin-bottom:12px;padding:10px 14px;border-radius:var(--r);font-size:12px"></div>
        <div id="tbResult"></div>
      </div>

      <div id="monitor" class="page">
