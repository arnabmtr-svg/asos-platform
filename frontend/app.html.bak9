            <div style="font-size:10px;color:var(--t3)" class="mono">Bias</div>
            <div style="font-size:18px;font-weight:700;color:var(--pu)" id="sBias">Neutral</div><input type="range"
              min="-2" max="2" step="1" value="0"
              oninput="const l=['Strong Bear','Mild Bear','Neutral','Mild Bull','Strong Bull'];document.getElementById('sBias').textContent=l[parseInt(this.value)+2];scoreS()">
          </div>
        </div>
        <div id="stratCards" style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px"></div>
