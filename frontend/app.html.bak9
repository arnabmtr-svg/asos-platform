        <div class="code-inline"># Quick start (local dev)
          git clone https://github.com/yourusername/asos-platform
          cd asos-platform

          # Backend
          pip install fastapi uvicorn kiteconnect yfinance pandas redis
          uvicorn main:app --reload --port 8000

          # Frontend
          cd frontend && npm install
          VITE_API_URL=http://localhost:8000 npm run dev

          # Deploy to production
          vercel --prod # frontend
          railway up # backend + database</div>
