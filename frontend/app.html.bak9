                onmouseover="this.style.borderColor='var(--bl)'" onmouseout="this.style.borderColor='var(--b1)'"
                onclick="quickS('Check my cash ledger and current holdings. What is the optimal deployment plan for any idle cash over the next 90 days?')">💰
                Optimise ₹5.78L remaining proceeds</button>
              <button
