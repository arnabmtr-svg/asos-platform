        </div>
        <div class="grid4" style="margin-bottom:14px">
          <div class="card" style="text-align:center;border-left:3px solid var(--gr)">
            <div style="font-size:10px;color:var(--t3)" class="mono">MTD P&L</div>
            <div style="font-size:16px;font-weight:700;color:var(--gr)" id="monMtd">—</div>
          </div>
          <div class="card" style="text-align:center">
            <div style="font-size:10px;color:var(--t3)" class="mono">Open positions</div>
