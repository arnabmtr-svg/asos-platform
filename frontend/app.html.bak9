            <div class="mb-v" style="color:var(--re)">—</div>
          </div>
          <div class="metric-box">
            <div class="mb-l">Completion</div>
            <div class="mb-v" style="color:var(--gr)">—</div>
          </div>
        </div>
        <div id="gapTableWrap"
          style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:14px;margin-bottom:12px">
          <div style="text-align:center;padding:24px;color:var(--t3);font-size:12px">Loading gap analysis…</div>
        </div>
        <div class="sh">Stocks to sell (not in Core 22)</div>
        <div id="sellListWrap"
          style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:14px">
          <div style="text-align:center;padding:16px;color:var(--t3);font-size:12px">Loading…</div>
        </div>
      </div>

      <!-- ════ OPTIONS CHAIN ════ -->
      <div id="optionschain" class="page">
        <!-- Controls bar -->
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">
          <div style="display:flex;gap:4px">
            <button id="ocNiftyBtn" onclick="setOCSymbol('NIFTY',this)"
              style="padding:6px 14px;border-radius:var(--r);border:1px solid var(--bl);background:var(--bd);color:var(--bl);font-size:12px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">NIFTY</button>
            <button id="ocBNBtn" onclick="setOCSymbol('BANKNIFTY',this)"
              style="padding:6px 14px;border-radius:var(--r);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">BANKNIFTY</button>
          </div>
          <select id="ocExpiry" onchange="loadOC()"
            style="background:var(--s2);border:1px solid var(--b2);border-radius:var(--r);padding:6px 10px;color:var(--tx);font-size:12px;font-family:'IBM Plex Mono',monospace;outline:none">
            <option>Loading…</option>
          </select>
          <button onclick="loadOC()"
            style="padding:6px 12px;border-radius:var(--r);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;cursor:pointer;font-family:'Space Grotesk',sans-serif">↻
            Refresh</button>
          <div id="ocSource" style="font-size:10px;color:var(--t3);font-family:var(--mono)">—</div>
          <div style="margin-left:auto;display:flex;gap:8px;flex-wrap:wrap">
            <div id="ocSpot"
              style="background:var(--bd);border:1px solid rgba(64,128,255,.3);border-radius:var(--r);padding:5px 12px;font-size:13px;font-weight:700;color:var(--bl)">
              NIFTY —</div>
            <div id="ocVix"
              style="background:var(--gd);border:1px solid rgba(24,212,144,.3);border-radius:var(--r);padding:5px 12px;font-size:12px;font-weight:600;color:var(--gr)">
              VIX —</div>
            <div id="ocIvp"
              style="background:var(--ad);border:1px solid rgba(240,160,0,.3);border-radius:var(--r);padding:5px 12px;font-size:12px;font-weight:600;color:var(--am)">
              IVP —</div>
            <div id="ocDte"
              style="background:var(--s2);border:1px solid var(--b2);border-radius:var(--r);padding:5px 12px;font-size:12px;font-weight:600;color:var(--t2)">
              DTE —</div>
          </div>
        </div>

        <!-- Market metrics row -->
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px">
          <div class="card" style="margin-bottom:0;text-align:center">
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">PCR</div>
            <div style="font-size:18px;font-weight:700" id="ocPcr">—</div>
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono)" id="ocPcrNote">—</div>
          </div>
          <div class="card" style="margin-bottom:0;text-align:center">
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">MAX PAIN</div>
            <div style="font-size:18px;font-weight:700" id="ocMaxPain">—</div>
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">Strike</div>
          </div>
          <div class="card" style="margin-bottom:0;text-align:center">
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">DEPLOY SIGNAL</div>
            <div style="font-size:18px;font-weight:700" id="ocSignal">—</div>
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">IC conditions</div>
          </div>
          <div class="card" style="margin-bottom:0;text-align:center">
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">ATM STRIKE</div>
            <div style="font-size:18px;font-weight:700;color:var(--bl)" id="ocAtm">—</div>
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">Nearest to spot</div>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 300px;gap:12px">
          <!-- Chain table -->
          <div style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);overflow:hidden">
            <div
              style="display:flex;justify-content:space-between;padding:8px 12px;border-bottom:1px solid var(--b1);font-size:10px;font-weight:700;color:var(--t3);font-family:var(--mono);text-transform:uppercase">
              <span style="color:var(--re)">CALLS ←</span>
              <span>STRIKE</span>
              <span style="color:var(--bl)">→ PUTS</span>
            </div>
            <div
              style="font-size:10px;color:var(--t3);font-family:var(--mono);display:grid;grid-template-columns:1fr 1fr 1fr 80px 1fr 1fr 1fr;gap:0;padding:4px 8px;background:var(--s2)">
              <span>CE LTP</span><span>CE Δ</span><span>CE IV</span><span
                style="text-align:center;color:var(--tx)">STRIKE</span><span style="text-align:right">PE IV</span><span
                style="text-align:right">PE Δ</span><span style="text-align:right">PE LTP</span>
            </div>
            <div id="ocChainBody" style="max-height:420px;overflow-y:auto">
              <div style="text-align:center;padding:24px;color:var(--t3)">Loading chain…</div>
            </div>
          </div>
          <!-- IC Builder panel -->
          <div>
            <div
              style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:13px;margin-bottom:10px">
              <div style="font-size:12px;font-weight:700;margin-bottom:10px;color:var(--am)">⚡ IC Builder</div>
              <div
                style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:4px">
                Short Call (16Δ)</div>
              <div id="icShortCall"
                style="font-size:15px;font-weight:700;color:var(--re);margin-bottom:8px;font-family:var(--mono)">—</div>
              <div
                style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:4px">
                Short Put (16Δ)</div>
              <div id="icShortPut"
                style="font-size:15px;font-weight:700;color:var(--bl);margin-bottom:8px;font-family:var(--mono)">—</div>
              <div style="height:1px;background:var(--b1);margin:8px 0"></div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px">
                <div style="background:var(--s2);border-radius:6px;padding:8px 10px">
                  <div
                    style="font-size:9px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:2px">
                    Net credit</div>
                  <div style="font-size:14px;font-weight:700;color:var(--gr)" id="icCredit">—</div>
                </div>
                <div style="background:var(--s2);border-radius:6px;padding:8px 10px">
                  <div
                    style="font-size:9px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:2px">
                    Target 50%</div>
                  <div style="font-size:14px;font-weight:700;color:var(--gr)" id="icTarget">—</div>
                </div>
                <div style="background:var(--s2);border-radius:6px;padding:8px 10px">
                  <div
                    style="font-size:9px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:2px">
                    Stop 2×</div>
                  <div style="font-size:14px;font-weight:700;color:var(--re)" id="icStop">—</div>
                </div>
                <div style="background:var(--s2);border-radius:6px;padding:8px 10px">
                  <div
                    style="font-size:9px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:2px">
                    DTE</div>
                  <div style="font-size:14px;font-weight:700" id="icDte">—</div>
                </div>
              </div>
              <div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:6px">Entry checklist
              </div>
              <div id="icChecklist" style="font-size:11px;line-height:1.8"></div>
            </div>
            <!-- Payoff chart -->
            <div style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:13px">
              <div style="font-size:12px;font-weight:700;margin-bottom:8px">Payoff diagram</div>
              <div style="position:relative;height:160px"><canvas id="icPayoffChart" role="img"
                  aria-label="IC payoff diagram"></canvas></div>
            </div>
          </div>
        </div>
      </div>


      <!-- ════ BUY/SELL TIMING ENGINE ════ -->
      <div id="timing" class="page">
        <div
          style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px">
          <div>
            <div style="font-size:14px;font-weight:700">Buy/Sell Radar — Market Timing Engine</div>
            <div style="font-size:11px;color:var(--t2)">RSI · 52-week H/L · DMA · VIX → tells you when to buy, trim, or
              pause for each Core 22 stock</div>
          </div>
          <button onclick="loadTimingEngine(true)"
            style="padding:7px 14px;border-radius:var(--r2);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">↻
            Refresh signals</button>
        </div>

        <!-- Market context bar -->
        <div id="timingContextBar"
          style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:14px;margin-bottom:14px">
          <div style="text-align:center;padding:10px;color:var(--t3);font-size:12px">Loading market conditions…</div>
        </div>

        <!-- SIP guidance -->
        <div id="timingSipBar"
          style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:12px 16px;margin-bottom:14px">
          <div style="text-align:center;color:var(--t3);font-size:12px">Loading SIP guidance…</div>
        </div>

        <!-- Trim/Add summary -->
        <div id="timingActionBar"
          style="display:none;margin-bottom:14px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px">
          <div class="metric-box" id="ta-trim">
            <div class="mb-l">Trim signals</div>
            <div class="mb-v" style="color:var(--re)">—</div>
          </div>
          <div class="metric-box" id="ta-add">
            <div class="mb-l">Add signals</div>
            <div class="mb-v" style="color:var(--gr)">—</div>
          </div>
          <div class="metric-box" id="ta-proceeds">
            <div class="mb-l">Trim proceeds est.</div>
            <div class="mb-v" style="color:var(--am)">—</div>
          </div>
          <div class="metric-box" id="ta-nrsi">
            <div class="mb-l">Nifty RSI</div>
            <div class="mb-v">—</div>
          </div>
        </div>

        <!-- How it works -->
        <div
          style="background:var(--s2);border-left:2px solid var(--bl);border-radius:0 var(--r) var(--r) 0;padding:10px 14px;margin-bottom:14px;font-size:11px;color:var(--t2);line-height:1.8">
          <strong style="color:var(--bl)">How the Radar works:</strong><br>
          <strong style="color:var(--re)">TRIM</strong> = Stock >15% above target weight AND RSI > 65 — Sell 10% of
          position near the high<br>
          <strong style="color:var(--gr)">STRONG ADD</strong> = Stock underweight AND RSI &lt; 35 AND within 20% of
          52-week low — Deploy 2× SIP<br>
          <strong style="color:var(--bl)">ADD</strong> = Underweight AND RSI &lt; 52 — Deploy regular SIP here<br>
          <strong style="color:var(--am)">AVOID ADDING</strong> = Within 3% of 52-week high AND RSI > 68 — Wait for
          8–12% pullback<br>
          <strong>VIX override:</strong> VIX > 20 → pause SIP for all stocks except STRONG ADD signals
        </div>

        <!-- ETF signals (simplified) -->
        <div class="sh" style="margin-top:0">ETF & Index positions</div>
        <div id="timingEtfGrid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px">
          <div style="text-align:center;padding:16px;color:var(--t3);font-size:12px;grid-column:1/-1">Loading…</div>
        </div>

        <!-- Equity signals -->
        <div class="sh">Equity positions — RSI + 52-week analysis</div>
        <div id="timingSignalsGrid">
          <div style="text-align:center;padding:24px;color:var(--t3);font-size:12px">
            <div
              style="width:16px;height:16px;border:2px solid var(--b2);border-top-color:var(--bl);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 8px">
            </div>
            Fetching RSI + 52-week data for all Core 22 positions… (~15 seconds)
          </div>
        </div>
      </div>


      <!-- ════ SIP OPTIMIZER ════ -->
      <div id="sipopt" class="page">
        <div
          style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px">
          <div>
            <div style="font-size:14px;font-weight:700">SIP Optimizer — Monthly ₹1L Allocation</div>
            <div style="font-size:11px;color:var(--t2)" id="sipMonthLabel">Calculating this month's split…</div>
          </div>
          <div style="display:flex;gap:8px">
            <button onclick="loadSipOptimizer()"
              style="padding:7px 14px;border-radius:var(--r2);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">↻
              Recalculate</button>
            <button onclick="sendSipToTelegram()"
              style="padding:7px 14px;border-radius:var(--r2);border:none;background:linear-gradient(135deg,#0F6E56,#185FA5);color:#fff;font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">📱
              Send to Telegram</button>
          </div>
        </div>
        <!-- SIP mode banner -->
        <div id="sipModeBanner"
          style="border-radius:var(--r2);padding:10px 16px;margin-bottom:14px;font-size:12px;line-height:1.6;border-left:3px solid var(--gr)">
          Loading SIP mode…</div>
        <!-- Allocation grid -->
        <div
          style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:14px;margin-bottom:12px">
          <div id="sipAllocationTable">
            <div style="text-align:center;padding:24px;color:var(--t3);font-size:12px">Loading… (fetching RSI for all
              Core 22 stocks, ~15 seconds)</div>
          </div>
        </div>
        <!-- Transaction log -->
        <div class="sh">Transaction log</div>
        <div style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:14px">
          <div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">
            <label
              style="padding:6px 12px;border-radius:var(--r);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;cursor:pointer">
              📤 Upload trade history CSV <input type="file" accept=".csv" style="display:none"
                onchange="uploadTxns(this)">
            </label>
            <button onclick="showAddTxn()"
              style="padding:6px 12px;border-radius:var(--r);border:none;background:var(--bl);color:#fff;font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">+
              Add trade</button>
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono);align-self:center">Format:
              Date,Ticker,Type,Qty,Price</div>
          </div>
          <div id="addTxnForm"
            style="display:none;background:var(--s2);border-radius:var(--r);padding:10px;margin-bottom:10px">
            <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:8px">
              <div>
                <div style="font-size:9px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">DATE</div><input
                  id="tx-date" type="date"
                  style="width:100%;background:var(--s1);border:1px solid var(--b1);border-radius:5px;padding:7px 9px;color:var(--tx);font-size:12px;outline:none">
              </div>
              <div>
                <div style="font-size:9px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">TICKER</div><input
                  id="tx-ticker" type="text" placeholder="CGPOWER"
                  style="width:100%;background:var(--s1);border:1px solid var(--b1);border-radius:5px;padding:7px 9px;color:var(--tx);font-size:12px;outline:none">
              </div>
              <div>
                <div style="font-size:9px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">TYPE</div><select
                  id="tx-type"
                  style="width:100%;background:var(--s1);border:1px solid var(--b1);border-radius:5px;padding:7px 9px;color:var(--tx);font-size:12px;outline:none">
                  <option>BUY</option>
                  <option>SELL</option>
                </select>
              </div>
              <div>
                <div style="font-size:9px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">QTY</div><input
                  id="tx-qty" type="number" placeholder="50"
                  style="width:100%;background:var(--s1);border:1px solid var(--b1);border-radius:5px;padding:7px 9px;color:var(--tx);font-size:12px;outline:none">
              </div>
              <div>
                <div style="font-size:9px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">PRICE (₹)</div>
                <input id="tx-price" type="number" placeholder="620.50"
                  style="width:100%;background:var(--s1);border:1px solid var(--b1);border-radius:5px;padding:7px 9px;color:var(--tx);font-size:12px;outline:none">
              </div>
            </div>
            <div style="display:flex;gap:8px">
              <button onclick="saveTxn()"
                style="padding:7px 16px;border-radius:var(--r);border:none;background:var(--gr);color:#000;font-size:12px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">Save</button>
              <button onclick="document.getElementById('addTxnForm').style.display='none'"
                style="padding:7px 16px;border-radius:var(--r);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;cursor:pointer;font-family:'Space Grotesk',sans-serif">Cancel</button>
            </div>
          </div>
          <div id="txnTableWrap">
            <div style="color:var(--t3);font-size:12px;padding:10px">No transactions yet. Upload CSV or add manually.
            </div>
          </div>
        </div>
      </div>

      <!-- ════ XIRR & RETURNS ════ -->
      <div id="xirr" class="page">
        <div style="font-size:14px;font-weight:700;margin-bottom:4px">XIRR & Returns</div>
        <div style="font-size:11px;color:var(--t2);margin-bottom:14px">Your actual annualised return vs Nifty 50
          benchmark. Requires transaction history.</div>
        <!-- Summary metrics -->
        <div class="grid4" style="margin-bottom:14px" id="xirrMetrics">
          <div class="metric-box">
            <div class="mb-l">Your XIRR</div>
            <div class="mb-v" style="color:var(--bl)">—</div>
            <div class="mb-d">Annualised</div>
          </div>
          <div class="metric-box">
            <div class="mb-l">Nifty 50 XIRR</div>
            <div class="mb-v">—</div>
            <div class="mb-d">Same period</div>
          </div>
          <div class="metric-box">
            <div class="mb-l">Alpha</div>
            <div class="mb-v" style="color:var(--gr)">—</div>
            <div class="mb-d">You vs index</div>
          </div>
          <div class="metric-box">
            <div class="mb-l">Absolute return</div>
            <div class="mb-v">—</div>
            <div class="mb-d">Total gain</div>
          </div>
        </div>
        <div id="xirrChart"
          style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:14px;margin-bottom:12px;min-height:200px">
          <div style="text-align:center;padding:24px;color:var(--t3);font-size:12px">Upload transaction history (in SIP
            Optimizer page) to compute XIRR</div>
        </div>
        <div id="xirrDetail"
          style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:14px"></div>
      </div>

      <!-- ════ TAX HARVESTING ════ -->
      <div id="taxharvest" class="page">
        <div
          style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px">
          <div>
            <div style="font-size:14px;font-weight:700">Tax Harvesting — FY 2026–27</div>
            <div style="font-size:11px;color:var(--t2)">LTCG / LTCL analysis · harvest before March 31 · minimise tax
            </div>
          </div>
          <button onclick="loadTaxHarvest()"
            style="padding:7px 14px;border-radius:var(--r2);border:1px solid var(--b2);background:var(--s2);color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">↻
            Refresh</button>
        </div>
        <!-- Tax summary -->
        <div class="grid4" style="margin-bottom:14px" id="taxMetrics">
          <div class="metric-box">
            <div class="mb-l">Total LTCG</div>
            <div class="mb-v" style="color:var(--re)">—</div>
            <div class="mb-d">Unrealised gains &gt;1yr</div>
          </div>
          <div class="metric-box">
            <div class="mb-l">Total LTCL</div>
            <div class="mb-v" style="color:var(--gr)">—</div>
            <div class="mb-d">Harvest to offset</div>
          </div>
          <div class="metric-box">
            <div class="mb-l">Tax payable</div>
            <div class="mb-v" style="color:var(--re)">—</div>
            <div class="mb-d">Before harvesting</div>
          </div>
          <div class="metric-box">
            <div class="mb-l">Tax saved (if harvest)</div>
            <div class="mb-v" style="color:var(--gr)">—</div>
            <div class="mb-d">By booking LTCL</div>
          </div>
        </div>
        <div id="taxPlanWrap"
          style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:14px;margin-bottom:12px">
          <div style="text-align:center;padding:24px;color:var(--t3);font-size:12px">Requires transaction history to
            compute holding periods</div>
        </div>
        <div class="sh">Harvest plan — LTCL positions to book before March 31</div>
        <div id="taxHarvestPlan"
          style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:14px"></div>
      </div>
    </div><!-- end content -->
  </div><!-- end main -->

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
  <script>
    // ── NAVIGATION ──────────────────────────────────────────────────────────────
    const TITLES = { 'dashboard': 'Dashboard', 'market': 'Market Intelligence', 'transition': 'Portfolio Transition', 'core22': 'Core 22', 'watchlist': 'Watchlist Scout', 'tradebuilder': 'Trade Builder', 'monitor': 'Trading Monitor', 'strategies': 'Strategy Selector', 'aiscout': 'AI Scout', 'checklist': 'Execution Checklist', 'deploy': 'Deployment Guide', 'settings': 'Settings', 'holdings': 'My Holdings', 'core22gap': 'Core 22 Gap Analysis', 'timing': 'Buy/Sell Radar — Market Timing Engine', 'optionschain': 'Options Chain', 'sipopt': 'SIP Optimizer', 'xirr': 'XIRR & Returns', 'taxharvest': 'Tax Harvesting' };
    function go(id, el) {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('on'));
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('on'));
      document.getElementById(id)?.classList.add('on');
      el.classList.add('on');
      document.getElementById('pageTitle').textContent = TITLES[id] || id;
      if (id === 'dashboard') { buildDashProj(); buildDash(); }
      if (id === 'monitor') buildPnlChart();
      if (id === 'strategies') scoreS();
      if (id === 'watchlist') { initDiscovery(); loadLastDiscovery(); }
      if (id === 'core22') buildCore22();
      if (id === 'market') buildMkt();
    }


    // ── THINKING DASHBOARD (live engine) ────────────────────────────────────────
    async function buildDash() {
      const tok = localStorage.getItem('asos_token');
      const H = { 'Authorization': `Bearer ${tok}` };
      const fmt = n => n>=1e7 ? '₹'+(n/1e7).toFixed(2)+'Cr' : n>=1e5 ? '₹'+(n/1e5).toFixed(2)+'L' : n>=1e3 ? '₹'+(n/1e3).toFixed(1)+'K' : '₹'+Math.round(n||0);
      // 1. Regime banner
      try {
        const d = await (await fetch('http://localhost:8000/income/regime?index=NIFTY', {headers:H})).json();
        const RC = {'VOL_EXPANSION':'var(--re)','TREND_UP':'var(--gr)','TREND_DOWN':'var(--re)','VOL_COMPRESSION':'var(--am)','RANGE':'var(--bl)'};
        const c = RC[d.regime] || 'var(--t2)';
        document.getElementById('rbBadge').textContent = d.regime + ' · ' + Math.round(d.confidence) + '%';
        document.getElementById('rbBadge').style.color = c;
        document.getElementById('rbWhy').textContent = d.why || '';
        document.getElementById('rbIntent').textContent = '→ ' + (d.intent || '');
      } catch(e){ document.getElementById('rbBadge').textContent = 'Reconnect Zerodha'; }
      // Entry gate
      try {
        const g = await (await fetch('http://localhost:8000/income/entry-gate?arm=A1&index=NIFTY', {headers:H})).json();
        const el = document.getElementById('rbGate');
        el.textContent = 'A1 gate: ' + (g.allowed ? 'CLEAR' : 'BLOCKED');
        el.style.background = g.allowed ? 'rgba(24,212,144,.1)' : 'rgba(240,48,80,.1)';
        el.style.color = g.allowed ? 'var(--gr)' : 'var(--re)';
        el.title = (g.checks||[]).join(' · ');
      } catch(e){}
      // 2. Health -> repurposed metric box
      try {
        const h = await (await fetch('http://localhost:8000/engine/health', {headers:H})).json();
        document.getElementById('dmHealthVal').textContent = Math.round(h.health_score);
        document.getElementById('dmHealthLbl').textContent = h.health_grade;
        const cor = document.querySelector('#dm-corpus .mb-v');
        if (cor && h.corpus) { cor.textContent = fmt(h.corpus); cor.style.color='var(--bl)';
          const cd = document.querySelector('#dm-corpus .mb-d'); if(cd){cd.textContent='effective (live)';cd.style.color='var(--t3)';} }
      } catch(e){}
      // 3. Options income MTD
      try {
        const p = await (await fetch('http://localhost:8000/income/positions', {headers:H})).json();
        document.getElementById('dmOptMtd').textContent = fmt(p.mtd_income||0);
      } catch(e){}
      // 4. Decisions
      try {
        const d = await (await fetch('http://localhost:8000/engine/decisions', {headers:H})).json();
        const SIGCOL = {'STRONG ADD':['rgba(24,212,144,.12)','var(--gr)'],'ADD':['rgba(64,128,255,.12)','var(--bl)'],'STRONG TRIM':['rgba(240,48,80,.12)','var(--re)'],'TRIM':['rgba(240,160,0,.12)','var(--am)'],'REVIEW QUALITY':['rgba(160,100,255,.12)','var(--pu)'],'AVOID ADDING':['rgba(240,160,0,.12)','var(--am)'],'HOLD':['var(--s3)','var(--t2)']};
        const el = document.getElementById('dashDecisions');
        if (!d.decisions || !d.decisions.length) el.innerHTML = '<div style="color:var(--gr);font-size:12px;padding:10px">✓ No urgent decisions — portfolio steady</div>';
        else el.innerHTML = d.decisions.map(x => {
          const [bg,fg] = SIGCOL[x.signal] || ['var(--s3)','var(--t2)'];
          const q = x.quality_score!=null ? `<span style="font-size:10px;font-family:var(--mono);padding:2px 6px;border-radius:4px;background:var(--s3);color:${x.quality_score>=68?'var(--gr)':x.quality_score<42?'var(--re)':'var(--am)'}">Q${x.quality_score}</span>` : '';
          return `<div style="display:flex;align-items:flex-start;gap:10px;padding:9px 10px;border-bottom:1px solid var(--b1)">
            <span style="font-size:10px;font-weight:700;padding:3px 7px;border-radius:5px;background:${bg};color:${fg};white-space:nowrap">${x.signal}</span>
            <div style="flex:1;min-width:0"><div style="font-weight:700;font-size:13px">${x.ticker} ${q}</div>
            <div style="font-size:11px;color:var(--t3);margin-top:1px">${x.action}</div>
            ${x.note?`<div style="font-size:10px;color:var(--am);margin-top:2px">${x.note}</div>`:''}</div>
            <span style="font-size:10px;font-family:var(--mono);color:var(--t4)">RSI ${x.rsi}</span></div>`;
        }).join('');
      } catch(e){ document.getElementById('dashDecisions').innerHTML='<div style="color:var(--t3);font-size:12px;padding:10px">Sync fundamentals to see decisions</div>'; }
      // 5. Replacement watch
      try {
        const d = await (await fetch('http://localhost:8000/engine/decisions', {headers:H})).json();
        const el = document.getElementById('dashReplWatch');
        if (!d.replacement_watch || !d.replacement_watch.length) el.innerHTML='<div style="color:var(--gr);font-size:12px;padding:10px">✓ No holdings below quality floor</div>';
        else el.innerHTML = d.replacement_watch.map(r =>
          `<div style="display:flex;align-items:center;gap:10px;padding:8px 10px;border-bottom:1px solid var(--b1)">
            <span style="font-weight:700;font-size:13px;width:90px">${r.ticker}</span>
            <span style="font-family:var(--mono);font-weight:700;font-size:14px;color:var(--re);width:32px">${r.quality_score}</span>
            <span style="font-size:10px;color:var(--t3);flex:1">${(r.flags||[]).join(' · ')}</span></div>`).join('');
      } catch(e){}
    }


    // ── DISCOVERY ENGINE UI ─────────────────────────────────────────────────────
    let _dscPresets = {};
    async function initDiscovery() {
      const tok = localStorage.getItem('asos_token');
      try {
        const d = await (await fetch('http://localhost:8000/discovery/presets', {headers:{'Authorization':`Bearer ${tok}`}})).json();
        _dscPresets = d.presets || {};
        const sel = document.getElementById('dscPreset');
        sel.innerHTML = Object.entries(_dscPresets).map(([k,v]) => `<option value="${k}">${v.name}</option>`).join('')
          + (d.saved||[]).map(s=>`<option value="saved:${s.id}" data-q="${(s.query||'').replace(/"/g,'&quot;')}">★ ${s.name}</option>`).join('')
          + '<option value="custom">✎ Custom query…</option>';
        onPresetChange();
      } catch(e) {
        document.getElementById('dscPreset').innerHTML = '<option>Backend not loaded — add discovery_engine.py</option>';
      }
    }
    function onPresetChange() {
      const k = document.getElementById('dscPreset').value;
      const p = _dscPresets[k];
      if (p) {
        document.getElementById('dscQuery').value = p.query;
        document.getElementById('dscPresetDesc').textContent = p.desc;
      } else if (k === 'custom') {
        document.getElementById('dscPresetDesc').textContent = 'Write any screener.in query. Example: Return on capital employed > 25 AND Sales growth 3Years > 20';
      }
    }
    function _dscMsg(t, type) {
      const el = document.getElementById('dscStatus'); if(!el) return;
      el.style.display='block'; el.textContent=t;
      const c = {ok:['rgba(24,212,144,.08)','var(--gr)'],err:['rgba(240,48,80,.08)','var(--re)'],info:['rgba(64,128,255,.08)','var(--bl)']}[type]||['var(--s2)','var(--t2)'];
      el.style.background=c[0]; el.style.color=c[1]; el.style.border='1px solid '+c[1].replace(')',',.25)').replace('var(--','rgba(');
      el.style.border='1px solid var(--b1)';
    }
    async function runDiscovery() {
      const tok = localStorage.getItem('asos_token');
      const btn = document.getElementById('dscRunBtn');
      const q = document.getElementById('dscQuery').value.trim();
      const preset = document.getElementById('dscPreset').value;
      if (!q) { _dscMsg('Enter a query first.', 'err'); return; }
      btn.disabled = true; btn.textContent = 'Running…';
      _dscMsg('Querying Screener, then analysing matches with live Kite data… this takes 30-60s.', 'info');
      document.getElementById('dscResults').innerHTML = '';
      try {
        const r = await fetch('http://localhost:8000/discovery/run', {
          method:'POST', headers:{'Authorization':`Bearer ${tok}`,'Content-Type':'application/json'},
          body: JSON.stringify({ query:q, preset:(preset && !preset.startsWith('saved')&&preset!=='custom')?preset:null,
                                 max_analyse: parseInt(document.getElementById('dscMax').value)||12 })
        });
        if (!r.ok) { const t = await r.text(); _dscMsg('Failed: '+t.slice(0,200), 'err'); return; }
        const d = await r.json();
        _dscMsg(`Screener matched ${d.matched} stocks · analysed top ${d.analysed}` + (d.screener_error?` · note: ${d.screener_error}`:''), 'ok');
        renderGems(d.gems);
      } catch(e) { _dscMsg('Error: '+e.message, 'err'); }
      finally { btn.disabled=false; btn.textContent='🔍 Run discovery'; }
    }
    async function loadLastDiscovery() {
      const tok = localStorage.getItem('asos_token');
      try {
        const d = await (await fetch('http://localhost:8000/discovery/results', {headers:{'Authorization':`Bearer ${tok}`}})).json();
        if (!d.gems || !d.gems.length) { _dscMsg('No previous run. Click Run discovery.', 'info'); return; }
        _dscMsg(`Last run ${d.run_at} · ${d.preset} · matched ${d.matched}`, 'ok');
        renderGems(d.gems);
      } catch(e){ _dscMsg('Could not load last run.', 'err'); }
    }
    function renderGems(gems) {
      const el = document.getElementById('dscResults');
      if (!gems || !gems.length) { el.innerHTML = '<div class="card" style="color:var(--t3);font-size:12px">No candidates returned.</div>'; return; }
      const GC = {'STRONG BUY':'var(--gr)','BUY':'var(--bl)','WATCH':'var(--am)','PASS':'var(--t3)'};
      const SC = {'ACCUMULATE NOW':'var(--gr)','ENTER ON BREAKOUT':'var(--bl)','ENTER':'var(--bl)','WAIT':'var(--am)'};
      el.innerHTML = gems.map(g => {
        const p = g.plan || {}; const t = g.technicals || {}; const f = g.fundamentals || {};
        const gc = GC[g.grade] || 'var(--t3)'; const sc = SC[p.stance] || 'var(--t3)';
        const ladder = (p.ladder||[]).map(l =>
          `<div style="flex:1;background:var(--s2);border-radius:5px;padding:6px 8px;text-align:center">
             <div style="font-size:9px;color:var(--t3);font-family:var(--mono)">${l.level} · ${l.alloc_pct}%</div>
             <div style="font-size:13px;font-weight:700;color:var(--tx)">₹${l.price}</div>
             <div style="font-size:9px;color:var(--t3)">${l.note}</div></div>`).join('');
        const exits = (p.exit_rules||[]).map(x =>
          `<div style="display:flex;gap:8px;padding:5px 0;border-bottom:1px solid var(--b1)">
             <span style="font-size:9px;font-family:var(--mono);color:var(--re);width:120px;flex-shrink:0">${x.type}</span>
             <span style="font-size:10px;color:var(--t2);flex:1">${x.rule}</span></div>`).join('');
        return `<div class="card" style="margin-bottom:10px;border-left:3px solid ${gc}">
          <div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:10px;flex-wrap:wrap">
            <div style="flex:1;min-width:180px">
              <div style="display:flex;align-items:center;gap:8px">
                <span style="font-size:16px;font-weight:800">${g.ticker}</span>${g.company_name&&g.company_name!==g.ticker?`<span style="font-size:10px;color:var(--t3)">${g.company_name}</span>`:''}
                <span style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;background:${gc}22;color:${gc};font-family:var(--mono)">${g.grade}</span>
                <span style="font-size:13px;font-weight:700;color:${gc};font-family:var(--mono)">${g.composite}</span>
              </div>
              <div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-top:3px">
                Q${g.components.quality} · Val${g.components.valuation} · Mom${g.components.momentum} · SM${g.components.smart_money}
              </div>
            </div>
            <div style="text-align:right">
              <div style="font-size:15px;font-weight:700">₹${t.price||'—'}</div>
              <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">RSI ${t.rsi||'—'} · ${t.pct_from_low!=null?'+'+t.pct_from_low+'% off low':''}</div>
            </div>
          </div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">
            ${f.roce!=null?`<span class="bx bx-s">ROCE ${f.roce}%</span>`:''}
            ${f.pe!=null?`<span class="bx bx-s">PE ${f.pe}</span>`:''}
            ${f.de!=null?`<span class="bx bx-s">D/E ${f.de}</span>`:''}
            ${f.profit_growth_3y!=null?`<span class="bx bx-s">PAT 3y ${f.profit_growth_3y}%</span>`:''}
            ${f.promoter_pct!=null?`<span class="bx bx-s">Prom ${f.promoter_pct}%</span>`:''}
            ${g.smart_money&&g.smart_money.found?`<span class="bx bx-g">🏦 Bulk buy ${g.smart_money.buy_count}</span>`:''}
          </div>
          ${(g.quality_flags||[]).length?`<div style="font-size:10px;color:var(--am);margin-bottom:8px">⚠ ${g.quality_flags.join(' · ')}</div>`:''}
          <div style="background:${sc}12;border:1px solid ${sc}44;border-radius:6px;padding:8px 12px;margin-bottom:10px">
            <div style="font-size:12px;font-weight:700;color:${sc}">${p.stance||'—'}</div>
            <div style="font-size:11px;color:var(--t2);margin-top:2px">${p.why||''}</div>
          </div>
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:5px">Entry ladder — 25% each tranche</div>
          <div style="display:flex;gap:6px;margin-bottom:10px">${ladder}</div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:10px">
            <div style="background:var(--s2);border-radius:5px;padding:7px 9px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">AVG COST</div><div style="font-size:13px;font-weight:700">₹${p.avg_cost_if_full||'—'}</div></div>
            <div style="background:var(--s2);border-radius:5px;padding:7px 9px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">TARGET ${p.horizon_years||''}Y</div><div style="font-size:13px;font-weight:700;color:var(--gr)">₹${p.target_price||'—'}</div></div>
            <div style="background:var(--s2);border-radius:5px;padding:7px 9px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">EXP CAGR</div><div style="font-size:13px;font-weight:700;color:var(--gr)">${p.expected_cagr||'—'}%</div></div>
            <div style="background:var(--s2);border-radius:5px;padding:7px 9px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">STOP</div><div style="font-size:13px;font-weight:700;color:var(--re)">₹${p.stop_loss||'—'}</div></div>
          </div>
          <details style="margin-top:4px"><summary style="font-size:10px;color:var(--t3);font-family:var(--mono);cursor:pointer;text-transform:uppercase">Exit rules (${(p.exit_rules||[]).length})</summary>
            <div style="margin-top:6px">${exits}</div></details>
        </div>`;
      }).join('');
    }


    // ── ACTION LIST — what to buy / substitute today ────────────────────────────
    async function loadActionList() {
      const H={'Authorization':'Bearer '+localStorage.getItem('asos_token')};
      _dscMsg('Building your buy / substitute decision from discovery + Core 22…','info');
      document.getElementById('dscResults').innerHTML='';
      try {
        const d = await (await fetch('http://localhost:8000/discovery/action-list',{headers:H})).json();
        if (d.message) { _dscMsg(d.message,'info'); return; }
        _dscMsg(`${d.buy_now.length} to buy now · ${d.substitute.length} substitution${d.substitute.length!==1?'s':''} proposed`,'ok');
        renderActionList(d);
      } catch(e){ _dscMsg('Action list failed: '+e.message,'err'); }
    }
    function renderActionList(d) {
      const el=document.getElementById('dscResults'); let h='';
      // SUBSTITUTIONS first (highest-value decisions)
      if (d.substitute && d.substitute.length) {
        h += `<div style="font-size:12px;font-weight:700;color:var(--am);margin:4px 0 8px">⇄ SUBSTITUTION PROPOSALS — you approve each</div>`;
        h += d.substitute.map(s=>{
          const p=s.buy_plan||{};
          return `<div class="card" style="margin-bottom:10px;border-left:3px solid var(--am)">
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px">
              <div style="flex:1"><span style="font-size:15px;font-weight:800;color:var(--gr)">BUY ${s.buy}</span>
                <span style="font-size:12px;font-weight:700;color:var(--gr);font-family:var(--mono);margin-left:6px">${s.buy_score}</span>
                ${s.smart_money?'<span style="font-size:9px;padding:2px 6px;border-radius:4px;background:rgba(24,212,144,.15);color:var(--gr);margin-left:6px">🏦 smart money</span>':''}</div>
              <div style="font-size:18px;color:var(--t3)">⇄</div>
              <div style="flex:1;text-align:right"><span style="font-size:15px;font-weight:800;color:var(--re)">SELL ${s.replace}</span>
                <span style="font-size:12px;font-weight:700;color:var(--re);font-family:var(--mono);margin-left:6px">${s.replace_score}</span></div>
            </div>
            <div style="font-size:11px;color:var(--t2);margin-bottom:8px">${s.reason}</div>
            <div style="font-size:10px;color:var(--re);margin-bottom:10px">${s.replace} weakness: ${(s.replace_flags||[]).join(' · ')}</div>
            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:8px">
              <div style="background:var(--s2);border-radius:5px;padding:7px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">ENTER</div><div style="font-size:12px;font-weight:700;color:var(--gr)">${p.stance||'—'}</div></div>
              <div style="background:var(--s2);border-radius:5px;padding:7px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">AVG COST</div><div style="font-size:12px;font-weight:700">₹${p.avg_cost_if_full||'—'}</div></div>
              <div style="background:var(--s2);border-radius:5px;padding:7px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">TARGET</div><div style="font-size:12px;font-weight:700;color:var(--gr)">₹${p.target_price||'—'}</div></div>
              <div style="background:var(--s2);border-radius:5px;padding:7px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">EXP CAGR</div><div style="font-size:12px;font-weight:700;color:var(--gr)">${p.expected_cagr||'—'}%</div></div>
            </div>
            <div style="font-size:10px;color:var(--t3);font-style:italic">Fund from fresh SIP, or sell ${s.replace} (₹${(s.replace_value/100000).toFixed(1)}L) to fund. Your call.</div>
          </div>`;
        }).join('');
      }
      // BUY NOW
      if (d.buy_now && d.buy_now.length) {
        h += `<div style="font-size:12px;font-weight:700;color:var(--gr);margin:14px 0 8px">✚ BUY NOW — add from fresh SIP (no selling)</div>`;
        h += d.buy_now.map(b=>{
          const p=b.plan||{};
          return `<div class="card" style="margin-bottom:8px;border-left:3px solid var(--gr)">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
              <span style="font-size:15px;font-weight:800">${b.ticker}</span>
              <span style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;background:rgba(24,212,144,.15);color:var(--gr)">${b.grade}</span>
              <span style="font-size:12px;font-weight:700;color:var(--gr);font-family:var(--mono)">${b.composite}</span>
              ${b.smart_money?'<span style="font-size:9px;padding:2px 6px;border-radius:4px;background:rgba(24,212,144,.15);color:var(--gr)">🏦</span>':''}
              <span style="margin-left:auto;font-size:11px;color:var(--bl);font-weight:600">${p.stance||''}</span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px">
              <div style="background:var(--s2);border-radius:5px;padding:6px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">ENTRY A</div><div style="font-size:12px;font-weight:700">₹${(p.ladder&&p.ladder[0])?p.ladder[0].price:'—'}</div></div>
              <div style="background:var(--s2);border-radius:5px;padding:6px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">TARGET ${p.horizon_years||''}Y</div><div style="font-size:12px;font-weight:700;color:var(--gr)">₹${p.target_price||'—'}</div></div>
              <div style="background:var(--s2);border-radius:5px;padding:6px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">CAGR</div><div style="font-size:12px;font-weight:700;color:var(--gr)">${p.expected_cagr||'—'}%</div></div>
              <div style="background:var(--s2);border-radius:5px;padding:6px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">STOP</div><div style="font-size:12px;font-weight:700;color:var(--re)">₹${p.stop_loss||'—'}</div></div>
            </div></div>`;
        }).join('');
      }
      if (!h) h='<div class="card" style="color:var(--t3);font-size:12px">No buy or substitution actions right now. Your Core 22 is holding up.</div>';
      el.innerHTML=h;
    }
    async function loadSmartMoney() {
      const H={'Authorization':'Bearer '+localStorage.getItem('asos_token')};
      _dscMsg('Scanning bulk deals for institutional buying, then filtering by your quality bar…','info');
      document.getElementById('dscResults').innerHTML='';
      try {
        const d = await (await fetch('http://localhost:8000/discovery/smart-money?days=45&analyse=15',{headers:H})).json();
        if (d.message) { _dscMsg(d.message,'info'); return; }
        _dscMsg(`${d.smart_money_stocks} stocks with institutional buying · ${d.worthy.length} pass your quality bar`,'ok');
        let h='';
        if (d.worthy.length) {
          h+=`<div style="font-size:12px;font-weight:700;color:var(--gr);margin:4px 0 8px">🏦 SMART MONEY + WORTH OWNING</div>`;
          renderGems(d.worthy); return;
        }
        if (d.smart_money_but_weak && d.smart_money_but_weak.length) {
          h+=`<div style="font-size:12px;font-weight:700;color:var(--am);margin:14px 0 8px">⚠ SMART MONEY BOUGHT — but fails your quality test</div>`;
          h+=d.smart_money_but_weak.map(g=>`<div class="card" style="margin-bottom:6px;border-left:3px solid var(--re)">
            <div style="display:flex;align-items:center;gap:10px"><span style="font-size:13px;font-weight:700">${g.ticker}</span>
            <span style="font-size:11px;color:var(--re)">${g.grade} · ${g.composite}</span></div>
            <div style="font-size:10px;color:var(--am);margin-top:4px">${(g.flags||[]).join(' · ')}</div>
            <div style="font-size:10px;color:var(--t3);margin-top:3px">Bought by: ${(g.buyers||[]).map(b=>b.client).slice(0,2).join(', ')}</div></div>`).join('');
        }
        document.getElementById('dscResults').innerHTML=h||'<div class="card" style="color:var(--t3)">No smart-money candidates found. Upload recent bulk deals.</div>';
      } catch(e){ _dscMsg('Smart money scan failed: '+e.message,'err'); }
    }

    async function uploadScreenerExport(input) {
      const f = input.files[0]; if(!f) return;
      const fd = new FormData(); fd.append('file', f);
      _dscMsg(`Parsing ${f.name} and analysing with live Kite data… 30-60s`, 'info');
      document.getElementById('dscResults').innerHTML = '';
      try {
        const max = parseInt(document.getElementById('dscMax').value)||12;
        const r = await fetch('http://localhost:8000/discovery/upload-screener?max_analyse='+max, {
          method:'POST', headers:{'Authorization':'Bearer '+localStorage.getItem('asos_token')}, body: fd});
        if (!r.ok) { _dscMsg('Upload failed: '+(await r.text()).slice(0,200), 'err'); return; }
        const d = await r.json();
        let msg = `Parsed ${d.rows_parsed} stocks from ${d.file} · analysed top ${d.analysed}`;
        if (d.unmatched_names && d.unmatched_names.length) msg += ` · ${d.unmatched_names.length} could not be matched to NSE symbols`;
        _dscMsg(msg, 'ok');
        renderGems(d.gems);
      } catch(e){ _dscMsg('Upload error: '+e.message, 'err'); }
      finally { input.value=''; }
    }

    async function uploadBulkDeals(input) {
      const f = input.files[0]; if(!f) return;
      const fd = new FormData(); fd.append('file', f);
      try {
        const r = await fetch('http://localhost:8000/discovery/bulk-deals', {method:'POST',
          headers:{'Authorization':'Bearer '+localStorage.getItem('asos_token')}, body: fd});
        const d = await r.json(); _dscMsg(d.message || 'Uploaded', 'ok');
      } catch(e){ _dscMsg('Upload failed: '+e.message, 'err'); }
    }


    // ── AI TRADE BUILDER ────────────────────────────────────────────────────────
    function tbQuick(p){ document.getElementById('tbPrompt').value = p; tbAIBuild(); }
    function _tbMsg(t,type){ const el=document.getElementById('tbStatus'); if(!el)return; el.style.display='block'; el.textContent=t; const c={ok:['rgba(24,212,144,.08)','var(--gr)'],err:['rgba(240,48,80,.08)','var(--re)'],info:['rgba(64,128,255,.08)','var(--bl)']}[type]||['var(--s2)','var(--t2)']; el.style.background=c[0]; el.style.color=c[1]; el.style.border='1px solid var(--b1)'; }

    async function tbLoadMarket(){
      const H={'Authorization':'Bearer '+localStorage.getItem('asos_token')};
      try{
        const [reg,gate]=await Promise.all([
          fetch('http://localhost:8000/income/regime?index=NIFTY',{headers:H}).then(r=>r.json()),
          fetch('http://localhost:8000/income/entry-gate?arm=A1&index=NIFTY',{headers:H}).then(r=>r.json()).catch(()=>({})),
        ]);
        const f=reg.features||{};
        const set=(id,v,c)=>{const e=document.getElementById(id);if(e){e.textContent=v;if(c)e.style.color=c;}};
        set('tbSpot', Math.round(f.spot||0).toLocaleString('en-IN'),'var(--bl)');
        set('tbVix', (f.vix||0),'var(--gr)');
        set('tbIvr', Math.round(f.ivr||0), (f.ivr>=50)?'var(--gr)':'var(--am)');
        set('tbGate', gate.allowed?'CLEAR':'BLOCKED', gate.allowed?'var(--gr)':'var(--re)');
      }catch(e){}
    }

    async function tbAIBuild(){
      const prompt=document.getElementById('tbPrompt').value.trim();
      if(!prompt){ _tbMsg('Describe a trade first.','err'); return; }
      const btn=document.getElementById('tbBuildBtn'); btn.disabled=true; btn.textContent='Building…';
      _tbMsg('Parsing your request and building from the live chain…','info');
      document.getElementById('tbResult').innerHTML='';
      try{
        const r=await fetch('http://localhost:8000/options/ai-build',{method:'POST',
          headers:{'Authorization':'Bearer '+localStorage.getItem('asos_token'),'Content-Type':'application/json'},
          body:JSON.stringify({prompt})});
        const d=await r.json();
        if(d.error){ _tbMsg('Could not build: '+d.error,'err'); btn.disabled=false; btn.textContent='Build →'; return; }
        _tbMsg('Built '+d.structure.replace(/_/g,' ')+' from live chain','ok');
        renderBuiltTrade(d);
      }catch(e){ _tbMsg('Build failed: '+e.message,'err'); }
      finally{ btn.disabled=false; btn.textContent='Build →'; }
    }

    function renderBuiltTrade(d){
      const fmt=n=>n==null?'undefined':'₹'+Math.round(n).toLocaleString('en-IN');
      const legRows=(d.legs||[]).map(l=>`<div style="display:flex;align-items:center;gap:10px;padding:7px 12px;border-bottom:1px solid var(--b1);font-family:var(--mono);font-size:12px">
        <span style="font-weight:700;color:${l.action==='SELL'?'var(--re)':'var(--gr)'};width:44px">${l.action}</span>
        <span style="width:44px;color:${l.type==='CE'?'var(--re)':'var(--bl)'}">${l.type}</span>
        <span style="width:70px;font-weight:700">${l.strike}</span>
        <span style="color:var(--t2)">@₹${l.ltp}</span>
        <span style="margin-left:auto;color:var(--t3)">Δ ${l.delta}</span></div>`).join('');
      const gate=d.entry_gate||{};
      const deployable=d.deployable;
      const gateColor=deployable?'var(--gr)':'var(--re)';
      document.getElementById('tbResult').innerHTML=`
        <div class="card" style="border-left:3px solid ${gateColor}">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;flex-wrap:wrap">
            <span style="font-size:16px;font-weight:800;text-transform:capitalize">${d.structure.replace(/_/g,' ')}</span>
            <span style="font-size:11px;color:var(--t3);font-family:var(--mono)">${d.index} · ${d.expiry} · DTE ${d.dte} · lot ${d.lot_size}</span>
            <span style="margin-left:auto;font-size:11px;font-weight:700;padding:4px 12px;border-radius:6px;background:${deployable?'rgba(24,212,144,.12)':'rgba(240,48,80,.12)'};color:${gateColor}">${deployable?'✓ DEPLOYABLE':'✕ '+(gate.verdict||'BLOCKED')}</span>
          </div>
          <div style="background:var(--s1);border-radius:8px;overflow:hidden;margin-bottom:12px">${legRows}</div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px">
            <div style="background:var(--s2);border-radius:6px;padding:9px;text-align:center"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">NET CREDIT</div><div style="font-size:15px;font-weight:700;color:var(--gr)">${fmt(d.net_credit)}</div></div>
            <div style="background:var(--s2);border-radius:6px;padding:9px;text-align:center"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">MAX LOSS</div><div style="font-size:15px;font-weight:700;color:var(--re)">${d.defined_risk?fmt(d.max_loss):'UNDEFINED'}</div></div>
            <div style="background:var(--s2);border-radius:6px;padding:9px;text-align:center"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">TARGET 50%</div><div style="font-size:15px;font-weight:700;color:var(--gr)">${fmt(d.profit_target_50)}</div></div>
            <div style="background:var(--s2);border-radius:6px;padding:9px;text-align:center"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">STOP 1x</div><div style="font-size:15px;font-weight:700;color:var(--re)">${fmt(d.stop_1x)}</div></div>
          </div>
          ${gate.checks?`<div style="font-size:10px;color:var(--t3);margin-bottom:10px">${gate.checks.map(c=>'· '+c).join('<br>')}</div>`:''}
          <div style="display:flex;gap:8px">
            <button onclick='tbDeploy(${JSON.stringify(d).replace(/'/g,"&#39;")}, "PAPER")' style="flex:1;padding:11px;border-radius:8px;border:1px solid var(--am);background:rgba(240,160,0,.08);color:var(--am);font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">📝 Deploy PAPER</button>
            <button onclick='tbDeploy(${JSON.stringify(d).replace(/'/g,"&#39;")}, "LIVE")' ${deployable?'':'disabled'} style="flex:1;padding:11px;border-radius:8px;border:none;background:${deployable?'linear-gradient(135deg,#18d490,#0a9d68)':'var(--s3)'};color:${deployable?'#fff':'var(--t4)'};font-size:13px;font-weight:700;cursor:${deployable?'pointer':'not-allowed'};font-family:'Space Grotesk',sans-serif">${deployable?'🚀 Deploy LIVE':'🔒 LIVE blocked (IVR<50)'}</button>
          </div>
          ${!deployable?`<div style="font-size:10px;color:var(--am);margin-top:8px;text-align:center">Live deploy blocked by backtested rule. Paper-trade to test & build history.</div>`:''}
        </div>`;
    }


    async function tbBuildRecommended(){
      const btn=document.getElementById('tbRecBtn'); if(btn){btn.disabled=true; btn.textContent='Reading market…';}
      _tbMsg('Reading market condition via Strategy Matrix, then building the recommended trade…','info');
      document.getElementById('tbResult').innerHTML='';
      try{
        const d=await fetch('http://localhost:8000/matrix/recommended-trade?index=NIFTY',{headers:{'Authorization':'Bearer '+localStorage.getItem('asos_token')}}).then(r=>r.json());
        if(!d.buildable){ _tbMsg('Matrix verdict: '+(d.reason||'no trade recommended right now'),'info'); if(btn){btn.disabled=false;btn.textContent='🎯 Recommended';} return; }
        _tbMsg(`Matrix condition: ${d.matrix_condition.replace(/_/g,' ')} → ${d.matrix_strategy} (${d.matrix_dte_band} DTE). Entry: ${d.entry_rule}`,'ok');
        renderBuiltTrade(d);
      }catch(e){ _tbMsg('Recommended build failed: '+e.message,'err'); }
      finally{ if(btn){btn.disabled=false; btn.textContent='🎯 Recommended';} }
    }
    window.tbBuildRecommended = tbBuildRecommended;

    async function tbDeploy(trade, mode){
      if(mode==='LIVE' && !confirm('Deploy this trade LIVE with real capital?')) return;
      _tbMsg('Deploying '+mode+'…','info');
      try{
        const r=await fetch('http://localhost:8000/income/deploy',{method:'POST',
          headers:{'Authorization':'Bearer '+localStorage.getItem('asos_token'),'Content-Type':'application/json'},
          body:JSON.stringify({arm_code:'A1',index:trade.index,mode:mode,structure:trade.structure,
            legs:trade.legs,credit:trade.net_credit,capital_at_risk:(trade.max_loss||trade.net_credit*2),
            lots:1,expiry:trade.expiry})});
        const d=await r.json();
        if(d.error||!r.ok){ _tbMsg('Deploy failed: '+(d.error||d.detail||'error'),'err'); return; }
        _tbMsg('✓ Deployed '+mode+' — position #'+(d.position_id||d.id||'?')+'. See Trading Monitor.','ok');
      }catch(e){ _tbMsg('Deploy error: '+e.message,'err'); }
    }

    // ── CHARTS ──────────────────────────────────────────────────────────────────
    let dashProjInst = null, pnlInst = null;
    function buildDashProj() {
      if (dashProjInst) dashProjInst.destroy();
      const corpus = 3120000; const sip = 100000; const rate = 20; const mr = rate / 12 / 100;
      const labels = []; const data1 = []; const data2 = [];
      let c1 = corpus, c2 = corpus;
      for (let y = 0; y <= 21; y++) { labels.push(2025 + y); data1.push(+(c1 / 1e7).toFixed(2)); data2.push(+(c2 / 1e7).toFixed(2)); for (let m = 0; m < 12; m++) { c1 *= (1 + mr); c1 += sip; c2 *= (1 + mr); c2 += sip; } }
      dashProjInst = new Chart(document.getElementById('dashProj'), { type: 'line', data: { labels, datasets: [{ data: data1, borderColor: 'var(--gr)', backgroundColor: 'rgba(24,212,144,.07)', fill: true, tension: .4, pointRadius: 0, borderWidth: 2 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: v => v + 'Cr', font: { size: 10 }, color: 'rgba(255,255,255,.3)' }, grid: { color: 'rgba(255,255,255,.04)' } }, x: { ticks: { font: { size: 10 }, color: 'rgba(255,255,255,.3)' }, grid: { display: false } } } } });
    }
    function buildPnlChart() {
      if (pnlInst) pnlInst.destroy();
      const d = [0, 1200, 2800, 1950, 4100, 5800, 5200, 7400, 8900, 8100, 11200, 13500, 12800, 14230];
      pnlInst = new Chart(document.getElementById('pnlChart'), { type: 'line', data: { labels: d.map((_, i) => 'May ' + (i + 1)), datasets: [{ data: d, borderColor: 'var(--gr)', backgroundColor: 'rgba(24,212,144,.08)', fill: true, tension: .4, pointRadius: 2, borderWidth: 1.5 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: v => '₹' + Math.round(v / 1000) + 'K', font: { size: 10 }, color: 'rgba(255,255,255,.3)' }, grid: { color: 'rgba(255,255,255,.04)' } }, x: { ticks: { font: { size: 10 }, color: 'rgba(255,255,255,.3)' }, grid: { display: false } } } } });
    }

    // ── MOVERS & NEWS ────────────────────────────────────────────────────────────
    async function buildMkt() {
      const tok = localStorage.getItem('asos_token');
      const H = { 'Authorization': `Bearer ${tok}` };

      /* ── LIVE MOVERS from /market/movers ── */
      try {
        const r = await fetch('http://localhost:8000/market/movers', { headers: H });
        const d = await r.json();
        const fmt = arr => (arr || []).slice(0, 5).map(m => {
          const p = m.change_percent ?? m.pct ?? 0;
          const col = p >= 0 ? 'var(--gr)' : 'var(--re)';
          return `<div class="mover-row"><div class="mover-name">${m.ticker || m.symbol || m.n}</div><div class="mover-bar"><div class="mover-fill" style="width:${Math.min(100, Math.abs(p) / 5 * 100)}%;background:${col}"></div></div><div class="mover-pct" style="color:${col}">${p > 0 ? '+' : ''}${(+p).toFixed(1)}%</div><div class="mover-vol">${m.volume_str || ''}</div></div>`;
        }).join('') || '<div style="color:var(--t3);font-size:11px;padding:8px">No data — market may be closed</div>';
        document.getElementById('gainers').innerHTML = fmt(d.gainers);
        document.getElementById('losers').innerHTML = fmt(d.losers);
        if (document.getElementById('volumeLeaders')) document.getElementById('volumeLeaders').innerHTML = fmt(d.volume_leaders || d.most_active || []);
      } catch (e) {
        ['gainers', 'losers', 'volumeLeaders'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.innerHTML = '<div style="color:var(--t3);font-size:11px;padding:8px">Movers unavailable — server offline?</div>';
        });
      }

      /* ── LIVE EVENTS from /market/events ── */
      try {
        const r = await fetch('http://localhost:8000/market/events', { headers: H });
        const d = await r.json();
        const wrap = document.getElementById('eventsWrap');
        const cols = { HIGH: 'var(--re)', MEDIUM: 'var(--am)', LOW: 'var(--bl)' };
        if (wrap) wrap.innerHTML = (d.events || []).slice(0, 6).map(e => `
          <div class="ev-card">
            <div class="ev-date-box" style="border-left:3px solid ${cols[e.impact] || 'var(--bl)'}">
              <div class="ev-day" style="color:${cols[e.impact] || 'var(--bl)'}">${e.day}</div>
              <div class="ev-month">${e.month}</div>
            </div>
            <div class="ev-body" style="flex:1">
              <div class="ev-title">${e.title}</div>
              <div class="ev-sub">${e.sub}</div>
              <span class="ev-impact ${e.impact === 'HIGH' ? 'ev-high' : 'ev-med'}">${e.impact} IMPACT</span>
            </div>
            <div class="ev-countdown">
              <div class="ev-days">${e.days_away}</div>
              <div class="ev-dl">${e.days_away === 1 ? 'day away' : e.days_away === 0 ? 'TODAY' : 'days away'}</div>
            </div>
          </div>`).join('');
        const upd = document.getElementById('evUpdated');
        if (upd) upd.textContent = '· live, computed ' + new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
      } catch (e) {
        const wrap = document.getElementById('eventsWrap');
        if (wrap) wrap.innerHTML = '<div style="color:var(--t3);font-size:12px;padding:10px">Events unavailable — add athena_market.py to backend</div>';
      }

      /* ── LIVE NEWS from /market/news (Google News RSS) ── */
      try {
        const r = await fetch('http://localhost:8000/market/news', { headers: H });
        const d = await r.json();
        const colors = ['var(--bl)', 'var(--gr)', 'var(--am)', 'var(--pu)', 'var(--te)'];
        const nf = document.getElementById('newsFeed');
        if (nf) nf.innerHTML = (d.news || []).slice(0, 6).map((n, i) => `
          <div class="news-item">
            <div class="news-source"><div class="ns-dot" style="background:${colors[i % 5]}"></div><strong>${n.source}</strong> · ${n.time || 'today'}</div>
            <div class="news-title">${n.title}</div>
          </div>`).join('') || '<div style="color:var(--t3);font-size:12px;padding:10px">No news loaded</div>';
      } catch (e) {
        const nf = document.getElementById('newsFeed');
        if (nf) nf.innerHTML = '<div style="color:var(--t3);font-size:12px;padding:10px">News unavailable — add athena_market.py to backend</div>';
      }
    }

    // ── CORE 22 ──────────────────────────────────────────────────────────────────
    const C22 = [
