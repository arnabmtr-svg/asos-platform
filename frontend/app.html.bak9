          <div class="metric-box">
            <div class="mb-l">Total P&L</div>
            <div class="mb-v">—</div>
            <div class="mb-d">Unrealised</div>
          </div>
          <div class="metric-box" id="hWithdrawalBox">
            <div class="mb-l">Withdrawal</div>
            <div class="mb-v" style="color:var(--re)">₹0</div>
            <div class="mb-d">Deducted</div>
          </div>
          <div class="metric-box" id="hPendingBox">
            <div class="mb-l">Pending (T+1)</div>
            <div class="mb-v" style="color:var(--am)">₹0</div>
            <div class="mb-d">To credit</div>
          </div>
          <div class="metric-box" id="hEffectiveBox">
