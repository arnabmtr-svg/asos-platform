      { b: 3, n: 'FINCABLES', role: 'Cable infra', roce: '23%', de: '0.3', wt: 4, sip: 6000, cur: '+18.6%', act: 'HOLD' },
      { b: 3, n: 'GRANULES', role: 'API pharma', roce: '24%', de: '0.5', wt: 4, sip: 6000, cur: '+26.3%', act: 'HOLD' },
      { b: 3, n: 'SONACOMS', role: 'EV drivetrain', roce: '27%', de: '0.2', wt: 3, sip: 3000, cur: '+16.3%', act: 'HOLD' },
      { b: 3, n: 'PRICOLLTD', role: 'Precision auto', roce: '22%', de: '0.3', wt: 2.5, sip: 2000, cur: '+15.9%', act: 'HOLD' },
      { b: 3, n: 'INDUSINDBK', role: 'Private bank', roce: '14%', de: '—', wt: 2.5, sip: 7000, cur: '+30.4%', act: 'HOLD' },
      { b: 3, n: 'RELIANCE', role: 'Conglomerate', roce: '12%', de: '0.6', wt: 2, sip: 3000, cur: '+0.6%', act: 'HOLD' },
      { b: 4, n: 'PIRAMALFIN', role: 'NBFC rebuild', roce: '14%↑', de: '2.1', wt: 3.5, sip: 6000, cur: '+80.7%', act: 'HOLD' },
      { b: 4, n: 'HSCL', role: 'Spec chemicals', roce: '22%', de: '0.4', wt: 3, sip: 2000, cur: '+57.5%', act: 'HOLD' },
      { b: 4, n: 'SHILCHAR', role: 'Transformers', roce: '38%', de: '0.04', wt: 2, sip: 2000, cur: 'NEW', act: 'ADD NOW' },
      { b: 4, n: 'GMDCLTD', role: 'Mining', roce: '25%', de: '0.1', wt: 1.5, sip: 4000, cur: '+75.5%', act: 'HOLD' },
      { b: 5, n: 'GOLDBEES', role: 'Gold ETF', roce: '—', de: '—', wt: 3, sip: 1000, cur: 'NEW', act: 'ADD ₹1.5L' },
      { b: 5, n: 'Zerodha Silver', role: 'Silver ETF', roce: '—', de: '—', wt: 2, sip: 1000, cur: 'Held', act: 'HOLD' },
    ];
    const BNAMES = { 1: 'Bucket 1 — Index & Global ETFs (30%)', 2: 'Bucket 2 — Capex, Power & Defence (25%)', 3: 'Bucket 3 — Enterprise Compounders (30%)', 4: 'Bucket 4 — Tactical Alpha (10%)', 5: 'Bucket 5 — Crisis Reserve (5%)' };
    const BCOLS = { 1: 'var(--bl)', 2: 'var(--am)', 3: 'var(--gr)', 4: 'var(--pu)', 5: 'var(--am)' };
    function buildCore22() {
      let h = '';
      [1, 2, 3, 4, 5].forEach(b => {
        const stocks = C22.filter(s => s.b === b);
        h += `<div style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:12px 14px;margin-bottom:10px;border-left:3px solid ${BCOLS[b]}">
      <div style="font-size:12px;font-weight:700;margin-bottom:8px;color:${BCOLS[b]}">${BNAMES[b]}</div>
      <table><thead><tr><th>Stock</th><th>Role</th><th>ROCE</th><th>D/E</th><th>Target %</th><th>Monthly SIP</th><th>P&L / Status</th><th>Action</th></tr></thead><tbody>
      ${stocks.map(s => `<tr><td><strong>${s.n}</strong></td><td style="font-size:11px;color:var(--t2)">${s.role}</td>
        <td><span class="bx ${s.roce === 'idx' ? 'bx-b' : parseFloat(s.roce) >= 25 ? 'bx-g' : 'bx-a'}">${s.roce}</span></td>
        <td style="font-family:'IBM Plex Mono',monospace;font-size:11px">${s.de}</td>
        <td style="font-weight:600">${s.wt}%</td>
        <td style="font-weight:600;color:var(--gr)">₹${s.sip.toLocaleString('en-IN')}</td>
        <td style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:${s.cur.includes('+') ? 'var(--gr)' : s.cur === 'NEW' ? 'var(--bl)' : 'var(--am)'}">${s.cur}</td>
        <td><span class="bx ${s.act === 'HOLD' ? 'bx-g' : s.act.startsWith('ADD') ? 'bx-b' : 'bx-a'}">${s.act}</span></td></tr>`).join('')}
      </tbody></table></div>`;
      });
      document.getElementById('core22Content').innerHTML = h;
    }

    // ── WATCHLIST ────────────────────────────────────────────────────────────────
    const WL = [
      { n: 'KAYNES TECH', sector: 'Electronics Mfg', roce: '41%', de: '0.08', rev: '45%', adx: 16.2, score: 87, tier: 1, thesis: 'PCB assemblies for defence, EV, aerospace. ROCE 41% near-zero debt.', trigger: 'ADX 16.2, within 3% of 50 DMA, Q1 results beat expected', replaces: 'KPITTECH', col: 'var(--gr)' },
      { n: 'POLYCAB', sector: 'Cables', roce: '29%', de: '0.1', rev: '22%', adx: 17.4, score: 82, tier: 1, thesis: 'Larger than FINCABLES with stronger brand. Dominant market share.', trigger: 'Correction to ₹5,200 or FINCABLES 2Q PAT decline', replaces: 'FINCABLES if needed', col: 'var(--gr)' },
      { n: 'WAAREE ENERGIES', sector: 'Solar', roce: '31%', de: '0.2', rev: '68%', adx: 19.1, score: 80, tier: 1, thesis: 'India\'s largest solar panel maker. Direct 500GW target play.', trigger: '25%+ correction from peak', replaces: 'TATAPOWER', col: 'var(--gr)' },
      { n: 'HAL', sector: 'Defence Aerospace', roce: '28%', de: '0.0', rev: '19%', adx: 22.3, score: 79, tier: 2, thesis: 'Tejas jets, helicopters, MRO. ₹1.7L Cr order book — 10yr visibility.', trigger: 'Correction to ₹3,800–4,000', replaces: 'BDL if needed', col: 'var(--bl)' },
      { n: 'LAURUS LABS', sector: 'Pharma CDMO', roce: '24%', de: '0.3', rev: '18%', adx: 15.6, score: 76, tier: 2, thesis: 'API + CDMO — contract pharma. USFDA approvals unlocking US market.', trigger: '2 consecutive qtrs PAT growth', replaces: 'GRANULES complement', col: 'var(--bl)' },
      { n: 'APAR INDUSTRIES', sector: 'Conductors', roce: '22%', de: '0.4', rev: '25%', adx: 20.1, score: 74, tier: 2, thesis: 'Transformer oil + cables + conductors. Revenue CAGR 25% last 3 years.', trigger: 'P/E below 18x', replaces: 'FINCABLES complement', col: 'var(--bl)' },
    ];
    function buildWatchlist() {
      const t1 = WL.filter(s => s.tier === 1); const t2 = WL.filter(s => s.tier !== 1);
      function card(s) {
        const sc = s.score; const col = sc >= 80 ? 'var(--gr)' : sc >= 65 ? 'var(--bl)' : 'var(--am)';
        return `<div style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:13px;border-top:2px solid ${s.col}">
      <div style="font-size:14px;font-weight:700;margin-bottom:2px">${s.n}</div>
      <div style="font-size:10px;color:var(--t3);font-family:'IBM Plex Mono',monospace;margin-bottom:8px">${s.sector}</div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-bottom:8px">
        <div style="background:var(--s2);border-radius:5px;padding:5px 7px"><div style="font-size:9px;color:var(--t3);font-family:'IBM Plex Mono',monospace">ROCE</div><div style="font-size:12px;font-weight:700;color:${parseFloat(s.roce) >= 28 ? 'var(--gr)' : 'var(--am)'}">${s.roce}</div></div>
        <div style="background:var(--s2);border-radius:5px;padding:5px 7px"><div style="font-size:9px;color:var(--t3);font-family:'IBM Plex Mono',monospace">D/E</div><div style="font-size:12px;font-weight:700;color:${parseFloat(s.de) <= 0.3 ? 'var(--gr)' : 'var(--am)'}">${s.de}</div></div>
        <div style="background:var(--s2);border-radius:5px;padding:5px 7px"><div style="font-size:9px;color:var(--t3);font-family:'IBM Plex Mono',monospace">Rev CAGR</div><div style="font-size:12px;font-weight:700;color:var(--bl)">${s.rev}</div></div>
        <div style="background:var(--s2);border-radius:5px;padding:5px 7px"><div style="font-size:9px;color:var(--t3);font-family:'IBM Plex Mono',monospace">Score</div><div style="font-size:12px;font-weight:700;color:${col}">${s.score}</div></div>
      </div>
      <div style="font-size:11px;color:var(--t2);margin-bottom:6px;line-height:1.4">${s.thesis}</div>
      <div style="font-size:10px;padding:3px 8px;border-radius:4px;background:var(--s2);color:var(--t3);font-family:'IBM Plex Mono',monospace;display:inline-block">🎯 ${s.trigger}</div>
    </div>`;
      }
      document.getElementById('wlGrid').innerHTML = `<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">${t1.map(card).join('')}</div><div class="sh">Tier 2 — Monitor (score 65–79)</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">${t2.map(card).join('')}</div>`;
    }

    // ── STRATEGY SELECTOR ────────────────────────────────────────────────────────
    const STRATS = [
      { name: 'Iron Condor', sub: 'Delta-neutral · 7 DTE · Core', checks: [(v, i, a) => v < 20, (v, i, a) => i >= 30 && i <= 80, (v, i, a) => a < 20, (v, i, a) => a < 22] },
      { name: 'Iron Butterfly', sub: 'Tight IC · peak IVP', checks: [(v, i, a) => v < 18, (v, i, a) => i > 60, (v, i, a) => a < 15, (v, i, a) => a < 16] },
      { name: 'ATM Straddle', sub: 'Breakout hedge · 5% capital', checks: [(v, i, a) => a > 22, (v, i, a) => v < 25, (v, i, a) => true, (v, i, a) => true] },
      { name: 'Bull Call Spread', sub: 'Directional · bullish', checks: [(v, i, a) => a > 22, (v, i, a) => v < 22, (v, i, a) => true, (v, i, a) => i < 70] },
      { name: 'Bear Put Spread', sub: 'Directional · bearish', checks: [(v, i, a) => a > 22, (v, i, a) => v < 30, (v, i, a) => true, (v, i, a) => i < 75] },
      { name: 'Broken-Wing Butterfly', sub: 'Recovery · post-SL', checks: [(v, i, a) => v > 20, (v, i, a) => i > 50, (v, i, a) => true, (v, i, a) => true] },
      { name: 'Cash-Secured Put', sub: 'Bullish stock conviction', checks: [(v, i, a) => i > 40, (v, i, a) => v < 22, (v, i, a) => true, (v, i, a) => true] },
      { name: 'Park Liquid Fund', sub: 'VIX hard stop', checks: [(v, i, a) => v > 18, (v, i, a) => true, (v, i, a) => true, (v, i, a) => true] },
      { name: 'Long Straddle', sub: 'Vol expansion · cheap IV', checks: [(v, i, a) => i < 20, (v, i, a) => v < 15, (v, i, a) => a < 15, (v, i, a) => true] },
    ];
    function scoreS() {
      const vix = parseFloat(document.getElementById('sVix').textContent) || 13.4;
      const ivp = parseFloat(document.getElementById('sIvp').textContent) || 44;
      const adx = parseFloat(document.getElementById('sAdx').textContent) || 17;
      const scored = STRATS.map(s => { const p = s.checks.filter(f => f(vix, ivp, adx)).length; return { ...s, conf: Math.round(p / s.checks.length * 100) }; }).sort((a, b) => b.conf - a.conf);
      document.getElementById('stratCards').innerHTML = scored.map((s, i) => {
        const col = i === 0 ? 'var(--gr)' : s.conf >= 60 ? 'var(--bl)' : 'var(--re)';
        const cls = i === 0 ? `border:1px solid var(--gr);box-shadow:0 0 16px rgba(24,212,144,.1)` : s.conf >= 60 ? 'border:1px solid var(--bl)' : 'border:1px solid var(--b1);opacity:.55';
        return `<div style="background:var(--s1);${cls};border-radius:var(--r2);padding:13px;position:relative">
      ${i === 0 ? `<div style="position:absolute;top:10px;right:10px;font-size:9px;font-family:'IBM Plex Mono',monospace;padding:2px 7px;border-radius:4px;background:var(--gd);color:var(--gr);border:1px solid rgba(24,212,144,.4)">DEPLOY</div>` : ''}
      <div style="font-size:13px;font-weight:700;margin-bottom:2px">${s.name}</div>
      <div style="font-size:10px;color:var(--t3);font-family:'IBM Plex Mono',monospace;margin-bottom:8px">${s.sub}</div>
      <div style="height:4px;background:var(--s3);border-radius:99px;overflow:hidden;margin-bottom:6px"><div style="width:${s.conf}%;height:100%;background:${col};border-radius:99px"></div></div>
      <div style="font-size:11px;font-family:'IBM Plex Mono',monospace;color:${col}">${s.conf}% conditions met</div>
    </div>`;
      }).join('');
    }

    // ── AI FUNCTIONS ─────────────────────────────────────────────────────────────
    const CTX = `You are the ASOS AI — expert Indian equity analyst and options strategist. User context:
Portfolio: ₹31.1L corpus (post 47 exits today), Core 22 target, ₹1L/month SIP, 20% CAGR target, 2047 horizon.
Core 22: NIFTYBEES, MON100(new), JUNIORBEES(new), CGPOWER, TATAPOWER, BDL, HBLENGINE, HINDCOPPER, HINDALCO, ANGELONE, FINCABLES, GRANULES, SONACOMS, PRICOLLTD, INDUSINDBK, RELIANCE, PIRAMALFIN, HSCL, SHILCHAR(new), GMDCLTD, GOLDBEES(new), ZerSilver.
Open IC: NIFTY 23400P/23300P | 24400C/24500C · +43% P&L · DTE 4.
ASOS entry criteria: ROCE>22%, D/E<1, FCF+ve, promoter quality, 10yr sector tailwind.
Be direct, specific, use stock names in CAPS, give clear buy/hold/sell with numbers.`;

    /* ── Chat history per chat window ─────────────────────────────────── */
    const _chatHistory = { scoutMsgs: [], mktMsgs: [] };

    /* ── GLM 5.2 via backend — API key never touches browser ─────────── */
    async function callClaude(userMsg, msgsId, inputId, btnSel) {
      const btn = document.querySelector(btnSel);
      appendMsg(userMsg, 'u', msgsId);
      if (btn) btn.disabled = true;
      const tid = 't' + Date.now();
      appendTyping(tid, msgsId);

      /* Add to history */
      if (!_chatHistory[msgsId]) _chatHistory[msgsId] = [];
      _chatHistory[msgsId].push({ role: 'user', content: userMsg });

      try {
        const tok = localStorage.getItem('asos_token');
        const r = await fetch('http://localhost:8000/ai/chat', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${tok}`
          },
          body: JSON.stringify({
            message: userMsg,
            history: _chatHistory[msgsId].slice(-8),  /* last 4 turns */
            include_market_context: true
          })
        });
        const d = await r.json();
        document.getElementById(tid)?.remove();

        if (d.error === 'no_api_key') {
          const msg = '⚠ GLM API key not set.<br>Go to <strong>Settings → AI Scout</strong> → enter your Z.ai API key.<br><small>Get key at <a href="https://open.bigmodel.cn" target="_blank" style="color:var(--bl)">open.bigmodel.cn</a> or <a href="https://z.ai" target="_blank" style="color:var(--bl)">z.ai</a></small>';
          appendMsg(msg, 'a', msgsId);
        } else if (d.reply) {
          appendMsg(d.reply, 'a', msgsId);
          /* Add assistant response to history */
          _chatHistory[msgsId].push({ role: 'assistant', content: d.reply });
          /* Show token/cost badge */
          if (d.tokens?.total) {
            const badge = document.createElement('div');
            badge.style.cssText = 'font-size:9px;color:var(--t3);font-family:var(--mono);text-align:right;margin-top:2px;padding-right:4px';
            badge.textContent = `GLM 5.2 · ${d.tokens.total} tokens · $${(d.cost_usd || 0).toFixed(5)}`;
            const msgEl = document.getElementById(msgsId);
            if (msgEl && msgEl.lastChild) msgEl.lastChild.appendChild(badge);
          }
        } else {
          appendMsg('GLM 5.2 error: ' + (d.error || 'Unknown error'), 'a', msgsId);
        }
      } catch (e) {
        document.getElementById(tid)?.remove();
        appendMsg('Connection error — is the server running on port 8000?', 'a', msgsId);
      }
      if (btn) btn.disabled = false;
    }
    function appendMsg(text, role, msgsId) {
      const el = document.getElementById(msgsId); if (!el) return;
      const d = document.createElement('div'); d.className = 'msg msg-' + (role === 'u' ? 'u' : 'a');
      d.innerHTML = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\*(.*?)\*/g, '<em>$1</em>');
      el.appendChild(d); el.scrollTop = el.scrollHeight;
    }
    function appendTyping(id, msgsId) {
      const el = document.getElementById(msgsId); if (!el) return;
      const d = document.createElement('div'); d.className = 'msg msg-a'; d.id = id;
      d.innerHTML = '<div class="typing"><span></span><span></span><span></span></div>';
      el.appendChild(d); el.scrollTop = el.scrollHeight;
    }
    function sendMkt() {
      const v = document.getElementById('mktInput').value.trim(); if (!v) return;
      document.getElementById('mktInput').value = '';
      callClaude(v, 'mktMsgs', 'mktInput', '.csend');
    }
    function sendScout() {
      const v = document.getElementById('scoutInput').value.trim(); if (!v) return;
      document.getElementById('scoutInput').value = '';
      callClaude(v, 'scoutMsgs', 'scoutInput', '.csend');
    }
    function quickS(t) { document.getElementById('scoutInput').value = t; sendScout(); }

    // ── CHECKLIST ────────────────────────────────────────────────────────────────
    let cDone = 0; const cTotal = 12;
    function tc2(id) {
      const el = document.getElementById(id); if (!el) return;
      const d = el.classList.toggle('done'); el.textContent = d ? '✓' : '';
      cDone = Math.max(0, cDone + (d ? 1 : -1));
      document.getElementById('clProg').textContent = `${cDone}/${cTotal} done`;
      document.getElementById('pendingBadge').textContent = cTotal - cDone;
    }
    // ── DASHBOARD MINI CHECKLIST ─────────────────────────────────────────────────
    function tx(id) {
      const el = document.getElementById(id); if (!el) return;
      el.classList.toggle('done'); el.textContent = el.classList.contains('done') ? '✓' : '';
    }
    // ── INIT ─────────────────────────────────────────────────────────────────────
    buildDashProj();
  </script>

  <!-- ASOS LIVE ENGINE — embedded, no connector.js needed -->
  <script>
    const _API = 'http://localhost:8000', _tok = () => localStorage.getItem('asos_token');
    let _kiteOK = false, _holdings = null, _settingsCache = null;
    async function _api(p, o = {}) {
      const r = await fetch(_API + p, { ...o, headers: { 'Authorization': `Bearer ${_tok()}`, 'Content-Type': 'application/json', ...(o.headers || {}) } });
      if (r.status === 401) { localStorage.removeItem('asos_token'); location.href = '/static/login.html'; }
      return r;
    }
    async function _boot() {
      if (!_tok()) { location.href = '/static/login.html'; return; }
      try {
        const u = await (await _api('/auth/me')).json();
        const nm = u.name || u.email.split('@')[0];
        const ne = document.querySelector('.user-name'), ae = document.querySelector('.user-av');
        if (ne) ne.textContent = nm; if (ae) ae.textContent = nm.slice(0, 2).toUpperCase();
        _addLogout(); _startClock();
        await _loadSnap();
        _checkKite();
      } catch (e) { location.href = '/static/login.html'; }
    }
    function _addLogout() {
      const c = document.querySelector('.user-chip'); if (!c || document.getElementById('_lo')) return;
      const b = document.createElement('div'); b.id = '_lo'; b.title = 'Sign out';
      b.style.cssText = 'margin-left:auto;font-size:15px;cursor:pointer;color:var(--t3);padding-left:6px';
      b.textContent = '↩'; b.onclick = () => { localStorage.clear(); location.href = '/static/login.html'; }; c.appendChild(b);
    }
    function logout() { localStorage.clear(); location.href = '/static/login.html'; }
    function _startClock() {
      const D = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'], M = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      function tick() {
        const i = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Kolkata' }));
        const el = document.getElementById('sidebarClock');
        if (el) el.textContent = `${D[i.getDay()]} ${i.getDate()} ${M[i.getMonth()]} ${i.getFullYear()} · ${String(i.getHours()).padStart(2, '0')}:${String(i.getMinutes()).padStart(2, '0')} IST`;
        const h = i.getHours(), m = i.getMinutes(), open = (h > 9 || (h === 9 && m >= 15)) && (h < 15 || (h === 15 && m <= 30));
        const sp = document.getElementById('marketStatusPill');
        if (sp) sp.innerHTML = open ? '<span style="width:5px;height:5px;border-radius:50%;background:currentColor;animation:blink 1.6s infinite;display:inline-block;margin-right:4px"></span>Market open' : 'Market closed';
      }
      tick(); setInterval(tick, 30000);
    }
    async function _loadSnap() {
      try {
        const r = await fetch(`${_API}/market/snapshot`); if (!r.ok) throw new Error(r.status);
        const s = await r.json();
        const np = document.getElementById('niftyPill');
        if (np) { const c = s.nifty?.change_pct >= 0 ? '#18d490' : '#f03050'; np.innerHTML = `NIFTY ${(s.nifty?.spot || 0).toLocaleString('en-IN')} <span style="color:${c}">${s.nifty?.change_pct >= 0 ? '+' : ''}${(s.nifty?.change_pct || 0).toFixed(2)}%</span>`; }
        const chips = document.querySelectorAll('.vix-chip');
        if (chips[0]) { const v = chips[0].querySelector('.vix-val'); if (v) { v.textContent = `${(s.vix || 0).toFixed(1)} ${s.vix < 15 ? '✓' : s.vix < 20 ? '⚠' : '🔴'}`; v.style.color = s.vix < 15 ? 'var(--gr)' : s.vix < 20 ? 'var(--am)' : 'var(--re)'; } }
        if (chips[1]) { const v = chips[1].querySelector('.vix-val'); if (v) { v.textContent = `${(s.ivp || 0).toFixed(1)}%`; v.style.color = (s.ivp >= 30 && s.ivp <= 80) ? 'var(--am)' : 'var(--t2)'; } }
        const n = s.nifty || {}, bn = s.banknifty || {}, nc = n.change_pct || 0, bc = bn.change_pct || 0, adx = s.nifty_adx || 0;
        _box('mm-nifty', (n.spot || 0).toLocaleString('en-IN'), `${nc >= 0 ? '+' : ''}${nc.toFixed(2)}% today`, nc >= 0 ? 'var(--gr)' : 'var(--re)');
        _box('mm-bnifty', (bn.spot || 0).toLocaleString('en-IN'), `${bc >= 0 ? '+' : ''}${bc.toFixed(2)}%`, bc >= 0 ? 'var(--gr)' : 'var(--re)');
        _box('mm-vix', (s.vix || 0).toFixed(1), s.vix < 15 ? 'Deploy zone ✓' : s.vix < 20 ? 'Caution ⚠' : 'High — hold', s.vix < 15 ? 'var(--gr)' : s.vix < 20 ? 'var(--am)' : 'var(--re)');
        _box('mm-ivp', `${(s.ivp || 0).toFixed(1)}%`, `IV Rank ${(s.ivr || 0).toFixed(1)}%`, 'var(--am)');
        _box('mm-adx', adx.toFixed(1), adx < 20 ? 'Range-bound ✓ IC valid' : 'Trending — wait IC', adx < 20 ? 'var(--gr)' : 'var(--re)');
        _box('mm-dma', (s.nifty_dma50 || 0).toLocaleString('en-IN'), `${(s.nifty_dma50_gap || 0) >= 0 ? '+' : ''}${(s.nifty_dma50_gap || 0).toFixed(1)}% vs spot`, 'var(--t2)');
        const sv = document.getElementById('sVix'), si = document.getElementById('sIvp'), sa = document.getElementById('sAdx');
        if (sv) { sv.textContent = (s.vix || 0).toFixed(1); const sl = sv.parentElement?.querySelector('input[type=range]'); if (sl) sl.value = s.vix; }
        if (si) { si.textContent = Math.round(s.ivp || 0); const sl = si.parentElement?.querySelector('input[type=range]'); if (sl) sl.value = Math.round(s.ivp); }
        if (sa) { sa.textContent = adx.toFixed(1); const sl = sa.parentElement?.querySelector('input[type=range]'); if (sl) sl.value = adx; }
        console.log(`SNAP: NIFTY ${n.spot} VIX ${s.vix} IVP ${s.ivp}%`);
      } catch (e) { console.warn('Snapshot failed:', e.message); }
    }
    async function _loadMovers() {
      try {
        const r = await fetch(`${_API}/market/movers`); if (!r.ok) throw new Error(r.status);
        const m = await r.json(), all = [...(m.gainers || []), ...(m.losers || [])];
        const mx = Math.max(...all.map(x => Math.abs(x.change_pct || 0)), 1);
        function rows(list) { return list.map(it => { const p = it.change_pct || 0, c = p >= 0 ? 'var(--gr)' : 'var(--re)', f = Math.round(Math.abs(p) / mx * 100); return `<div class="mover-row"><div class="mover-name">${it.symbol}</div><div class="mover-bar"><div class="mover-fill" style="width:${f}%;background:${c}"></div></div><div class="mover-pct" style="color:${c}">${p >= 0 ? '+' : ''}${p}%</div><div class="mover-vol">${it.volume_cr ? '₹' + it.volume_cr + 'Cr' : ''}</div></div>`; }).join(''); }
        const gE = document.getElementById('gainers'), lE = document.getElementById('losers'), vE = document.getElementById('volumeLeaders');
        if (gE && m.gainers?.length) gE.innerHTML = rows(m.gainers);
        if (lE && m.losers?.length) lE.innerHTML = rows(m.losers);
        if (vE) { const v = [...all].sort((a, b) => (b.volume_cr || 0) - (a.volume_cr || 0)); vE.innerHTML = rows(v.slice(0, 5)); }
        let hdr = document.getElementById('_nh');
        if (!hdr && document.getElementById('newsFeed')) { hdr = document.createElement('div'); hdr.id = '_nh'; hdr.style.cssText = 'font-size:10px;color:var(--t3);font-family:var(--mono);padding:0 0 8px;border-bottom:1px solid var(--b1);margin-bottom:8px'; document.getElementById('newsFeed').prepend(hdr); }
        if (hdr) { const t = new Date().toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hour12: false }); hdr.textContent = `Nifty 50 movers · ${t} IST · Yahoo Finance`; }
      } catch (e) { console.warn('Movers endpoint unavailable:', e.message); }
    }
    async function _getPrefs() {
      if (_settingsCache) return _settingsCache;
      try { const r = await _api('/settings'); if (r.ok) { _settingsCache = await r.json(); return _settingsCache; } } catch (e) { }
      return { sip_amount: 100000, target_cagr: 20, target_year: 2047, sip_date: 5 };
    }
    async function _loadCorpus() {
      const cB = document.getElementById('dm-corpus'), pB = document.getElementById('dm-2047'), sB = document.getElementById('dm-sip');
      try {
        const d = await (await _api('/portfolio/holdings')).json(); _holdings = d;
        const val = d.total_value || 0, pnl = d.pnl || 0, pct = d.pnl_pct || 0, c = pnl >= 0 ? 'var(--gr)' : 'var(--re)';
        if (cB) { cB.querySelector('.mb-v').textContent = `₹${(val / 1e5).toFixed(2)}L`; cB.querySelector('.mb-v').style.color = 'var(--bl)'; const s = cB.querySelector('.mb-d'); if (s) { s.textContent = `${pnl >= 0 ? '+' : ''}₹${(pnl / 1e5).toFixed(2)}L (${pnl >= 0 ? '+' : ''}${pct.toFixed(1)}%)`; s.style.color = c; } }
        const pr = await _getPrefs(), sip = pr.sip_amount || 1e5, cagr = pr.target_cagr || 20, yrs = (pr.target_year || 2047) - new Date().getFullYear();
        const mr = cagr / 12 / 100, n = yrs * 12, fv = val * Math.pow(1 + cagr / 100, yrs) + sip * ((Math.pow(1 + mr, n) - 1) / mr) * (1 + mr);
        if (pB) { pB.querySelector('.mb-v').textContent = `₹${(fv / 1e7).toFixed(1)} Cr`; pB.querySelector('.mb-d').textContent = `At ${cagr}% CAGR`; }
        if (sB) { sB.querySelector('.mb-v').textContent = `₹${sip.toLocaleString('en-IN')}`; const s = sB.querySelector('.mb-d'); if (s) { const mo = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][new Date().getMonth()]; s.textContent = `Next: ${pr.sip_date || 5} ${mo}`; } }
        _rebuildProj(val, sip, cagr, yrs);
        _badge(true, d.holdings?.length || 0, val);
        console.log(`CORPUS: ₹${(val / 1e5).toFixed(2)}L`);
      } catch (e) {
        if (cB) { cB.querySelector('.mb-v').textContent = '—'; cB.querySelector('.mb-v').style.color = 'var(--t3)'; const s = cB.querySelector('.mb-d'); if (s) s.innerHTML = `<span style="color:var(--am);cursor:pointer" onclick="go('settings',document.querySelector('[onclick*=settings]'))">Connect Zerodha →</span>`; }
        const pr = await _getPrefs();
        if (pB) { const mr = pr.target_cagr / 12 / 100, n = (pr.target_year - new Date().getFullYear()) * 12, fv = pr.sip_amount * ((Math.pow(1 + mr, n) - 1) / mr) * (1 + mr); pB.querySelector('.mb-v').textContent = `₹${(fv / 1e7).toFixed(1)} Cr`; pB.querySelector('.mb-d').textContent = `At ${pr.target_cagr}% CAGR (SIP only)`; }
      }
    }
    function _rebuildProj(corpus, sip, cagr, years) {
      if (!window.Chart) return; const cv = document.getElementById('dashProj'); if (!cv) return;
      if (window._di) window._di.destroy();
      const mr = cagr / 12 / 100, labels = [], data = []; let c = corpus;
      for (let y = 0; y <= years; y++) { labels.push(new Date().getFullYear() + y); data.push(+(c / 1e7).toFixed(2)); for (let m = 0; m < 12; m++) { c *= (1 + mr); c += sip; } }
      window._di = new Chart(cv, { type: 'line', data: { labels, datasets: [{ data, borderColor: 'var(--gr)', backgroundColor: 'rgba(24,212,144,.07)', fill: true, tension: .4, pointRadius: 0, borderWidth: 2 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: v => v + 'Cr', font: { size: 10 }, color: 'rgba(255,255,255,.3)' }, grid: { color: 'rgba(255,255,255,.04)' } }, x: { ticks: { font: { size: 10 }, color: 'rgba(255,255,255,.3)' }, grid: { display: false } } } } });
    }
    async function _checkKite() {
      try { const d = await (await _api('/kite/status')).json(); _kiteOK = d.connected; if (d.connected) _loadCorpus(); else _badge(false, 0, 0); } catch (e) { _badge(false, 0, 0); }
    }
    function _badge(ok, cnt, val) {
      const f = document.querySelector('.sidebar-footer'); if (!f) return;
      let b = document.getElementById('_kb');
      if (!b) { b = document.createElement('div'); b.id = '_kb'; b.style.cssText = 'margin-top:6px;padding:5px 10px;border-radius:6px;font-size:10px;font-family:var(--mono);cursor:pointer;text-align:center;border:1px solid;transition:all .2s'; b.onclick = () => go('settings', document.querySelector('[onclick*="settings"]')); f.appendChild(b); }
      if (ok) { Object.assign(b.style, { background: 'var(--gd)', color: 'var(--gr)', borderColor: 'rgba(24,212,144,.3)' }); b.textContent = cnt ? `🔗 ${cnt} holdings · ₹${(val / 1e5).toFixed(1)}L` : '🔗 Zerodha connected'; }
      else { Object.assign(b.style, { background: 'var(--rd)', color: 'var(--re)', borderColor: 'rgba(240,48,80,.3)' }); b.textContent = '⚠ Connect Zerodha for live data'; }
    }
    async function loadLiveHoldings(id) {
      const el = document.getElementById(id); if (!el) return;
      el.innerHTML = '<div style="text-align:center;padding:20px;color:var(--t3);font-size:12px"><div style="width:16px;height:16px;border:2px solid var(--b2);border-top-color:var(--bl);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 8px"></div>Loading from Zerodha…</div>';
      try {
        const d = await (await _api('/portfolio/holdings')).json(), h = d.holdings || [], pc = d.pnl >= 0 ? 'var(--gr)' : 'var(--re)';
        el.innerHTML = `<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px">${[['Current value', '₹' + (d.total_value / 1e5).toFixed(2) + 'L', 'var(--bl)'], ['Invested', '₹' + (d.total_invested / 1e5).toFixed(2) + 'L', 'var(--tx)'], ['P&L', (d.pnl >= 0 ? '+' : '') + '₹' + (d.pnl / 1e5).toFixed(2) + 'L', pc], ['Holdings', h.length + ' stocks', 'var(--pu)']].map(([l, v, c]) => `<div style="background:var(--s2);border-radius:8px;padding:10px 12px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:3px">${l}</div><div style="font-size:15px;font-weight:700;color:${c}">${v}</div></div>`).join('')}</div><div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="border-bottom:1px solid var(--b1)">${['Stock', 'Qty', 'Avg', 'LTP', 'P&L ₹', 'P&L %'].map(h => `<th style="text-align:${h === 'Stock' ? 'left' : 'right'};padding:6px 8px;color:var(--t3);font-size:10px;font-family:var(--mono);text-transform:uppercase">${h}</th>`).join('')}</tr></thead><tbody>${h.sort((a, b) => ((b.last_price - b.average_price) * b.quantity) - ((a.last_price - a.average_price) * a.quantity)).map(s => { const pnl = (s.last_price - s.average_price) * s.quantity, pct = ((s.last_price - s.average_price) / s.average_price * 100), c = pnl >= 0 ? 'var(--gr)' : 'var(--re)'; return `<tr onmouseover="this.style.background='var(--s2)'" onmouseout="this.style.background=''"><td style="padding:7px 8px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.03)">${s.tradingsymbol}</td><td style="padding:7px 8px;text-align:right;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${s.quantity}</td><td style="padding:7px 8px;text-align:right;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">₹${(s.average_price || 0).toFixed(1)}</td><td style="padding:7px 8px;text-align:right;font-family:var(--mono);color:var(--bl);border-bottom:1px solid rgba(255,255,255,.03)">₹${(s.last_price || 0).toFixed(1)}</td><td style="padding:7px 8px;text-align:right;font-family:var(--mono);color:${c};border-bottom:1px solid rgba(255,255,255,.03)">${pnl >= 0 ? '+' : ''}₹${Math.round(pnl).toLocaleString('en-IN')}</td><td style="padding:7px 8px;text-align:right;font-family:var(--mono);color:${c};border-bottom:1px solid rgba(255,255,255,.03)">${pnl >= 0 ? '+' : ''}${pct.toFixed(1)}%</td></tr>`; }).join('')}</tbody></table></div>`;
      } catch (e) { el.innerHTML = '<div style="background:rgba(240,160,0,.06);border:1px solid rgba(240,160,0,.2);border-radius:8px;padding:14px;font-size:12px;color:var(--am)">⚠ Zerodha not connected. <strong style="cursor:pointer" onclick="go(\'settings\',document.querySelector(\'[onclick*=settings]\'))">Settings → Connect →</strong></div>'; }
    }
    function _injectHoldings() {
      const page = document.getElementById('core22'); if (!page) return;
      if (document.getElementById('_lhDiv')) { if (_kiteOK) loadLiveHoldings('_lhWrap'); return; }
      const div = document.createElement('div'); div.id = '_lhDiv';
      div.innerHTML = '<div style="font-size:10px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.08em;margin:14px 0 8px;display:flex;align-items:center;gap:8px;font-family:var(--mono)">Live holdings from Zerodha<span style="flex:1;height:1px;background:var(--b1);display:block"></span><button onclick="loadLiveHoldings(\'_lhWrap\')" style="font-size:10px;padding:2px 8px;border:1px solid var(--b2);background:var(--s2);color:var(--t2);border-radius:4px;cursor:pointer;font-family:\'Space Grotesk\',sans-serif">↻ Refresh</button></div><div id="_lhWrap" style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:13px 15px;margin-bottom:10px"></div>';
      page.appendChild(div); loadLiveHoldings('_lhWrap');
    }
    async function _injectSettings() {
      const page = document.getElementById('settings'); if (!page || document.getElementById('_kCard')) return;
      let kite = { connected: false }, prefs = { sip_amount: 1e5, target_cagr: 20, target_year: 2047 };
      try { kite = await (await _api('/kite/status')).json(); } catch (e) { }
      try { prefs = await _getPrefs(); } catch (e) { }
      const card = document.createElement('div'); card.id = '_kCard'; card.className = 'card'; card.style.marginBottom = '12px';
      card.innerHTML = `<div style="font-size:13px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:8px">🔗 Zerodha account <span style="font-size:10px;padding:2px 8px;border-radius:4px;font-family:var(--mono);background:${kite.connected ? 'var(--gd)' : 'var(--rd)'};color:${kite.connected ? 'var(--gr)' : 'var(--re)'};border:1px solid ${kite.connected ? 'rgba(24,212,144,.3)' : 'rgba(240,48,80,.3)'}">${kite.connected ? 'Connected ✓' : 'Not connected'}</span></div>${kite.connected ? '<div style="background:rgba(24,212,144,.06);border:1px solid rgba(24,212,144,.2);border-radius:8px;padding:9px 12px;margin-bottom:10px;font-size:12px;color:var(--gr)">✓ Live data active</div>' : ''}<div style="font-size:11px;color:var(--t3);font-family:var(--mono);line-height:1.7;margin-bottom:10px">Redirect URL: <code style="background:var(--s2);padding:1px 6px;border-radius:4px;color:var(--am)">http://localhost:8000/kite/callback</code> · <a href="https://developers.kite.trade" target="_blank" style="color:var(--bl)">developers.kite.trade</a></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px"><div><div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">API Key</div><input id="_ck" type="text" placeholder="kitexxxxxxxxxxx" style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none"></div><div><div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">API Secret</div><input id="_cs" type="password" placeholder="•••••••••••••••" style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none"></div></div><div style="display:flex;gap:8px"><button onclick="_saveK()" style="flex:1;padding:10px;border-radius:10px;border:none;background:linear-gradient(135deg,#4080ff,#00b8e0);color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">Save API key</button><button onclick="_openK()" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(240,160,0,.4);background:rgba(240,160,0,.08);color:var(--am);font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">${kite.connected ? '🔄 Reconnect' : '🔗 Open Zerodha login →'}</button></div><div id="_km" style="display:none;margin-top:8px;padding:8px 12px;border-radius:6px;font-size:12px"></div>`;
      page.insertBefore(card, page.firstChild);
      page.querySelectorAll('.sr-input').forEach(inp => { const l = inp.closest?.('.setting-row')?.querySelector?.('.sr-label')?.textContent || ''; if (l.includes('SIP')) inp.value = prefs.sip_amount; if (l.includes('CAGR')) inp.value = prefs.target_cagr; if (l.includes('year')) inp.value = prefs.target_year; });
      const sb = page.querySelector('.save-btn'); if (sb) sb.onclick = _saveS;
    }
    async function _saveK() {
      const k = document.getElementById('_ck')?.value.trim(), s = document.getElementById('_cs')?.value.trim();
      if (!k || !s) { _km('Enter both API key and secret.', 'err'); return; }
      try { await _api('/kite/setup', { method: 'POST', body: JSON.stringify({ api_key: k, api_secret: s }) }); _km('✓ Saved. Click "Open Zerodha login →"', 'ok'); } catch (e) { _km('Save failed.', 'err'); }
    }
    async function _openK() {
      try {
        const d = await (await _api('/kite/login-url')).json();
        if (!d.login_url) { _km(d.detail || 'Save API key first.', 'err'); return; }
        _km('Popup opened — log in and approve.', 'info');
        const popup = window.open(d.login_url, 'zerodha', 'width=520,height=700,left=400,top=80');
        const poll = setInterval(async () => { if (!popup || popup.closed) { clearInterval(poll); await _checkKite(); document.getElementById('_kCard')?.remove(); _settingsCache = null; await _injectSettings(); _km(_kiteOK ? '✓ Connected!' : 'Not connected — try again.', _kiteOK ? 'ok' : 'err'); } }, 600);
      } catch (e) { _km('Error — server running on 8000?', 'err'); }
    }
    async function _saveS() {
      _settingsCache = null; const body = { sip_amount: 1e5, target_cagr: 20, target_year: 2047, telegram_chat_id: '' };
      document.getElementById('settings').querySelectorAll('.sr-input').forEach(inp => { const l = inp.closest?.('.setting-row')?.querySelector?.('.sr-label')?.textContent || ''; if (l.includes('SIP')) body.sip_amount = parseFloat(inp.value) || 1e5; if (l.includes('CAGR')) body.target_cagr = parseFloat(inp.value) || 20; if (l.includes('year')) body.target_year = parseInt(inp.value) || 2047; });
      try { await _api('/settings', { method: 'POST', body: JSON.stringify(body) }); _km('✓ Settings saved', 'ok'); if (_kiteOK) _loadCorpus(); } catch (e) { _km('Save failed.', 'err'); }
    }
    function _km(txt, type) {
      const el = document.getElementById('_km'); if (!el) return; el.textContent = txt; el.style.display = 'block';
      const c = { ok: ['rgba(24,212,144,.1)', 'rgba(24,212,144,.25)', 'var(--gr)'], err: ['rgba(240,48,80,.1)', 'rgba(240,48,80,.25)', 'var(--re)'], info: ['rgba(64,128,255,.1)', 'rgba(64,128,255,.25)', 'var(--bl)'] }[type] || ['rgba(64,128,255,.1)', 'rgba(64,128,255,.25)', 'var(--bl)'];
      el.style.background = c[0]; el.style.border = `1px solid ${c[1]}`; el.style.color = c[2];
    }
    function _box(id, val, sub, col) { const b = document.getElementById(id); if (!b) return; const v = b.querySelector('.mb-v'), d = b.querySelector('.mb-d'); if (v) { v.textContent = val; v.style.color = col; } if (d) { d.textContent = sub; d.style.color = col; } }
    const _og = window.go;
    window.go = function (id, el) {
      if (_og) _og(id, el);
      if (id === 'dashboard') { setTimeout(() => { if (_kiteOK) _loadCorpus(); }, 100); }
      if (id === 'market') { setTimeout(() => { _loadSnap(); _loadMovers(); }, 100); }
      if (id === 'core22') { setTimeout(_injectHoldings, 100); }
      if (id === 'settings') { setTimeout(_injectSettings, 80); }
    };
    setInterval(() => { _loadSnap(); if (document.getElementById('market')?.classList.contains('on')) _loadMovers(); if (_kiteOK) _loadCorpus(); }, 60000);
    _boot();
    console.log('ASOS Live Engine ready');
  </script>

  <!-- ASOS Platform v2 — Holdings, Gap Analysis, Options Chain, Live Watchlist -->
  <script>
    const _V2_API = 'http://localhost:8000';
    const _v2tok = () => localStorage.getItem('asos_token');

    async function _v2api(path, opts = {}) {
      const r = await fetch(_V2_API + path, {
        ...opts,
        headers: { 'Authorization': `Bearer ${_v2tok()}`, 'Content-Type': 'application/json', ...(opts.headers || {}) }
      });
      // Only redirect for auth failures on auth endpoints, NOT Zerodha errors
      if (r.status === 401 && path.startsWith('/auth')) {
        localStorage.removeItem('asos_token'); location.href = '/static/login.html';
      }
      return r;
    }

    /* ── Patch go() to wire new pages ────────────────────────────────────── */
    const _v2OrigGo = window.go;
    window.go = function (id, el) {
      if (_v2OrigGo) _v2OrigGo(id, el);
      if (id === 'holdings') setTimeout(loadHoldingsPage, 100);
      if (id === 'core22gap') setTimeout(loadCore22Gap, 100);
      if (id === 'optionschain') setTimeout(() => loadOC(), 150);

    };

    /* ════════════════════════════════════════════════════════════════════════
       HOLDINGS PAGE
       ════════════════════════════════════════════════════════════════════════ */
    async function loadHoldingsPage() {
      const wrap = document.getElementById('holdingsTableWrap');
      const src = document.getElementById('holdingsSource');
      if (!wrap) return;
      wrap.innerHTML = _v2spin('Fetching holdings…');
      try {
        const d = await (await _v2api('/portfolio/holdings')).json();
        // Update source label
        const srcMap = {
          zerodha_live: '🔴 Live from Zerodha', stored_with_live_price: '💾 Stored + Yahoo Finance prices',
          csv_upload: '📤 Uploaded CSV', manual: '✏️ Manual entry', empty: '⚠️ No data — upload CSV or connect Zerodha'
        };
        if (src) src.textContent = srcMap[d.source] || d.source;

        // Load settings for withdrawal/pending
        const prefs = await (await _v2api('/settings')).json();
        const withdrawal = prefs.withdrawal_amount || 0;
        const pending = prefs.pending_credit || 0;
        const effective = (d.total_value || 0) - withdrawal + pending;

        // Update summary bar
        _v2updBox('holdingsSummaryBar', 0, `₹${(d.total_value / 1e5).toFixed(2)}L`, `+₹${(d.pnl / 1e5).toFixed(2)}L (${(d.pnl_pct || 0).toFixed(1)}%)`, d.pnl >= 0 ? 'var(--gr)' : 'var(--re)');
        _v2updBox('holdingsSummaryBar', 1, `₹${(d.total_invested / 1e5).toFixed(2)}L`, `${d.count || 0} holdings`, 'var(--tx)');
        _v2updBox('holdingsSummaryBar', 2, `${d.pnl >= 0 ? '+' : ''}₹${(d.pnl / 1e5).toFixed(2)}L`, `${(d.pnl_pct || 0).toFixed(1)}%`, d.pnl >= 0 ? 'var(--gr)' : 'var(--re)');
        const wBox = document.getElementById('hWithdrawalBox');
        if (wBox) { wBox.querySelector('.mb-v').textContent = `₹${(withdrawal / 1e5).toFixed(2)}L`; wBox.querySelector('.mb-v').style.color = 'var(--re)'; }
        const pBox = document.getElementById('hPendingBox');
        if (pBox) { pBox.querySelector('.mb-v').textContent = `₹${(pending / 1e5).toFixed(2)}L`; pBox.querySelector('.mb-v').style.color = 'var(--am)'; }
        const eBox = document.getElementById('hEffectiveBox');
        if (eBox) { eBox.querySelector('.mb-v').textContent = `₹${(effective / 1e5).toFixed(2)}L`; eBox.querySelector('.mb-v').style.color = 'var(--gr)'; }

        const h = d.holdings || [];
        if (!h.length) {
          wrap.innerHTML = `<div style="text-align:center;padding:24px">
          <div style="font-size:14px;color:var(--am);margin-bottom:8px">⚠ No holdings found</div>
          <div style="font-size:12px;color:var(--t2);line-height:1.8">
            Option 1: <strong style="color:var(--bl);cursor:pointer" onclick="go('settings',document.querySelector('[onclick*=settings]'))">Connect Zerodha</strong> for live data<br>
            Option 2: Download CSV from Kite → Portfolio → Holdings → Upload above<br>
            Option 3: Click <strong>+ Add manually</strong> above to enter stock by stock
          </div></div>`;
          return;
        }

        const pnlColor = d.pnl >= 0 ? 'var(--gr)' : 'var(--re)';
        wrap.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:6px">
          <div style="font-size:12px;font-weight:600">${h.length} holdings · sorted by P&L</div>
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">Effective corpus: ₹${(effective / 1e5).toFixed(2)}L = ₹${(d.total_value / 1e5).toFixed(2)}L − ₹${(withdrawal / 1e5).toFixed(2)}L + ₹${(pending / 1e5).toFixed(2)}L</div>
        </div>
        <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:12px">
          <thead><tr style="border-bottom:1px solid var(--b1)">
            ${['Stock', 'Qty', 'Avg (₹)', 'LTP (₹)', 'Value (₹)', 'P&L (₹)', 'P&L %', '% of corpus', 'Action'].map(h => `<th style="text-align:${h === 'Stock' || h === 'Action' ? 'left' : 'right'};padding:6px 8px;color:var(--t3);font-size:10px;font-family:var(--mono);text-transform:uppercase;white-space:nowrap">${h}</th>`).join('')}
          </tr></thead>
          <tbody>
            ${h.sort((a, b) => ((b.last_price - b.average_price) * b.quantity) - ((a.last_price - a.average_price) * a.quantity))
            .map(s => {
              const pnl = (s.last_price - s.average_price) * s.quantity;
              const pct = s.average_price ? ((s.last_price - s.average_price) / s.average_price * 100) : 0;
              const val = s.last_price * s.quantity;
              const corpPct = effective ? ((val / effective) * 100) : 0;
              const c = pnl >= 0 ? 'var(--gr)' : 'var(--re)';
              const isCore22 = ['NIFTYBEES', 'MON100', 'JUNIORBEES', 'CGPOWER', 'TATAPOWER', 'BDL', 'HBLENGINE', 'HINDCOPPER', 'HINDALCO', 'ANGELONE', 'FINCABLES', 'GRANULES', 'SONACOMS', 'PRICOLLTD', 'INDUSINDBK', 'RELIANCE', 'PIRAMALFIN', 'HSCL', 'SHILCHAR', 'GMDCLTD', 'GOLDBEES', 'SILVERETF'].includes(s.tradingsymbol);
              return `<tr onmouseover="this.style.background='var(--s2)'" onmouseout="this.style.background=''">
                  <td style="padding:7px 8px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.03);border-left:2px solid ${isCore22 ? 'var(--gr)' : 'var(--re)'}">${s.tradingsymbol}${isCore22 ? '<span style="font-size:9px;margin-left:4px;color:var(--gr)">✓C22</span>' : ''}</td>
                  <td style="padding:7px 8px;text-align:right;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${s.quantity}</td>
                  <td style="padding:7px 8px;text-align:right;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">₹${(s.average_price || 0).toFixed(1)}</td>
                  <td style="padding:7px 8px;text-align:right;font-family:var(--mono);color:var(--bl);border-bottom:1px solid rgba(255,255,255,.03)">₹${(s.last_price || 0).toFixed(1)}</td>
                  <td style="padding:7px 8px;text-align:right;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">₹${Math.round(val).toLocaleString('en-IN')}</td>
                  <td style="padding:7px 8px;text-align:right;font-family:var(--mono);color:${c};border-bottom:1px solid rgba(255,255,255,.03)">${pnl >= 0 ? '+' : ''}₹${Math.round(pnl).toLocaleString('en-IN')}</td>
                  <td style="padding:7px 8px;text-align:right;font-family:var(--mono);color:${c};border-bottom:1px solid rgba(255,255,255,.03)">${pnl >= 0 ? '+' : ''}${pct.toFixed(1)}%</td>
                  <td style="padding:7px 8px;text-align:right;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${corpPct.toFixed(1)}%</td>
                  <td style="padding:7px 8px;border-bottom:1px solid rgba(255,255,255,.03)"><span style="font-size:10px;padding:2px 7px;border-radius:4px;cursor:pointer;background:${isCore22 ? 'var(--gd)' : 'var(--rd)'};color:${isCore22 ? 'var(--gr)' : 'var(--re)'};border:1px solid ${isCore22 ? 'rgba(24,212,144,.3)' : 'rgba(240,48,80,.3)'}">${isCore22 ? 'HOLD' : 'SELL'}</span></td>
                </tr>`;
            }).join('')}
          </tbody>
        </table></div>`;
      } catch (e) {
        wrap.innerHTML = `<div style="color:var(--re);padding:12px;font-size:12px">Error loading holdings: ${e.message}</div>`;
      }
    }

    function _v2updBox(parentId, idx, val, sub, color) {
      const boxes = document.querySelectorAll(`#${parentId} .metric-box`);
      if (!boxes[idx]) return;
      const v = boxes[idx].querySelector('.mb-v'), d = boxes[idx].querySelector('.mb-d');
      if (v) { v.textContent = val; v.style.color = color; }
      if (d) d.textContent = sub;
    }

    function showAddHolding() {
      const f = document.getElementById('addHoldingForm');
      if (f) f.style.display = f.style.display === 'none' ? 'block' : 'none';
    }

    async function saveManualHolding() {
      const ticker = document.getElementById('ah-ticker')?.value.trim();
      const qty = document.getElementById('ah-qty')?.value;
      const avg = document.getElementById('ah-avg')?.value;
      const ltp = document.getElementById('ah-ltp')?.value || avg;
      if (!ticker || !qty || !avg) { alert('Fill in all fields'); return; }
      try {
        await _v2api('/portfolio/holdings/manual', { method: 'POST', body: JSON.stringify({ ticker, quantity: parseInt(qty), average_price: parseFloat(avg), last_price: parseFloat(ltp) }) });
        document.getElementById('addHoldingForm').style.display = 'none';
        loadHoldingsPage();
      } catch (e) { alert('Save failed: ' + e.message); }
    }

    async function uploadHoldingsCSV(input) {
      const file = input.files[0]; if (!file) return;
      const fd = new FormData(); fd.append('file', file);
      try {
        const r = await fetch(`${_V2_API}/portfolio/holdings/upload`, {
          method: 'POST', headers: { 'Authorization': `Bearer ${_v2tok()}` }, body: fd
        });
        const d = await r.json();
        alert(d.message || 'Upload complete');
        loadHoldingsPage();
      } catch (e) { alert('Upload failed: ' + e.message); }
    }

    /* ════════════════════════════════════════════════════════════════════════
       CORE 22 GAP ANALYSIS
       ════════════════════════════════════════════════════════════════════════ */
    async function loadCore22Gap() {
      const tw = document.getElementById('gapTableWrap');
      const sw = document.getElementById('sellListWrap');
      if (!tw) return;
      tw.innerHTML = _v2spin('Calculating gap vs Core 22 targets…');
      try {
        const d = await (await _v2api('/portfolio/core22-gap')).json();
        const eff = d.effective_corpus || 0;

        // Summary bar
        const sumBoxes = document.querySelectorAll('#gapSummaryBar .metric-box');
        if (sumBoxes[0]) { sumBoxes[0].querySelector('.mb-v').textContent = `₹${(eff / 1e5).toFixed(2)}L`; }
        if (sumBoxes[1]) { sumBoxes[1].querySelector('.mb-v').textContent = `₹${((d.total_gap_to_fill || 0) / 1e5).toFixed(2)}L`; sumBoxes[1].querySelector('.mb-v').style.color = 'var(--am)'; }
        if (sumBoxes[2]) { sumBoxes[2].querySelector('.mb-v').textContent = d.sell_list?.length || 0; sumBoxes[2].querySelector('.mb-v').style.color = 'var(--re)'; }
        if (sumBoxes[3]) { sumBoxes[3].querySelector('.mb-v').textContent = `${d.completion_pct || 0}%`; sumBoxes[3].querySelector('.mb-v').style.color = 'var(--gr)'; }

        const gap = d.gap_analysis || [];
        const BNAMES = { 1: 'Bucket 1 — Index ETFs', 2: 'Bucket 2 — Capex & Defence', 3: 'Bucket 3 — Compounders', 4: 'Bucket 4 — Tactical', 5: 'Bucket 5 — Crisis Reserve' };
        const BCOLS = { 1: 'var(--bl)', 2: 'var(--am)', 3: 'var(--gr)', 4: 'var(--pu)', 5: 'var(--am)' };
        let html = '';
        [1, 2, 3, 4, 5].forEach(b => {
          const stocks = gap.filter(g => g.bucket === b);
          if (!stocks.length) return;
          html += `<div style="margin-bottom:12px"><div style="font-size:11px;font-weight:700;color:${BCOLS[b]};margin-bottom:6px;padding-bottom:4px;border-bottom:1px solid var(--b1)">${BNAMES[b]}</div>
          <table style="width:100%;border-collapse:collapse;font-size:12px">
            <thead><tr style="border-bottom:1px solid var(--b1)">
              ${['Stock', 'Role', 'Target%', 'Current%', 'Target ₹', 'Current ₹', 'Gap ₹', 'SIP/mo', 'Action'].map(h => `<th style="text-align:${h === 'Stock' || h === 'Role' || h === 'Action' ? 'left' : 'right'};padding:5px 8px;color:var(--t3);font-size:10px;font-family:var(--mono);text-transform:uppercase">${h}</th>`).join('')}
            </tr></thead><tbody>`;
          stocks.forEach(s => {
            const ac = s.action.includes('BUY') ? 'var(--bl)' : s.action === 'TRIM' ? 'var(--re)' : 'var(--gr)';
            const bc = s.action.includes('BUY') ? 'var(--bd)' : s.action === 'TRIM' ? 'var(--rd)' : 'var(--gd)';
            const gapColor = s.gap_val > 0 ? 'var(--am)' : s.gap_val < 0 ? 'var(--re)' : 'var(--gr)';
            html += `<tr onmouseover="this.style.background='var(--s2)'" onmouseout="this.style.background=''">
            <td style="padding:6px 8px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.03)">${s.ticker}</td>
            <td style="padding:6px 8px;font-size:11px;color:var(--t2);border-bottom:1px solid rgba(255,255,255,.03)">${s.role}</td>
            <td style="padding:6px 8px;text-align:right;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${s.target_pct}%</td>
            <td style="padding:6px 8px;text-align:right;font-family:var(--mono);color:${Math.abs(s.current_pct - s.target_pct) < 1 ? 'var(--gr)' : 'var(--am)'};border-bottom:1px solid rgba(255,255,255,.03)">${s.current_pct}%</td>
            <td style="padding:6px 8px;text-align:right;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">₹${(s.target_val / 1e5).toFixed(1)}L</td>
            <td style="padding:6px 8px;text-align:right;font-family:var(--mono);color:${s.held ? 'var(--tx)' : 'var(--t3)'};border-bottom:1px solid rgba(255,255,255,.03)">${s.held ? '₹' + (s.current_val / 1e5).toFixed(1) + 'L' : '—'}</td>
            <td style="padding:6px 8px;text-align:right;font-family:var(--mono);color:${gapColor};font-weight:600;border-bottom:1px solid rgba(255,255,255,.03)">${s.gap_val > 0 ? '+' : ''}₹${(s.gap_val / 1e5).toFixed(1)}L</td>
            <td style="padding:6px 8px;text-align:right;font-family:var(--mono);color:var(--gr);border-bottom:1px solid rgba(255,255,255,.03)">₹${(s.monthly_sip / 1000).toFixed(0)}K</td>
            <td style="padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.03)"><span style="font-size:10px;padding:2px 7px;border-radius:4px;background:${bc};color:${ac};border:1px solid ${ac.replace(')', ',_.25)')};font-family:var(--mono)">${s.action}</span></td>
          </tr>`;
          });
          html += '</tbody></table></div>';
        });
        tw.innerHTML = html || '<div style="color:var(--t3);font-size:12px;padding:12px">No gap data available</div>';

        // Sell list
        const sells = d.sell_list || [];
        if (sw) {
          if (!sells.length) {
            sw.innerHTML = '<div style="color:var(--gr);font-size:12px;padding:12px">✓ No extra stocks — portfolio already aligned with Core 22</div>';
          } else {
            sw.innerHTML = `<table style="width:100%;border-collapse:collapse;font-size:12px">
            <thead><tr style="border-bottom:1px solid var(--b1)">${['Stock', 'Qty', 'LTP', 'Value', 'Action'].map(h => `<th style="text-align:left;padding:5px 8px;color:var(--t3);font-size:10px;font-family:var(--mono);text-transform:uppercase">${h}</th>`).join('')}</tr></thead>
            <tbody>${sells.map(s => `<tr><td style="padding:6px 8px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.03);border-left:2px solid var(--re)">${s.ticker}</td><td style="padding:6px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${s.quantity}</td><td style="padding:6px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">₹${s.ltp}</td><td style="padding:6px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">₹${(s.value / 1e5).toFixed(2)}L</td><td style="padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.03)"><span style="font-size:10px;padding:2px 7px;border-radius:4px;background:var(--rd);color:var(--re);border:1px solid rgba(240,48,80,.3);font-family:var(--mono)">${s.action}</span></td></tr>`).join('')}</tbody>
          </table>`;
          }
        }
      } catch (e) {
        if (tw) tw.innerHTML = `<div style="color:var(--re);font-size:12px;padding:12px">Error: ${e.message}</div>`;
      }
    }

    /* ════════════════════════════════════════════════════════════════════════
       OPTIONS CHAIN
       ════════════════════════════════════════════════════════════════════════ */
    let _ocSymbol = 'NIFTY', _ocExpiry = '', _icPayoff = null;

    function setOCSymbol(sym, btn) {
      _ocSymbol = sym;
      document.querySelectorAll('#ocNiftyBtn,#ocBNBtn').forEach(b => {
        b.style.background = 'var(--s2)'; b.style.borderColor = 'var(--b2)'; b.style.color = 'var(--t2)';
      });
      if (btn) { btn.style.background = 'var(--bd)'; btn.style.borderColor = 'var(--bl)'; btn.style.color = 'var(--bl)'; }
      loadOC();
    }

    async function loadOC() {
      const expiry = document.getElementById('ocExpiry')?.value || _ocExpiry;
      _ocExpiry = expiry;
      const body = document.getElementById('ocChainBody');
      if (!body) return;
      body.innerHTML = `<div style="text-align:center;padding:24px;color:var(--t3);font-size:12px">Loading ${_ocSymbol} chain…</div>`;

      try {
        const tok = localStorage.getItem('asos_token');
        const H = {'Authorization':`Bearer ${tok}`};
        const url = `http://localhost:8000/options/chain?index=${_ocSymbol}${expiry ? '&expiry=' + expiry : ''}&width=15`;
        const r = await fetch(url, {headers:H});
        if (!r.ok) throw new Error(await r.text());
        const raw = await r.json();
        if (raw.error) throw new Error(raw.error);
        // Also pull VIX/IVR + IC suggestion + entry gate in parallel
        const [regR, icR, gateR] = await Promise.all([
          fetch(`http://localhost:8000/income/regime?index=${_ocSymbol==='BANKNIFTY'?'NIFTY':'NIFTY'}`,{headers:H}).then(x=>x.json()).catch(()=>({})),
          fetch(`http://localhost:8000/options/build-ic?index=${_ocSymbol}&delta=16`,{headers:H}).then(x=>x.json()).catch(()=>({})),
          fetch(`http://localhost:8000/income/entry-gate?arm=A1&index=NIFTY`,{headers:H}).then(x=>x.json()).catch(()=>({})),
        ]);
        // Map our real-chain shape -> the shape this renderer expects
        const d = {
          spot: raw.spot, atm: raw.atm, expiry: raw.expiry, dte: raw.dte,
          expiries: raw.expiries, pcr: raw.pcr, max_pain: raw.max_pain,
          vix: regR.features ? regR.features.vix : '—',
          ivp: regR.features ? regR.features.ivr : '—',
          source: 'live_kite',
          deploy_signal: gateR.allowed ? 'DEPLOY' : 'WAIT',
          chain: (raw.rows||[]).map(x => ({
            strike: x.strike,
            call_ltp: x.CE.ltp, call_delta: x.CE.delta, call_iv: x.CE.iv || 0,
            put_ltp: x.PE.ltp, put_delta: x.PE.delta, put_iv: x.PE.iv || 0,
            call_16d: Math.abs(x.CE.delta-0.16)<0.03, put_16d: Math.abs(Math.abs(x.PE.delta)-0.16)<0.03,
          })),
          ic: icR.legs ? {
            short_call: icR.legs.short_call.strike, sc_entry: icR.legs.short_call.ltp,
            short_put: icR.legs.short_put.strike, sp_entry: icR.legs.short_put.ltp,
            long_call: icR.legs.long_call.strike, long_put: icR.legs.long_put.strike,
            net_credit: icR.net_credit, profit_target: icR.profit_target_50, stop_loss: icR.stop_1x,
            max_loss: icR.max_loss, pop: icR.pop_estimate,
          } : {},
          gate: gateR,
        };

        // Update expiry selector
        const sel = document.getElementById('ocExpiry');
        if (sel && d.expiries) {
          const cur = sel.value;
          sel.innerHTML = d.expiries.map(e => `<option value="${e}" ${e === d.expiry ? 'selected' : ''}>${e} (${(new Date(e) - new Date()) / (86400000) | 0}d)</option>`).join('');
        }
        _ocExpiry = d.expiry;

        // Header metrics
        const setEl = (id, v, c) => { const el = document.getElementById(id); if (el) { el.textContent = v; if (c) el.style.color = c; } };
        setEl('ocSpot', `${_ocSymbol} ${d.spot?.toLocaleString('en-IN')}`, 'var(--bl)');
        setEl('ocVix', `VIX ${d.vix}`, d.vix < 15 ? 'var(--gr)' : d.vix < 20 ? 'var(--am)' : 'var(--re)');
        setEl('ocIvp', `IVP ${d.ivp}%`, (d.ivp >= 30 && d.ivp <= 80) ? 'var(--am)' : 'var(--t2)');
        setEl('ocDte', `DTE ${d.dte}`, 'var(--t2)');
        setEl('ocPcr', d.pcr?.toFixed(2), d.pcr > 1 ? 'var(--gr)' : d.pcr < 0.8 ? 'var(--re)' : 'var(--am)');
        setEl('ocPcrNote', d.pcr > 1.2 ? 'Bullish (put heavy)' : d.pcr < 0.7 ? 'Bearish (call heavy)' : 'Neutral', '');
        setEl('ocMaxPain', d.max_pain?.toLocaleString('en-IN'), 'var(--bl)');
        setEl('ocAtm', d.atm?.toLocaleString('en-IN'), 'var(--bl)');
        const sigEl = document.getElementById('ocSignal');
        if (sigEl) { sigEl.textContent = d.deploy_signal; sigEl.style.color = d.deploy_signal === 'DEPLOY' ? 'var(--gr)' : 'var(--re)'; }
        const sigNote = sigEl ? sigEl.parentElement.querySelector('div:last-child') : null;
        if (sigNote && d.gate) sigNote.textContent = d.gate.allowed ? 'IVR>=50 - deploy OK' : `blocked: IVR ${Math.round(d.gate.ivr)}<50`;
        setEl('ocSource', d.source === 'live_kite' ? '🔴 Live Kite' : '📐 Black-Scholes model', 'var(--t3)');

        // IC builder
        const ic = d.ic || {};
        setEl('icShortCall', ic.short_call ? `${ic.short_call} CE  @₹${ic.sc_entry}` : '—', 'var(--re)');
        setEl('icShortPut', ic.short_put ? `${ic.short_put} PE  @₹${ic.sp_entry}` : '—', 'var(--bl)');
        setEl('icCredit', ic.net_credit ? `₹${ic.net_credit}` : '—', 'var(--gr)');
        setEl('icTarget', ic.profit_target ? `₹${ic.profit_target}` : '—', 'var(--gr)');
        setEl('icStop', ic.stop_loss ? `₹${ic.stop_loss}` : '—', 'var(--re)');
        setEl('icDte', d.dte || '—', '');

        // Checklist
        const ivrNum = parseFloat(d.ivp) || 0;
        const checks = [
          ['IVR', ivrNum >= 50, `IVR ${d.ivp} (BACKTESTED: need >= 50 to sell)`],
          ['GATE', d.gate && d.gate.allowed, d.gate && d.gate.allowed ? 'Entry gate CLEAR' : 'Entry gate BLOCKED'],
          ['DTE', d.dte >= 3 && d.dte <= 45, `DTE ${d.dte}`],
          ['CREDIT', (d.ic.net_credit||0) > 0, `Credit ₹${d.ic.net_credit||0}`],
        ];
        const clEl = document.getElementById('icChecklist');
        if (clEl) clEl.innerHTML = checks.map(([l, ok, note]) => `<div style="display:flex;align-items:center;gap:6px;padding:2px 0;font-size:11px;color:var(--t2)"><span style="color:${ok ? 'var(--gr)' : 'var(--re)'};font-size:13px">${ok ? '✓' : '✗'}</span>${note}</div>`).join('');

        // Draw payoff chart
        drawPayoff(d.spot, ic);

        // Chain table
        const chain = d.chain || [];
        const atm = d.atm;
        body.innerHTML = chain.map(s => {
          const isAtm = s.strike === atm;
          const is16dC = s.call_16d;
          const is16dP = s.put_16d;
          const rowBg = isAtm ? 'rgba(64,128,255,.08)' : is16dC || is16dP ? 'rgba(24,212,144,.04)' : '';
          const cdelta = (s.call_delta || 0).toFixed(2);
          const pdelta = Math.abs(s.put_delta || 0).toFixed(2);
          return `<div style="display:grid;grid-template-columns:1fr 1fr 1fr 80px 1fr 1fr 1fr;gap:0;padding:4px 8px;border-bottom:0.5px solid var(--b1);background:${rowBg};font-family:'IBM Plex Mono',monospace;font-size:11px;cursor:pointer" onclick="selectICStrike(${s.strike})">
          <span style="color:${is16dC ? 'var(--gr)' : 'var(--re)'};font-weight:${is16dC ? 700 : 400}">${(s.call_ltp || 0).toFixed(1)}</span>
          <span style="color:var(--t3)">${cdelta}</span>
          <span style="color:var(--t3)">${(s.call_iv || 0).toFixed(1)}%</span>
          <span style="text-align:center;color:${isAtm ? 'var(--bl)' : is16dC || is16dP ? 'var(--gr)' : 'var(--tx)'};font-weight:${isAtm ? 700 : 400};background:${isAtm ? 'rgba(64,128,255,.15)' : ''};border-radius:4px;padding:0 4px">${s.strike.toLocaleString('en-IN')}</span>
          <span style="text-align:right;color:var(--t3)">${(s.put_iv || 0).toFixed(1)}%</span>
          <span style="text-align:right;color:var(--t3)">${pdelta}</span>
          <span style="text-align:right;color:${is16dP ? 'var(--gr)' : 'var(--bl)'};font-weight:${is16dP ? 700 : 400}">${(s.put_ltp || 0).toFixed(1)}</span>
        </div>`;
        }).join('');

      } catch (e) {
        body.innerHTML = `<div style="color:var(--re);padding:12px;font-size:12px">Chain error: ${e.message}</div>`;
      }
    }

    function selectICStrike(strike) {
      console.log('Strike selected for IC:', strike);
      // Future: allow manual strike selection for IC
    }

    function drawPayoff(spot, ic) {
      if (!window.Chart || !ic.short_call) return;
      const cv = document.getElementById('icPayoffChart'); if (!cv) return;
      if (_icPayoff) _icPayoff.destroy();
      const step = ic.short_call > 24000 ? 100 : 50;
      const range = [];
      for (let s = spot * 0.96; s <= spot * 1.04; s += step) range.push(Math.round(s / step) * step);
      const credit = (ic.net_credit || 0) / 25; // per share
      const data = range.map(s => {
        const callPL = Math.min(0, ic.short_call - s) - Math.max(0, ic.long_call - s) + (ic.sc_entry - (ic.lc_entry || ic.sc_entry * 0.4));
        const putPL = Math.min(0, s - ic.short_put) - Math.max(0, s - ic.long_put) + (ic.sp_entry - (ic.lp_entry || ic.sp_entry * 0.4));
        return Math.round((callPL + putPL) * 25);
      });
      _icPayoff = new Chart(cv, {
        type: 'line',
        data: { labels: range.map(s => s.toLocaleString('en-IN')), datasets: [{ data, borderColor: data.map(v => v >= 0 ? 'rgba(24,212,144,1)' : 'rgba(240,48,80,1)'), backgroundColor: data.map(v => v >= 0 ? 'rgba(24,212,144,.15)' : 'rgba(240,48,80,.1)'), fill: true, tension: 0, pointRadius: 0, borderWidth: 2, segment: { borderColor: ctx => ctx.p0.parsed.y >= 0 ? 'rgba(24,212,144,1)' : 'rgba(240,48,80,1)' } }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => `P&L: ₹${c.parsed.y}` } } }, scales: { y: { ticks: { callback: v => `₹${v}`, font: { size: 9 }, color: 'rgba(255,255,255,.3)' }, grid: { color: 'rgba(255,255,255,.04)', zeroLineColor: 'rgba(255,255,255,.3)' } }, x: { ticks: { font: { size: 9 }, color: 'rgba(255,255,255,.3)', maxRotation: 0 }, grid: { display: false } } } }
      });
    }

    /* ════════════════════════════════════════════════════════════════════════
       WATCHLIST — dynamic from API
       ════════════════════════════════════════════════════════════════════════ */
    async function loadWatchlistDynamic() {
      try {
        const d = await (await _v2api('/watchlist')).json();
        const wl = d.watchlist || [];
        if (!wl.length) return; // Keep static data if API returns empty

        const COLS = { 1: 'var(--gr)', 2: 'var(--bl)', 3: 'var(--am)' };
        function tier(score) { return score >= 80 ? 1 : score >= 65 ? 2 : 3; }

        function card(s) {
          const t = tier(s.score);
          const col = COLS[t];
          return `<div style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:13px;border-top:2px solid ${col};position:relative">
          <button onclick="delWatchlist('${s.ticker}')" style="position:absolute;top:8px;right:8px;background:none;border:none;color:var(--t3);cursor:pointer;font-size:12px;padding:2px 6px" title="Remove">✕</button>
          <div style="font-size:14px;font-weight:700;margin-bottom:2px">${s.ticker}</div>
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:8px">${s.sector || '—'} · Score <span style="color:${col};font-weight:700">${s.score}/100</span></div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-bottom:8px">
            <div style="background:var(--s2);border-radius:5px;padding:5px 7px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">ROCE</div><div style="font-size:12px;font-weight:700;color:${(s.roce || 0) >= 28 ? 'var(--gr)' : 'var(--am)'}">${s.roce || '—'}%</div></div>
            <div style="background:var(--s2);border-radius:5px;padding:5px 7px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">D/E</div><div style="font-size:12px;font-weight:700;color:${(s.de || 0) <= 0.3 ? 'var(--gr)' : 'var(--am)'}">${s.de || '—'}</div></div>
            <div style="background:var(--s2);border-radius:5px;padding:5px 7px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">Rev CAGR</div><div style="font-size:12px;font-weight:700;color:var(--bl)">${s.rev_cagr || '—'}%</div></div>
            <div style="background:var(--s2);border-radius:5px;padding:5px 7px"><div style="font-size:9px;color:var(--t3);font-family:var(--mono)">Score</div><div style="font-size:12px;font-weight:700;color:${col}">${s.score}</div></div>
          </div>
          <div style="font-size:11px;color:var(--t2);margin-bottom:6px;line-height:1.4">${s.thesis || '—'}</div>
          <div style="font-size:10px;padding:3px 8px;border-radius:4px;background:var(--s2);color:var(--t3);font-family:var(--mono);display:inline-block">🎯 ${s.entry_trigger || '—'}</div>
        </div>`;
        }

        // Add "+ Add to watchlist" button + show watchlist from API
        const wlPage = document.getElementById('watchlist');
        if (wlPage) {
          const addBtn = document.getElementById('wlAddBtn');
          if (!addBtn) {
            const btn = document.createElement('div');
            btn.id = 'wlAddBtn';
            btn.style.cssText = 'margin-bottom:12px;display:flex;justify-content:space-between;align-items:center';
            btn.innerHTML = `<div style="font-size:12px;color:var(--t2)">${wl.length} stocks on your watchlist · <span style="color:var(--gr)">Source: Live from database</span></div><button onclick="showAddWatchlist()" style="padding:7px 14px;border-radius:var(--r2);border:none;background:var(--bl);color:#fff;font-size:12px;font-weight:600;cursor:pointer;font-family:'Space Grotesk',sans-serif">+ Add stock</button>`;
            const wlGrid = document.getElementById('wlGrid');
            if (wlGrid) wlGrid.before(btn);
          }
          // Rebuild wlGrid
          const wlGrid = document.getElementById('wlGrid');
          if (wlGrid) {
            const t1 = wl.filter(s => tier(s.score) === 1);
            const t2 = wl.filter(s => tier(s.score) === 2);
            const t3 = wl.filter(s => tier(s.score) === 3);
            wlGrid.innerHTML = `
            ${t1.length ? `<div class="sh" style="margin-top:0">Tier 1 — Entry signal (score ≥80)</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">${t1.map(card).join('')}</div>` : ''}
            ${t2.length ? `<div class="sh">Tier 2 — Monitor (score 65–79)</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">${t2.map(card).join('')}</div>` : ''}
            ${t3.length ? `<div class="sh">Tier 3 — Emerging (score &lt;65)</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">${t3.map(card).join('')}</div>` : ''}`;
          }
        }
      } catch (e) { console.warn('Watchlist API error:', e.message); }
    }

    async function delWatchlist(ticker) {
      if (!confirm(`Remove ${ticker} from watchlist?`)) return;
      try { await _v2api(`/watchlist/${ticker}`, { method: 'DELETE' }); loadWatchlistDynamic(); }
      catch (e) { alert('Remove failed: ' + e.message); }
    }

    function showAddWatchlist() {
      const ticker = prompt('Enter ticker symbol (e.g. KAYNES):');
      if (!ticker) return;
      const score = parseInt(prompt('ASOS score 0-100:') || '70');
      const sector = prompt('Sector:') || '';
      const thesis = prompt('Investment thesis:') || '';
      _v2api('/watchlist', { method: 'POST', body: JSON.stringify({ ticker: ticker.toUpperCase(), score, sector, thesis, entry_trigger: 'See analysis' }) })
        .then(() => loadWatchlistDynamic())
        .catch(e => alert('Add failed: ' + e.message));
    }

    /* ════════════════════════════════════════════════════════════════════════
       TRADING MONITOR — live positions
       ════════════════════════════════════════════════════════════════════════ */
    async function loadLivePositions() {
      const H = {'Authorization':'Bearer '+localStorage.getItem('asos_token')};
      const fmt = n => '₹'+Math.round(n||0).toLocaleString('en-IN');
      try {
        const [posD, calD] = await Promise.all([
          fetch('http://localhost:8000/income/positions',{headers:H}).then(r=>r.json()),
          fetch('http://localhost:8000/income/calibration',{headers:H}).then(r=>r.json()).catch(()=>({})),
        ]);
        // metrics
        const setTxt=(id,v,c)=>{const e=document.getElementById(id); if(e){e.textContent=v; if(c)e.style.color=c;}};
        const mtd = posD.mtd_income || 0;
        setTxt('monMtd', (mtd>=0?'+':'')+fmt(mtd), mtd>=0?'var(--gr)':'var(--re)');
        setTxt('monOpen', (posD.open_count||0)+' / 3 max', 'var(--bl)');
        setTxt('monCapital', fmt(posD.capital_at_risk||0), 'var(--am)');
        const wr = calD.overall_win_rate!=null ? calD.overall_win_rate+'%' : (posD.mtd_closed?'—':'no data');
        setTxt('monWin', wr, 'var(--gr)');
        // positions table
        const tb = document.getElementById('monPositions');
        const open = posD.positions || posD.open || [];
        if (!open.length) {
          tb.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--t3);padding:20px;font-size:12px">No open positions. Deploy from Options Chain / Trade Builder when IVR≥50.</td></tr>';
          return;
        }
        tb.innerHTML = open.map(p => {
          const pnl = p.pnl!=null ? p.pnl : (p.net_pnl||0);
          const pnlPct = p.pnl_pct!=null ? p.pnl_pct : 0;
          const col = pnl>=0 ? 'var(--gr)' : 'var(--re)';
          const idxCls = (p.idx==='NIFTY')?'bx-b':(p.idx==='BANKNIFTY')?'bx-a':'bx-p';
          const trig = (p.triggers && p.triggers.length) ? p.triggers[0].action : (p.status||'Running');
          const trigCol = (p.triggers && p.triggers.length) ? 'bx-a' : 'bx-g';
          return `<tr>
            <td><span class="bx ${idxCls}">${p.idx||p.index||'—'}</span></td>
            <td style="font-size:11px">${p.structure||'IC'} · DTE ${p.dte!=null?p.dte:'—'}${p.mode==='PAPER'?' · <span style="color:var(--am)">PAPER</span>':''}</td>
            <td class="mono">${fmt(p.credit_received||p.credit||0)}</td>
            <td class="mono" style="color:${col}">${fmt(pnl)}</td>
            <td class="mono" style="color:${col}">${pnlPct>=0?'+':''}${pnlPct}%</td>
            <td><span class="bx ${trigCol}">${trig}</span></td>
          </tr>`;
        }).join('');
      } catch (e) {
        const tb = document.getElementById('monPositions');
        if (tb) tb.innerHTML = '<tr><td colspan="6" style="color:var(--re);padding:12px;font-size:12px">Positions unavailable — income engine may need reconnect</td></tr>';
      }
    }

    /* ════════════════════════════════════════════════════════════════════════
       SETTINGS — add withdrawal/pending fields
       ════════════════════════════════════════════════════════════════════════ */
    function injectWithdrawalUI() {
      const page = document.getElementById('settings');
      if (!page || document.getElementById('withdrawalCard')) return;
      const card = document.createElement('div');
      card.id = 'withdrawalCard'; card.className = 'card'; card.style.marginBottom = '12px';
      card.innerHTML = `
      <div style="font-size:13px;font-weight:700;margin-bottom:10px">💸 Corpus adjustments</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
        <div>
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Withdrawal amount (₹)</div>
          <input id="w-withdrawal" type="number" placeholder="850000" value="0"
            style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none">
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-top:3px">Amount you withdrew (e.g. enter 858000 for ₹8.58L)</div>
        </div>
        <div>
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Pending credit T+1 (₹)</div>
          <input id="w-pending" type="number" placeholder="0" value="0"
            style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none">
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-top:3px">Sell proceeds not yet credited</div>
        </div>
      </div>
      <div style="background:var(--s2);border-radius:var(--r);padding:8px 12px;font-size:11px;color:var(--t2);margin-bottom:10px">
        Effective corpus = Holdings value − Withdrawal + Pending T+1. This is used for all Core 22 allocation calculations.
      </div>
      <button onclick="saveCorpusAdj()" style="padding:9px 20px;border-radius:var(--r2);border:none;background:linear-gradient(135deg,#4080ff,#00b8e0);color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">Save corpus adjustment</button>
      <span id="corpAdjMsg" style="font-size:11px;margin-left:10px;color:var(--gr)"></span>
    `;
      // Insert after the first card in settings (API config card)
      const firstCard = page.querySelector('.card');
      if (firstCard) firstCard.after(card);
      else page.insertBefore(card, page.firstChild);
      // Load existing values
      _v2api('/settings').then(r => r.json()).then(d => {
        const wi = document.getElementById('w-withdrawal');
        const pi = document.getElementById('w-pending');
        if (wi) wi.value = d.withdrawal_amount || 0;
        if (pi) pi.value = d.pending_credit || 0;
      }).catch(() => { });
    }

    async function saveCorpusAdj() {
      const w = parseFloat(document.getElementById('w-withdrawal')?.value || 0);
      const p = parseFloat(document.getElementById('w-pending')?.value || 0);
      try {
        // Load current settings first, then update
        const cur = await (await _v2api('/settings')).json();
        await _v2api('/settings', { method: 'POST', body: JSON.stringify({ ...cur, withdrawal_amount: w, pending_credit: p }) });
        const msg = document.getElementById('corpAdjMsg');
        if (msg) { msg.textContent = '✓ Saved'; setTimeout(() => msg.textContent = '', 2000); }
      } catch (e) { alert('Save failed: ' + e.message); }
    }

    /* ════════════════════════════════════════════════════════════════════════
       LIVE STRATEGY SELECTOR — update from real API
       ════════════════════════════════════════════════════════════════════════ */
    async function updateStrategyFromAPI() {
      const H = {'Authorization':'Bearer '+localStorage.getItem('asos_token')};
      try {
        // Real data: regime + all arms + entry gate
        const [reg, armsD, gate] = await Promise.all([
          fetch('http://localhost:8000/income/regime?index=NIFTY',{headers:H}).then(r=>r.json()),
          fetch('http://localhost:8000/income/arms',{headers:H}).then(r=>r.json()).catch(()=>({arms:[]})),
          fetch('http://localhost:8000/income/entry-gate?arm=A1&index=NIFTY',{headers:H}).then(r=>r.json()).catch(()=>({})),
        ]);
        const f = reg.features || {};
        const setTxt = (id,v)=>{const e=document.getElementById(id); if(e) e.textContent=v;};
        setTxt('sVix', (f.vix||0).toFixed ? (f.vix||0).toFixed(1) : f.vix);
        setTxt('sIvp', Math.round(f.ivr||0));
        setTxt('sAdx', (f.adx||0).toFixed ? (f.adx||0).toFixed(1) : f.adx);
        // Pull the Strategy Matrix verdict (the document's brain)
        let matrix = null;
        try { matrix = await fetch('http://localhost:8000/matrix/analyze?index=NIFTY',{headers:H}).then(r=>r.json()); } catch(e){}
        renderRealStrategies(reg, armsD.arms || [], gate, matrix);
      } catch (e) {
        const el = document.getElementById('stratCards');
        if (el) el.innerHTML = '<div style="color:var(--re);padding:12px;font-size:12px">Strategy engine unavailable — reconnect Zerodha</div>';
      }
    }

    function renderRealStrategies(reg, arms, gate, matrix) {
      const el = document.getElementById('stratCards');
      if (!el) return;
      const regime = reg.regime;
      const ivr = (reg.features||{}).ivr || 0;
      // MATRIX VERDICT banner (from the strategy document)
      let matrixBanner = '';
      if (matrix && !matrix.error) {
        const act = matrix.activated;
        const mc = act ? 'var(--gr)' : 'var(--am)';
        const ind = matrix.indicators || {};
        matrixBanner = `<div style="background:var(--s1);border:1px solid ${mc};border-radius:var(--r2);padding:14px 16px;margin-bottom:14px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px">
            <span style="font-size:10px;font-family:var(--mono);color:var(--t3);text-transform:uppercase">📋 Strategy Matrix says</span>
            <span style="font-size:15px;font-weight:800;color:${mc}">${matrix.strategy}</span>
            <span style="font-size:11px;color:var(--t3)">${matrix.condition.replace(/_/g,' ')} · ${matrix.dte_band} DTE</span>
            <span style="margin-left:auto;font-size:12px;font-weight:700;padding:4px 12px;border-radius:6px;background:${act?'rgba(24,212,144,.12)':'rgba(240,160,0,.12)'};color:${mc}">
              ${act?'✓ '+matrix.allocation.action:'⏸ '+matrix.verdict.split('—')[0]}</span>
          </div>
          <div style="display:flex;gap:14px;flex-wrap:wrap;font-family:var(--mono);font-size:10px;color:var(--t2)">
            <span>EMA20 ${ind.ema20} ${ind.ema_bull?'>':'<'} EMA50 ${ind.ema50}</span>
            <span>price ${ind.above_vwap?'above':'below'} VWAP ${ind.vwap}</span>
            <span>ADX ${ind.adx}</span>
            <span>VIX ${matrix.vix} · IVR ${matrix.ivr} · PCR ${matrix.pcr}</span>
            <span style="color:${mc}">confidence ${matrix.confidence}/${matrix.confidence_req}</span>
          </div>
          ${matrix.activated?`<div style="margin-top:8px"><button onclick="go('tradebuilder');setTimeout(()=>{if(window.tbBuildRecommended)tbBuildRecommended();},400)" style="padding:8px 16px;border-radius:8px;border:none;background:linear-gradient(135deg,#18d490,#0a9d68);color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">🎯 Build this trade →</button></div>`:''}
        </div>`;
      }
      // Regime banner at top
      const RC = {'VOL_EXPANSION':'var(--re)','TREND_UP':'var(--gr)','TREND_DOWN':'var(--re)','VOL_COMPRESSION':'var(--am)','RANGE':'var(--bl)'};
      const rc = RC[regime]||'var(--t2)';
      let banner = `<div style="background:var(--s1);border:1px solid var(--b1);border-left:3px solid ${rc};border-radius:var(--r2);padding:12px 16px;margin-bottom:14px;display:flex;align-items:center;gap:16px;flex-wrap:wrap">
        <div><div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase">Live regime</div>
        <div style="font-size:15px;font-weight:700;color:${rc}">${regime} · ${Math.round(reg.confidence)}%</div></div>
        <div style="flex:1;min-width:200px;border-left:1px solid var(--b1);padding-left:16px">
          <div style="font-size:11px;color:var(--t3)">${reg.why||''}</div>
          <div style="font-size:11px;color:var(--am);margin-top:2px">→ ${reg.intent||''}</div></div>
        <div style="font-family:var(--mono);font-size:11px;padding:6px 12px;border-radius:6px;background:${gate.allowed?'rgba(24,212,144,.1)':'rgba(240,48,80,.1)'};color:${gate.allowed?'var(--gr)':'var(--re)'}">
          IVR ${Math.round(ivr)} · A1 gate ${gate.allowed?'CLEAR':'BLOCKED'}</div></div>`;

      // Arms: sort by regime match + status
      const armList = arms.length ? arms : [];
      if (!armList.length) { el.innerHTML = banner + '<div style="color:var(--t3);padding:12px;font-size:12px">No strategy arms configured.</div>'; return; }
      // score each: regime match = armed, else shadow
      const scored = armList.map(a => {
        const matches = (a.regime === regime || a.regime === 'ANY');
        const isLive = a.status === 'LIVE';
        // gate check for A1-type: IVR requirement
        const ivrReq = (a.params && a.params.entry_ivr_min) || 0;
        const ivrOK = ivr >= ivrReq;
        let state, col;
        if (matches && isLive && ivrOK) { state='ARMED — deploy ready'; col='var(--gr)'; }
        else if (matches && isLive && !ivrOK) { state=`BLOCKED — IVR ${Math.round(ivr)}<${ivrReq}`; col='var(--am)'; }
        else if (matches) { state='SHADOW — logging only'; col='var(--bl)'; }
        else { state='OFF — wrong regime'; col='var(--t3)'; }
        return {...a, matches, isLive, ivrOK, state, col, rank:(matches?2:0)+(ivrOK?1:0)};
      }).sort((a,b)=>b.rank-a.rank);

      el.innerHTML = matrixBanner + banner + '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">' + scored.map(a => {
        const dim = a.matches ? '' : 'opacity:.5';
        return `<div style="background:var(--s1);border:1px solid ${a.col==='var(--gr)'?'var(--gr)':'var(--b1)'};border-radius:var(--r2);padding:13px;${dim}">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2px">
            <span style="font-size:13px;font-weight:700">${a.name||a.code}</span>
            ${a.col==='var(--gr)'?'<span style="font-size:9px;font-family:var(--mono);padding:2px 7px;border-radius:4px;background:rgba(24,212,144,.15);color:var(--gr)">DEPLOY</span>':''}
          </div>
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:8px">${a.code} · wants ${a.regime}</div>
          <div style="font-size:11px;font-family:var(--mono);color:${a.col}">${a.state}</div>
        </div>`;
      }).join('') + '</div>';
    }

    /* ════════════════════════════════════════════════════════════════════════
       HOOK INTO EXISTING go() FOR NEW PAGES
       ════════════════════════════════════════════════════════════════════════ */
    // Also hook settings to inject withdrawal UI
    const _v2BaseGo = window.go;
    window.go = function (id, el) {
      if (_v2BaseGo) _v2BaseGo(id, el);
      if (id === 'holdings') setTimeout(loadHoldingsPage, 120);
      if (id === 'core22gap') setTimeout(loadCore22Gap, 120);
      if (id === 'optionschain') setTimeout(() => loadOC(), 200);

      if (id === 'settings') setTimeout(() => { injectWithdrawalUI(); }, 150);
      if (id === 'strategies') setTimeout(updateStrategyFromAPI, 200);
      if (id === 'monitor') setTimeout(loadLivePositions, 200);
      if (id === 'tradebuilder') setTimeout(tbLoadMarket, 200);
    };

    /* ── Helpers ────────────────────────────────────────────────────────── */
    function _v2spin(msg) {
      return `<div style="text-align:center;padding:24px;color:var(--t3);font-size:12px">
      <div style="width:16px;height:16px;border:2px solid var(--b2);border-top-color:var(--bl);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 8px"></div>
      ${msg}</div>`;
    }

    /* ── Auto-start ────────────────────────────────────────────────────── */
    // Load dashboard data when page is already on dashboard
    if (document.getElementById('dashboard')?.classList.contains('on')) {
      setTimeout(() => { loadWatchlistDynamic(); }, 2000);
    }

    console.log('✅ ASOS Platform v2 — Holdings · Gap Analysis · Options Chain · Live Watchlist ready');
  </script>


  <!-- ASOS Timing Engine JS + Transition Plan dynamic updates -->
  <script>
    const _TE_API = 'http://localhost:8000';
    const _tetok = () => localStorage.getItem('asos_token');

    async function _teapi(path, opts = {}) {
      const r = await fetch(_TE_API + path, {
        ...opts,
        headers: { 'Authorization': `Bearer ${_tetok()}`, 'Content-Type': 'application/json', ...(opts.headers || {}) }
      });
      return r;
    }

    /* ════ TIMING ENGINE ════════════════════════════════════════════════════ */
    let _timingData = null;

    async function loadTimingEngine(force = false) {
      if (_timingData && !force) { renderTiming(_timingData); return; }

      // Show loading state
      const sg = document.getElementById('timingSignalsGrid');
      if (sg) sg.innerHTML = `<div style="text-align:center;padding:24px;color:var(--t3);font-size:12px">
      <div style="width:16px;height:16px;border:2px solid var(--b2);border-top-color:var(--bl);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 8px"></div>
      Fetching RSI + 52-week data for all Core 22 positions… (15–30 seconds)</div>`;

      try {
        const r = await _teapi('/market/timing-engine');
        if (!r.ok) throw new Error(await r.text());
        const d = await r.json();
        _timingData = d;
        renderTiming(d);
      } catch (e) {
        const sg2 = document.getElementById('timingSignalsGrid');
        if (sg2) sg2.innerHTML = `<div style="color:var(--re);padding:12px;font-size:12px">Error loading signals: ${e.message}</div>`;
      }
    }

    function renderTiming(d) {
      /* Market context bar */
      const ctx = document.getElementById('timingContextBar');
      if (ctx) {
        const niftyCol = d.nifty_dma_gap > 2 ? 'var(--gr)' : d.nifty_dma_gap < -2 ? 'var(--re)' : 'var(--am)';
        const rsiCol = d.nifty_rsi < 40 ? 'var(--gr)' : d.nifty_rsi > 65 ? 'var(--re)' : 'var(--am)';
        ctx.innerHTML = `
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px">
          <div style="text-align:center"><div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">INDIA VIX</div>
            <div style="font-size:20px;font-weight:700;color:${d.vix < 15 ? 'var(--gr)' : d.vix < 20 ? 'var(--am)' : 'var(--re)'}">${d.vix}</div>
            <div style="font-size:10px;color:var(--t3)">${d.vix < 13 ? 'Complacent' : d.vix < 16 ? 'Normal' : d.vix < 20 ? 'Elevated' : 'Fear'}</div></div>
          <div style="text-align:center"><div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">IVP</div>
            <div style="font-size:20px;font-weight:700;color:var(--am)">${d.ivp}%</div>
            <div style="font-size:10px;color:var(--t3)">IV Percentile</div></div>
          <div style="text-align:center"><div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">NIFTY RSI</div>
            <div style="font-size:20px;font-weight:700;color:${rsiCol}">${d.nifty_rsi?.toFixed(1) || '—'}</div>
            <div style="font-size:10px;color:var(--t3)">${d.nifty_rsi < 40 ? 'Oversold — opportunity' : d.nifty_rsi > 65 ? 'Overbought — caution' : 'Neutral'}</div></div>
          <div style="text-align:center"><div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">NIFTY PHASE</div>
            <div style="font-size:12px;font-weight:600;color:${niftyCol};margin-top:4px">${d.nifty_phase}</div>
            <div style="font-size:10px;color:var(--t3)">vs 200 DMA ${d.nifty_dma_gap >= 0 ? '+' : ''}${d.nifty_dma_gap?.toFixed(1) || 0}%</div></div>
          <div style="text-align:center"><div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:3px">CORPUS</div>
            <div style="font-size:20px;font-weight:700;color:var(--bl)">₹${((d.effective_corpus || 0) / 1e5).toFixed(1)}L</div>
            <div style="font-size:10px;color:var(--t3)">Effective (post-withdrawal)</div></div>
        </div>`;
      }

      /* SIP guidance bar */
      const sip = document.getElementById('timingSipBar');
      if (sip) {
        sip.style.borderLeft = `3px solid ${d.sip_color}`;
        sip.innerHTML = `
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <div style="font-size:18px;font-weight:800;color:${d.sip_color};min-width:130px">${d.sip_mode}</div>
          <div style="flex:1;font-size:12px;color:var(--t2);line-height:1.5">${d.sip_reason}</div>
          <div style="font-size:11px;padding:5px 12px;border-radius:var(--r2);background:${d.sip_color + '20'};border:1px solid ${d.sip_color + '50'};color:${d.sip_color};font-weight:600;font-family:var(--mono);white-space:nowrap">${new Date(d.timestamp).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: false })} IST</div>
        </div>`;
      }

      /* Action summary */
      const setMb = (id, val, col) => { const b = document.getElementById(id); if (b) { b.querySelector('.mb-v').textContent = val; b.querySelector('.mb-v').style.color = col; } };
      setMb('ta-trim', d.trim_count || 0, 'var(--re)');
      setMb('ta-add', d.add_count || 0, 'var(--gr)');
      setMb('ta-proceeds', `₹${((d.trim_proceeds_est || 0) / 1e5).toFixed(1)}L`, 'var(--am)');
      setMb('ta-nrsi', `${(d.nifty_rsi || 0).toFixed(1)}`, (d.nifty_rsi || 50) < 40 ? 'var(--gr)' : (d.nifty_rsi || 50) > 65 ? 'var(--re)' : 'var(--am)');

      /* ETF signals */
      const eff = document.getElementById('timingEtfGrid');
      if (eff && d.etf_signals?.length) {
        eff.innerHTML = d.etf_signals.map(s => `
        <div style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:12px;border-left:2px solid ${s.color}">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
            <div style="font-size:13px;font-weight:700">${s.ticker}</div>
            <span style="font-size:10px;padding:2px 8px;border-radius:4px;background:${s.color + '22'};color:${s.color};border:1px solid ${s.color + '44'};font-family:var(--mono);font-weight:600">${s.signal}</span>
          </div>
          <div style="font-size:11px;color:var(--t2);margin-bottom:4px">${s.action}</div>
          <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--t3);font-family:var(--mono)">
            <span>Target: ${s.target_pct}%</span><span>Current: ${s.current_pct?.toFixed(1) || 0}%</span>
          </div>
        </div>`).join('');
      }

      /* Equity signals */
      const sg = document.getElementById('timingSignalsGrid');
      if (!sg || !d.signals?.length) return;

      const priorityLabels = { 1: '🚨 Act Now', 2: '📋 This Week', 3: '👁 Watch', 4: '✓ On track', 5: '⚠ No data' };
      const byPriority = {};
      d.signals.forEach(s => { (byPriority[s.priority] || (byPriority[s.priority] = [])).push(s); });

      sg.innerHTML = Object.entries(byPriority).sort(([a], [b]) => a - b).map(([pri, stocks]) => `
      <div style="margin-bottom:16px">
        <div style="font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;display:flex;align-items:center;gap:8px;font-family:var(--mono)">
          ${priorityLabels[pri] || pri} <span style="flex:1;height:1px;background:var(--b1);display:block"></span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px">
          ${stocks.map(s => {
        const hasData = s.signal !== 'DATA N/A' && s.price > 0;
        const rsiBar = hasData ? Math.round(s.rsi) : 50;
        const rsiCol = s.rsi < 35 ? 'var(--gr)' : s.rsi > 65 ? 'var(--re)' : 'var(--am)';
        const highBar = hasData ? Math.max(0, Math.round((1 + (s.pct_from_high / 100)) * 100)) : 50;
        const lowPct = hasData ? Math.min(100, Math.round((s.pct_from_low / 100) * 100)) : 50;
        return `
            <div style="background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:13px;border-left:3px solid ${s.color}">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px">
                <div>
                  <div style="font-size:14px;font-weight:700">${s.ticker}</div>
                  <div style="font-size:11px;color:var(--t2)">${hasData ? '₹' + s.price.toLocaleString('en-IN') : '—'}</div>
                </div>
                <span style="font-size:11px;padding:3px 9px;border-radius:5px;background:${s.color + '18'};color:${s.color};border:1px solid ${s.color + '40'};font-family:var(--mono);font-weight:700;white-space:nowrap">${s.signal}</span>
              </div>

              ${hasData ? `
              <!-- RSI bar -->
              <div style="margin-bottom:6px">
                <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--t3);font-family:var(--mono);margin-bottom:2px">
                  <span>RSI(14)</span><span style="color:${rsiCol};font-weight:600">${s.rsi?.toFixed(1) || '—'}</span>
                </div>
                <div style="height:4px;background:var(--s3);border-radius:99px;overflow:hidden;position:relative">
                  <div style="position:absolute;left:0;top:0;height:100%;width:30%;background:rgba(24,212,144,.3)"></div>
                  <div style="position:absolute;left:65%;top:0;height:100%;right:0;background:rgba(240,48,80,.3)"></div>
                  <div style="position:absolute;left:${rsiBar}%;top:-1px;width:3px;height:6px;background:${rsiCol};border-radius:2px;transform:translateX(-50%)"></div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--t3);font-family:var(--mono)"><span>Oversold 30</span><span>Neutral 50</span><span>70 Overbought</span></div>
              </div>

              <!-- 52-week bar -->
              <div style="margin-bottom:8px">
                <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--t3);font-family:var(--mono);margin-bottom:2px">
                  <span>52-week range</span>
                  <span>${s.pct_from_high?.toFixed(1) || 0}% from high · +${s.pct_from_low?.toFixed(1) || 0}% from low</span>
                </div>
                <div style="height:4px;background:var(--s3);border-radius:99px;overflow:hidden;position:relative">
                  <div style="position:absolute;left:0;top:0;height:100%;width:${Math.min(highBar, 100)}%;background:linear-gradient(90deg,var(--re),var(--am),var(--gr))"></div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--t3);font-family:var(--mono)"><span>52wk Low ₹${(s.low52 || 0).toLocaleString('en-IN')}</span><span>₹${(s.high52 || 0).toLocaleString('en-IN')} High</span></div>
              </div>

              <!-- Weight bar -->
              <div style="margin-bottom:8px">
                <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--t3);font-family:var(--mono);margin-bottom:2px">
                  <span>Portfolio weight</span>
                  <span style="color:${Math.abs((s.wt_ratio || 1) - 1) < 0.1 ? 'var(--gr)' : s.wt_ratio > 1.15 ? 'var(--re)' : 'var(--am)'}">${s.current_pct?.toFixed(1) || 0}% actual vs ${s.target_pct}% target</span>
                </div>
                <div style="height:4px;background:var(--s3);border-radius:99px;overflow:hidden;position:relative">
                  <div style="position:absolute;left:0;top:0;height:100%;width:${Math.min(100, Math.round((s.target_pct || 5) / 15 * 100))}%;background:rgba(64,128,255,.3);border-right:1px dashed rgba(64,128,255,.6)"></div>
                  <div style="position:absolute;left:0;top:0;height:100%;width:${Math.min(100, Math.round((s.current_pct || 0) / 15 * 100))}%;background:${s.wt_ratio > 1.15 ? 'rgba(240,48,80,.6)' : s.wt_ratio < 0.85 ? 'rgba(64,128,255,.6)' : 'rgba(24,212,144,.6)'}"></div>
                </div>
              </div>` : ''}

              <!-- Action -->
              <div style="font-size:11px;color:var(--t2);line-height:1.4;margin-bottom:${s.sip_note ? '4px' : '0'}">${s.action}</div>
              ${s.sip_note ? `<div style="font-size:10px;padding:3px 8px;border-radius:4px;background:rgba(240,160,0,.08);color:var(--am);border:1px solid rgba(240,160,0,.25);margin-top:4px;font-family:var(--mono)">${s.sip_note}</div>` : ''}
              ${s.trim_pct && s.price > 0 ? `
              <div style="margin-top:6px;padding:6px 10px;background:rgba(240,48,80,.06);border:1px solid rgba(240,48,80,.2);border-radius:6px;font-size:11px;color:var(--re);font-family:var(--mono)">
                → Trim ${s.trim_pct}% of position at current price ₹${s.price.toLocaleString('en-IN')}
              </div>` : ''}
              ${s.signal === 'STRONG ADD' || s.signal === 'ADD' ? `
              <div style="margin-top:6px;padding:6px 10px;background:rgba(24,212,144,.06);border:1px solid rgba(24,212,144,.2);border-radius:6px;font-size:11px;color:var(--gr);font-family:var(--mono)">
                → ${s.signal === 'STRONG ADD' ? 'Deploy 2× SIP' : 'Add SIP'} at ₹${s.price.toLocaleString('en-IN')}
              </div>` : ''}
            </div>`;
      }).join('')}
        </div>
      </div>`).join('');
    }

    /* ════ Hook go() for timing page ═══════════════════════════════════════ */
    const _teBaseGo = window.go;
    window.go = function (id, el) {
      if (_teBaseGo) _teBaseGo(id, el);
      if (id === 'timing') setTimeout(() => loadTimingEngine(false), 100);
    };

    /* Auto-load timing data if on dashboard (background) */
    setTimeout(() => {
      if (document.getElementById('timing')?.classList.contains('on')) loadTimingEngine();
    }, 3000);

    console.log('✅ Timing Engine + Options Chain fix loaded');
  </script>


  <!-- GLM 5.2 Settings injection + status check -->
  <script>
    (function () {
      /* ── Check GLM status on load ─────────────────────────────────────── */
      async function checkGlmStatus() {
        const tok = localStorage.getItem('asos_token');
        if (!tok) return;
        try {
          const r = await fetch('http://localhost:8000/ai/status', {
            headers: { 'Authorization': `Bearer ${tok}` }
          });
          const d = await r.json();
          const badge = document.getElementById('glmStatusBadge');
          if (badge) {
            if (d.working) {
              badge.textContent = '✓ GLM 5.2 connected · ' + (d.cost_so_far || '$0.00');
              badge.style.color = 'var(--gr)';
            } else if (d.configured) {
              badge.textContent = '⚠ Key set but not working — check key';
              badge.style.color = 'var(--re)';
            } else {
              badge.textContent = '⚠ API key not set';
              badge.style.color = 'var(--am)';
            }
          }
        } catch (e) { }
      }

      /* ── Inject GLM key field into Settings page ──────────────────────── */
      function injectGlmSettingsField() {
        const page = document.getElementById('settings');
        if (!page || document.getElementById('glmKeyCard')) return;

        const card = document.createElement('div');
        card.id = 'glmKeyCard';
        card.className = 'card';
        card.style.marginBottom = '12px';
        card.innerHTML = `
        <div style="font-size:13px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:8px">
          🤖 GLM 5.2 AI Scout (Fireworks AI)
          <span id="glmStatusBadge" style="font-size:10px;padding:2px 8px;border-radius:4px;font-family:var(--mono);background:var(--s2);color:var(--t3)">Checking…</span>
        </div>
        <div style="font-size:11px;color:var(--t3);font-family:var(--mono);line-height:1.7;margin-bottom:10px">
          Your key from <a href="https://fireworks.ai" target="_blank" style="color:var(--bl)">fireworks.ai</a> (starts with <code style="background:var(--s2);padding:1px 5px;border-radius:3px;color:var(--am)">fw_</code>)
          · GLM 5.2 · $1.40/M input · 1M context · $6 credits ≈ 14 months
        </div>
        <div style="margin-bottom:10px">
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Fireworks API Key</div>
          <input id="glmKeyInput" type="password" placeholder="fw_xxxxxxxxxxxxxxxxxxxx"
            style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none">
        </div>
        <div style="display:flex;gap:8px">
          <button onclick="saveGlmKey()" style="flex:1;padding:10px;border-radius:10px;border:none;background:linear-gradient(135deg,#185FA5,#0F6E56);color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">Save GLM API key</button>
          <button onclick="testGlmKey()" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(24,212,144,.4);background:rgba(24,212,144,.08);color:var(--gr);font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">Test connection →</button>
        </div>
        <div id="glmKeyMsg" style="display:none;margin-top:8px;padding:8px 12px;border-radius:6px;font-size:12px"></div>

        <div style="margin-top:12px;background:var(--s2);border-radius:8px;padding:10px 12px;font-size:11px;color:var(--t2);line-height:1.7">
          <strong style="color:var(--tx)">Your key:</strong> fireworks.ai → Settings → API Keys (you already have one: fw_Pgh9…)<br>
          Paste above → Save → Test. Uses model accounts/fireworks/models/glm-5p2.<br>
          <strong style="color:var(--tx)">When credits run out:</strong> switch to Claude Haiku / DeepSeek via the Orchestrator — no code change needed
        </div>
      `;

        /* Insert after Zerodha card if present, else at top */
        const kiteCard = document.getElementById('_kCard') || document.getElementById('kiteCard');
        const withdrawCard = document.getElementById('withdrawalCard');
        const refCard = withdrawCard || kiteCard;
        if (refCard && refCard.nextSibling) {
          refCard.parentNode.insertBefore(card, refCard.nextSibling);
        } else {
          page.insertBefore(card, page.firstChild);
        }
        checkGlmStatus();
      }

      async function saveGlmKey() {
        const key = document.getElementById('glmKeyInput')?.value.trim();
        if (!key) { glmMsg('Enter your Z.ai API key first.', 'err'); return; }
        const tok = localStorage.getItem('asos_token');
        try {
          const cur = await (await fetch('http://localhost:8000/settings', { headers: { 'Authorization': `Bearer ${tok}` } })).json();
          const r = await fetch('http://localhost:8000/settings', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${tok}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...cur, glm_api_key: key, ai_provider: 'glm' })
          });
          const d = await r.json();
          glmMsg('✓ GLM API key saved. Click Test to verify.', 'ok');
          document.getElementById('glmKeyInput').value = '';
        } catch (e) { glmMsg('Save failed — is server running?', 'err'); }
      }

      async function testGlmKey() {
        glmMsg('Testing connection to GLM 5.2…', 'info');
        const tok = localStorage.getItem('asos_token');
        try {
          const r = await fetch('http://localhost:8000/ai/status', {
            headers: { 'Authorization': `Bearer ${tok}` }
          });
          const d = await r.json();
          if (d.working) {
            glmMsg(`✓ GLM 5.2 connected! Model: ${d.model} · Provider: ${d.provider} · Total tokens used: ${d.total_tokens.toLocaleString('en-IN')}`, 'ok');
            const badge = document.getElementById('glmStatusBadge');
            if (badge) { badge.textContent = '✓ Connected'; badge.style.color = 'var(--gr)'; }
          } else {
            glmMsg(d.message || 'Connection failed — check your API key.', 'err');
          }
        } catch (e) { glmMsg('Test failed — server not responding.', 'err'); }
      }
      window.saveGlmKey = saveGlmKey;
      window.testGlmKey = testGlmKey;

      function glmMsg(txt, type) {
        const el = document.getElementById('glmKeyMsg'); if (!el) return;
        el.textContent = txt; el.style.display = 'block';
        const c = {
          ok: ['rgba(24,212,144,.1)', 'rgba(24,212,144,.25)', 'var(--gr)'],
          err: ['rgba(240,48,80,.1)', 'rgba(240,48,80,.25)', 'var(--re)'],
          info: ['rgba(64,128,255,.1)', 'rgba(64,128,255,.25)', 'var(--bl)']
        }[type]
          || ['rgba(64,128,255,.1)', 'rgba(64,128,255,.25)', 'var(--bl)'];
        el.style.background = c[0]; el.style.border = `1px solid ${c[1]}`; el.style.color = c[2];
      }

      /* ── Hook into go() for Settings page ─────────────────────────────── */
      const _glmBaseGo = window.go;
      window.go = function (id, el) {
        if (_glmBaseGo) _glmBaseGo(id, el);

      // ── GEMINI (free tier) key field ──────────────────────────────────────
      function injectGeminiSettingsField() {
        const page = document.getElementById('settings');
        if (!page || document.getElementById('gemKeyCard')) return;
        const card = document.createElement('div');
        card.id = 'gemKeyCard';
        card.className = 'card';
        card.style.marginBottom = '12px';
        card.innerHTML = `
        <div style="font-size:13px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:8px">
          ✨ Gemini 2.5 Flash — AI Scout (FREE)
          <span id="gemStatusBadge" style="font-size:10px;padding:2px 8px;border-radius:4px;font-family:var(--mono);background:var(--s2);color:var(--t3)">Checking…</span>
        </div>
        <div style="font-size:11px;color:var(--t3);font-family:var(--mono);line-height:1.7;margin-bottom:10px">
          Free key from <a href="https://ai.google.dev" target="_blank" style="color:var(--bl)">ai.google.dev</a> (starts with <code style="background:var(--s2);padding:1px 5px;border-radius:3px;color:var(--am)">AIza</code>)
          · Gemini 2.5 Flash · <b style="color:var(--gr)">FREE</b> ~1500 req/day · no card needed
        </div>
        <div style="font-size:10px;color:var(--t3);font-family:var(--mono);line-height:1.6;margin-bottom:10px;padding:6px 10px;background:rgba(240,160,0,.06);border:1px solid rgba(240,160,0,.2);border-radius:6px;color:var(--am)">
          ⚠ Privacy: only market analysis routes through Gemini free tier. Portfolio/cash queries use paid path.
        </div>
        <div style="margin-bottom:10px">
          <div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Google AI (Gemini) API Key</div>
          <input id="gemKeyInput" type="password" placeholder="AIzaxxxxxxxxxxxxxxxxxxxx"
            style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none">
        </div>
        <div style="display:flex;gap:8px">
          <button onclick="saveGeminiKey()" style="flex:1;padding:10px;border-radius:10px;border:none;background:linear-gradient(135deg,#4285F4,#34A853);color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">Save Gemini key</button>
          <button onclick="testGeminiKey()" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(24,212,144,.4);background:rgba(24,212,144,.08);color:var(--gr);font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">Test connection →</button>
        </div>
        <div id="gemKeyMsg" style="display:none;margin-top:8px;padding:8px 12px;border-radius:6px;font-size:12px"></div>`;
        const glm = document.getElementById('glmKeyCard');
        if (glm && glm.parentNode) glm.parentNode.insertBefore(card, glm);
        else page.querySelector('.card')?.parentNode?.appendChild(card);
        // status check
        (async () => {
          try {
            const tok = localStorage.getItem('asos_token');
            const r = await fetch('http://localhost:8000/ai/gemini-status', {headers:{'Authorization':`Bearer ${tok}`}});
            const d = await r.json();
            const b = document.getElementById('gemStatusBadge');
            if (d.configured) { b.textContent='Connected ✓'; b.style.background='rgba(24,212,144,.15)'; b.style.color='var(--gr)'; }
            else { b.textContent='Not set'; b.style.background='var(--s2)'; b.style.color='var(--t3)'; }
          } catch(e){ const b=document.getElementById('gemStatusBadge'); if(b){b.textContent='—';} }
        })();
      }
      function _gemMsg(t, ok) { const m=document.getElementById('gemKeyMsg'); if(!m)return; m.style.display='block'; m.textContent=t; m.style.background=ok?'rgba(24,212,144,.1)':'rgba(240,48,80,.1)'; m.style.color=ok?'var(--gr)':'var(--re)'; }
      async function saveGeminiKey() {
        const k = document.getElementById('gemKeyInput').value.trim();
        if (!k) { _gemMsg('Enter a key first.', false); return; }
        try {
          const tok = localStorage.getItem('asos_token');
          const r = await fetch('http://localhost:8000/ai/gemini-setup', {method:'POST',headers:{'Authorization':`Bearer ${tok}`,'Content-Type':'application/json'},body:JSON.stringify({api_key:k})});
          if (r.ok) { _gemMsg('✓ Gemini key saved.', true); injectGeminiSettingsField(); }
          else _gemMsg('Save failed.', false);
        } catch(e){ _gemMsg('Save failed: '+e.message, false); }
      }
      async function testGeminiKey() {
        _gemMsg('Testing…', true);
        try {
          const tok = localStorage.getItem('asos_token');
          const r = await fetch('http://localhost:8000/ai/gemini-test', {method:'POST',headers:{'Authorization':`Bearer ${tok}`}});
          const d = await r.json();
          _gemMsg(d.ok ? '✓ Gemini responding!' : ('Test failed: '+(d.error||'unknown')), !!d.ok);
        } catch(e){ _gemMsg('Test failed: '+e.message, false); }
      }
      window.saveGeminiKey = saveGeminiKey;
      window.testGeminiKey = testGeminiKey;
      window.injectGeminiSettingsField = injectGeminiSettingsField;

        if (id === 'settings') { setTimeout(injectGlmSettingsField, 200); setTimeout(injectGeminiSettingsField, 220); }
      };

      /* ── Check GLM status on app load ─────────────────────────────────── */
      setTimeout(checkGlmStatus, 3000);
    })();
  </script>


  <!-- ASOS Features: Telegram · SIP Optimizer · XIRR · Tax · Screener -->
  <script>
    const _FA = 'http://localhost:8000', _ftok = () => localStorage.getItem('asos_token');
    async function _fa(p, o = {}) { return fetch(_FA + p, { ...o, headers: { 'Authorization': `Bearer ${_ftok()}`, 'Content-Type': 'application/json', ...(o.headers || {}) } }); }

    /* ══ TELEGRAM SETTINGS ══════════════════════════════════════════════════ */
    function injectTelegramSettings() {
      const page = document.getElementById('settings');
      if (!page || document.getElementById('telegramCard')) return;
      const card = document.createElement('div');
      card.id = 'telegramCard'; card.className = 'card'; card.style.marginBottom = '12px';
      card.innerHTML = `
      <div style="font-size:13px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:8px">
        📱 Telegram Alerts
        <span id="tgStatusBadge" style="font-size:10px;padding:2px 8px;border-radius:4px;font-family:var(--mono);background:var(--s2);color:var(--t3)">Not configured</span>
      </div>
      <div style="font-size:11px;color:var(--t3);font-family:var(--mono);line-height:1.8;margin-bottom:10px">
        1. Open <a href="https://t.me/BotFather" target="_blank" style="color:var(--bl)">@BotFather</a> on Telegram → /newbot → copy token<br>
        2. Open <a href="https://t.me/userinfobot" target="_blank" style="color:var(--bl)">@userinfobot</a> → forward any message → copy your Chat ID
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
        <div><div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:5px">Bot Token</div>
          <input id="tg-token" type="password" placeholder="123456789:ABC..." style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none"></div>
        <div><div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:5px">Your Chat ID</div>
          <input id="tg-chatid" type="text" placeholder="123456789" style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none"></div>
      </div>
      <div style="display:flex;gap:8px;margin-bottom:8px">
        <button onclick="saveTgSettings()" style="flex:1;padding:10px;border-radius:10px;border:none;background:linear-gradient(135deg,#0F6E56,#185FA5);color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">Save & Enable Alerts</button>
        <button onclick="testTelegram()" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(24,212,144,.4);background:rgba(24,212,144,.08);color:var(--gr);font-size:13px;font-weight:700;cursor:pointer;font-family:'Space Grotesk',sans-serif">📱 Send Test Alert</button>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
        <div><div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:5px">VIX alert level</div>
          <input id="tg-vix" type="number" value="20" min="10" max="35" style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none"></div>
        <div><div style="font-size:10px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;margin-bottom:5px">SIP day</div>
          <input id="tg-sipday" type="number" value="5" min="1" max="28" style="width:100%;background:var(--s2);border:1px solid var(--b1);border-radius:6px;padding:9px 12px;color:var(--tx);font-size:12px;font-family:var(--mono);outline:none"></div>
      </div>
      <div id="tgMsg" style="display:none;margin-top:8px;padding:8px 12px;border-radius:6px;font-size:12px"></div>
      <div style="margin-top:10px;background:var(--s2);border-radius:8px;padding:9px 12px;font-size:11px;color:var(--t2);line-height:1.7">
        <strong style="color:var(--tx)">You will receive alerts for:</strong><br>
        VIX crossing ${document.getElementById('tg-vix')?.value || 20} · RSI crossing 35/65 for Core 22 stocks · Ladder level hits · SIP day reminder · Sunday digest
      </div>`;
      const kiteCard = document.getElementById('_kCard');
      if (kiteCard && kiteCard.nextSibling) kiteCard.parentNode.insertBefore(card, kiteCard.nextSibling);
      else if (page.firstChild) page.insertBefore(card, page.firstChild);
    }
    async function saveTgSettings() {
      const tok = document.getElementById('tg-token')?.value.trim();
      const cid = document.getElementById('tg-chatid')?.value.trim();
      const vix = document.getElementById('tg-vix')?.value || 20;
      const sip = document.getElementById('tg-sipday')?.value || 5;
      if (!tok || !cid) { tgMsg('Enter bot token and chat ID', 'err'); return; }
      try {
        const cur = await (await _fa('/settings')).json();
        await _fa('/settings', { method: 'POST', body: JSON.stringify({ ...cur, telegram_token: tok, telegram_chat_id: cid, alert_vix_high: vix, sip_date: sip, alerts_enabled: 1 }) });
        tgMsg('✓ Saved. Click "Send Test Alert" to verify', 'ok');
        document.getElementById('tgStatusBadge').textContent = '✓ Configured';
        document.getElementById('tgStatusBadge').style.color = 'var(--gr)';
      } catch (e) { tgMsg('Save failed', 'err'); }
    }
    async function testTelegram() {
      try { const r = await _fa('/alerts/test', { method: 'POST' }); const d = await r.json(); tgMsg(d.message || (d.sent ? '✓ Sent!' : 'Failed'), 'ok'); }
      catch (e) { tgMsg('Test failed — server running?', 'err'); }
    }
    function tgMsg(t, type) {
      const el = document.getElementById('tgMsg'); if (!el) return; el.textContent = t; el.style.display = 'block';
      const c = { ok: ['rgba(24,212,144,.1)', 'rgba(24,212,144,.25)', 'var(--gr)'], err: ['rgba(240,48,80,.1)', 'rgba(240,48,80,.25)', 'var(--re)'] }[type] || ['rgba(64,128,255,.1)', 'rgba(64,128,255,.25)', 'var(--bl)'];
      el.style.background = c[0]; el.style.border = `1px solid ${c[1]}`; el.style.color = c[2];
    }

    /* ══ SIP OPTIMIZER ══════════════════════════════════════════════════════ */
    let _sipData = null;
    async function loadSipOptimizer() {
      const table = document.getElementById('sipAllocationTable');
      if (table) table.innerHTML = '<div style="text-align:center;padding:24px;color:var(--t3);font-size:12px"><div style="width:16px;height:16px;border:2px solid var(--b2);border-top-color:var(--bl);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 8px"></div>Fetching RSI for all Core 22 positions… (~15 seconds)</div>';
      try {
        const r = await _fa('/portfolio/sip-optimize');
        if (!r.ok) throw new Error(await r.text());
        const d = await r.json(); _sipData = d;
        document.getElementById('sipMonthLabel').textContent = `${d.month} · VIX ${d.vix} · ${d.sip_mode} · Deploy ₹${(d.total_planned || 0).toLocaleString('en-IN')} on the ${d.sip_day}th`;
        const modeCol = d.sip_mode.includes('PAUSE') ? 'var(--re)' : d.sip_mode.includes('DOUBLE') ? 'var(--gr)' : d.sip_mode.includes('50%') ? 'var(--am)' : 'var(--gr)';
        const banner = document.getElementById('sipModeBanner');
        if (banner) {
          banner.style.borderLeftColor = modeCol;
          banner.style.background = `${modeCol}10`;
          banner.innerHTML = `<strong style="color:${modeCol}">${d.sip_mode}</strong> &nbsp;·&nbsp; VIX ${d.vix} &nbsp;·&nbsp; <span style="color:var(--t2)">${d.note}</span>`;
        }
        if (!table) return;
        const BUCKET_NAMES = { 1: 'B1 — Index ETFs', 2: 'B2 — Capex & Defence', 3: 'B3 — Compounders', 4: 'B4 — Tactical', 5: 'B5 — Crisis Reserve' };
        const BUCKET_COLS = { 1: 'var(--bl)', 2: 'var(--am)', 3: 'var(--gr)', 4: 'var(--pu)', 5: 'var(--am)' };
        let html = ''; let lastBucket = 0;
        for (const a of d.allocations) {
          if (a.bucket !== lastBucket) {
            if (lastBucket) html += '</div>';
            html += `<div style="margin-bottom:12px"><div style="font-size:10px;font-weight:700;color:${BUCKET_COLS[a.bucket]};margin-bottom:6px;padding-bottom:4px;border-bottom:1px solid var(--b1)">${BUCKET_NAMES[a.bucket] || 'Bucket ' + a.bucket}</div>`;
            lastBucket = a.bucket;
          }
          const amt = a.sip_amount || 0;
          const col = amt > 0 ? (amt >= 10000 ? 'var(--gr)' : 'var(--bl)') : 'var(--t3)';
          html += `<div style="display:grid;grid-template-columns:120px 90px 1fr 120px;gap:8px;align-items:center;padding:6px 0;border-bottom:0.5px solid var(--b1)">
          <div style="font-weight:600;font-size:12px">${a.ticker}</div>
          <div style="font-size:12px;font-weight:700;color:${col};font-family:var(--mono)">₹${amt > 0 ? amt.toLocaleString('en-IN') : '—'}</div>
          <div style="font-size:10px;color:var(--t2)">${a.reason || '—'}</div>
          <div style="display:flex;gap:4px;align-items:center">
            ${a.rsi ? `<div style="font-size:10px;padding:1px 6px;border-radius:4px;font-family:var(--mono);background:${a.rsi < 35 ? 'var(--gd)' : a.rsi > 65 ? 'var(--rd)' : 'var(--s2)'};color:${a.rsi < 35 ? 'var(--gr)' : a.rsi > 65 ? 'var(--re)' : 'var(--t2)'}">RSI ${a.rsi}</div>` : ''}
            <div style="font-size:10px;color:var(--t3);font-family:var(--mono)">${a.curr_pct?.toFixed(1) || 0}%→${a.target_pct}%</div>
          </div>
        </div>`;
        }
        if (lastBucket) html += '</div>';
        html += `<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0 0;border-top:2px solid var(--b1);font-size:13px;font-weight:700"><span>Total this month</span><span style="color:var(--gr)">₹${(d.total_planned || 0).toLocaleString('en-IN')}</span></div>`;
        table.innerHTML = html;
        loadTxnTable();
      } catch (e) { if (table) table.innerHTML = `<div style="color:var(--re);font-size:12px;padding:12px">Error: ${e.message}</div>`; }
    }
    async function sendSipToTelegram() {
      if (!_sipData) { alert('Load SIP Optimizer first'); return; }
      const lines = _sipData.allocations.filter(a => a.sip_amount > 0).map(a => `${a.ticker}: ₹${a.sip_amount?.toLocaleString('en-IN')} (${a.reason})`);
      const msg = `💰 SIP Plan — ${_sipData.month}\nVIX: ${_sipData.vix} → ${_sipData.sip_mode}\nTotal: ₹${(_sipData.total_planned || 0).toLocaleString('en-IN')}\n\n${lines.join('\n')}`;
      try { await _fa('/alerts/send', { method: 'POST', body: JSON.stringify({ message: msg }) }); alert('✓ Sent to Telegram!'); }
      catch (e) { alert('Send failed — configure Telegram in Settings first'); }
    }

    /* ══ TRANSACTIONS ═══════════════════════════════════════════════════════ */
    async function uploadTxns(input) {
      const file = input.files[0]; if (!file) return;
      const fd = new FormData(); fd.append('file', file);
      try {
        const r = await fetch(_FA + '/portfolio/transactions/upload', { method: 'POST', headers: { 'Authorization': `Bearer ${_ftok()}` }, body: fd });
        const d = await r.json(); alert(d.message || 'Upload complete'); loadTxnTable(); loadXirr();
      } catch (e) { alert('Upload failed: ' + e.message); }
    }
    function showAddTxn() { const f = document.getElementById('addTxnForm'); if (f) f.style.display = f.style.display === 'none' ? 'block' : 'none'; }
    async function saveTxn() {
      const date = document.getElementById('tx-date')?.value;
      const ticker = document.getElementById('tx-ticker')?.value?.toUpperCase().trim();
      const type = document.getElementById('tx-type')?.value;
      const qty = document.getElementById('tx-qty')?.value;
      const price = document.getElementById('tx-price')?.value;
      if (!date || !ticker || !qty || !price) { alert('Fill all fields'); return; }
      try {
        await _fa('/portfolio/transactions', { method: 'POST', body: JSON.stringify({ date, ticker, type, quantity: parseFloat(qty), price: parseFloat(price) }) });
        document.getElementById('addTxnForm').style.display = 'none';
        loadTxnTable(); loadXirr();
      } catch (e) { alert('Save failed: ' + e.message); }
    }
    async function loadTxnTable() {
      const el = document.getElementById('txnTableWrap'); if (!el) return;
      try {
        const d = await (await _fa('/portfolio/transactions')).json();
        const txns = d.transactions || [];
        if (!txns.length) { el.innerHTML = '<div style="color:var(--t3);font-size:12px;padding:10px">No transactions. Upload Zerodha trade history CSV or add manually.</div>'; return; }
        el.innerHTML = `<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px">
        <thead><tr style="border-bottom:1px solid var(--b1)">${['Date', 'Stock', 'Type', 'Qty', 'Price', 'Amount'].map(h => `<th style="text-align:left;padding:5px 8px;color:var(--t3);font-size:10px;font-family:var(--mono);text-transform:uppercase">${h}</th>`).join('')}</tr></thead>
        <tbody>${txns.slice(0, 30).map(t => { const c = t.txn_type === 'BUY' ? 'var(--bl)' : 'var(--gr)'; return `<tr><td style="padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.03)">${t.txn_date}</td><td style="padding:6px 8px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.03)">${t.ticker}</td><td style="padding:6px 8px;color:${c};border-bottom:1px solid rgba(255,255,255,.03)">${t.txn_type}</td><td style="padding:6px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${t.quantity}</td><td style="padding:6px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">₹${t.price}</td><td style="padding:6px 8px;font-family:var(--mono);color:${c};border-bottom:1px solid rgba(255,255,255,.03)">₹${Math.round(t.amount).toLocaleString('en-IN')}</td></tr>`; }).join('')}</tbody>
      </table>${txns.length > 30 ? `<div style="font-size:10px;color:var(--t3);padding:6px 8px">${txns.length - 30} more not shown</div>` : ''}</div>`;
      } catch (e) { el.innerHTML = '<div style="color:var(--t3);font-size:12px;padding:10px">Error loading transactions</div>'; }
    }

    /* ══ XIRR ═══════════════════════════════════════════════════════════════ */
    async function loadXirr() {
      try {
        const d = await (await _fa('/portfolio/xirr')).json();
        if (d.error || d.xirr === null) {
          document.getElementById('xirrChart').innerHTML = `<div style="text-align:center;padding:24px;color:var(--am);font-size:12px">⚠ ${d.error || 'No transaction data'}.<br>Upload trade history in the SIP Optimizer page.</div>`; return;
        }
        const boxes = document.querySelectorAll('#xirrMetrics .metric-box');
        const alphaCol = d.alpha > 0 ? 'var(--gr)' : 'var(--re)';
        if (boxes[0]) { boxes[0].querySelector('.mb-v').textContent = `${d.xirr}%`; boxes[0].querySelector('.mb-v').style.color = d.xirr > 20 ? 'var(--gr)' : d.xirr > 12 ? 'var(--am)' : 'var(--re)'; }
        if (boxes[1]) { boxes[1].querySelector('.mb-v').textContent = d.nifty_xirr ? `${d.nifty_xirr}%` : '—'; }
        if (boxes[2]) { boxes[2].querySelector('.mb-v').textContent = d.alpha ? `${d.alpha > 0 ? '+' : ''}${d.alpha}%` : '—'; boxes[2].querySelector('.mb-v').style.color = alphaCol; }
        if (boxes[3]) { boxes[3].querySelector('.mb-v').textContent = `${d.absolute_return > 0 ? '+' : ''}${d.absolute_return}%`; boxes[3].querySelector('.mb-v').style.color = d.absolute_return > 0 ? 'var(--gr)' : 'var(--re)'; }
        document.getElementById('xirrChart').innerHTML = `
        <div style="display:flex;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px">
          <div style="font-size:12px;font-weight:600">Period: ${d.period_start} → ${d.period_end}</div>
          <div style="font-size:11px;color:var(--t2);font-family:var(--mono)">${d.transaction_count} transactions · Invested ₹${(d.total_invested / 1e5).toFixed(2)}L · Now ₹${(d.current_value / 1e5).toFixed(2)}L</div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
          <div style="background:var(--s2);border-radius:8px;padding:12px;text-align:center"><div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:4px">YOUR XIRR</div><div style="font-size:28px;font-weight:700;color:var(--gr)">${d.xirr}%</div></div>
          <div style="background:var(--s2);border-radius:8px;padding:12px;text-align:center"><div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:4px">NIFTY 50 XIRR</div><div style="font-size:28px;font-weight:700">${d.nifty_xirr || '—'}%</div></div>
          <div style="background:var(--s2);border-radius:8px;padding:12px;text-align:center;border:1px solid ${d.alpha > 0 ? 'rgba(24,212,144,.3)' : 'rgba(240,48,80,.3)'}"><div style="font-size:10px;color:var(--t3);font-family:var(--mono);margin-bottom:4px">ALPHA</div><div style="font-size:28px;font-weight:700;color:${alphaCol}">${d.alpha ? `${d.alpha > 0 ? '+' : ''}${d.alpha}` : 0}%</div></div>
        </div>
        <div style="margin-top:10px;background:${d.xirr >= 20 ? 'var(--gd)' : d.xirr >= 12 ? 'var(--ad)' : 'var(--rd)'};border-radius:8px;padding:10px 14px;font-size:12px;color:${d.xirr >= 20 ? 'var(--gr)' : d.xirr >= 12 ? 'var(--am)' : 'var(--re)'}">
          ${d.xirr >= 20 ? '✓ On track for ASOS goal (20% CAGR target). Keep going.' : d.xirr >= 12 ? '⚠ Below 20% target. Review portfolio composition and execution.' : '⚠ Significantly below target. Deep review needed.'}
        </div>`;
      } catch (e) { document.getElementById('xirrChart').innerHTML = `<div style="color:var(--re);font-size:12px;padding:12px">Error: ${e.message}</div>`; }
    }

    /* ══ TAX HARVESTING ════════════════════════════════════════════════════ */
    async function loadTaxHarvest() {
      const wrap = document.getElementById('taxPlanWrap');
      if (wrap) wrap.innerHTML = '<div style="text-align:center;padding:16px;color:var(--t3);font-size:12px">Calculating LTCG/LTCL positions…</div>';
      try {
        const d = await (await _fa('/portfolio/tax-harvest')).json();
        if (d.error) { if (wrap) wrap.innerHTML = `<div style="color:var(--am);font-size:12px;padding:12px">⚠ ${d.error}</div>`; return; }
        const boxes = document.querySelectorAll('#taxMetrics .metric-box');
        if (boxes[0]) { boxes[0].querySelector('.mb-v').textContent = `₹${(d.total_ltcg / 1e5).toFixed(2)}L`; boxes[0].querySelector('.mb-v').style.color = 'var(--am)'; }
        if (boxes[1]) { boxes[1].querySelector('.mb-v').textContent = `₹${(d.total_ltcl / 1e5).toFixed(2)}L`; boxes[1].querySelector('.mb-v').style.color = 'var(--gr)'; }
        if (boxes[2]) { boxes[2].querySelector('.mb-v').textContent = `₹${(d.tax_payable / 1000).toFixed(1)}K`; boxes[2].querySelector('.mb-v').style.color = d.tax_payable > 0 ? 'var(--re)' : 'var(--gr)'; }
        if (boxes[3]) { boxes[3].querySelector('.mb-v').textContent = `₹${(d.tax_saved_if_harvest / 1000).toFixed(1)}K`; boxes[3].querySelector('.mb-v').style.color = 'var(--gr)'; }
        if (wrap) wrap.innerHTML = `
        <div style="background:var(--gd);border-radius:8px;padding:10px 14px;margin-bottom:12px;font-size:12px;color:var(--gr);line-height:1.8">
          <strong>FY 2026–27 Tax Plan</strong><br>${d.plan_summary}<br>
          <span style="color:var(--t2)">LTCG exemption: ₹1.25L · Harvest deadline: ${d.harvest_deadline}</span>
        </div>
        <div style="margin-bottom:8px;font-size:12px;font-weight:600">LTCG positions (held &gt;1 year, profit)</div>
        ${d.ltcg_positions.length ? `<table style="width:100%;border-collapse:collapse;font-size:11px;margin-bottom:12px">
          <thead><tr style="border-bottom:1px solid var(--b1)">${['Stock', 'Bought', 'Days held', 'Buy price', 'LTP', 'LTCG (₹)'].map(h => `<th style="text-align:left;padding:4px 8px;color:var(--t3);font-size:10px;font-family:var(--mono);text-transform:uppercase">${h}</th>`).join('')}</tr></thead>
          <tbody>${d.ltcg_positions.map(p => `<tr><td style="padding:5px 8px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.03)">${p.ticker}</td><td style="padding:5px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${p.buy_date}</td><td style="padding:5px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${p.days_held}d</td><td style="padding:5px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">₹${p.buy_price}</td><td style="padding:5px 8px;font-family:var(--mono);color:var(--bl);border-bottom:1px solid rgba(255,255,255,.03)">₹${p.ltp}</td><td style="padding:5px 8px;font-family:var(--mono);color:var(--am);font-weight:600;border-bottom:1px solid rgba(255,255,255,.03)">+₹${Math.round(p.gain).toLocaleString('en-IN')}</td></tr>`).join('')}</tbody>
        </table>`: '<div style="color:var(--t3);font-size:11px;padding:8px">No LTCG positions yet</div>'}
        <div style="margin-bottom:8px;font-size:12px;font-weight:600">LTCL positions (held &gt;1 year, loss) — harvest to offset LTCG</div>
        ${d.ltcl_positions.length ? `<table style="width:100%;border-collapse:collapse;font-size:11px">
          <thead><tr style="border-bottom:1px solid var(--b1)">${['Stock', 'Bought', 'Days held', 'Buy price', 'LTP', 'LTCL (₹)', 'Action'].map(h => `<th style="text-align:left;padding:4px 8px;color:var(--t3);font-size:10px;font-family:var(--mono);text-transform:uppercase">${h}</th>`).join('')}</tr></thead>
          <tbody>${d.ltcl_positions.map(p => `<tr><td style="padding:5px 8px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.03)">${p.ticker}</td><td style="padding:5px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${p.buy_date}</td><td style="padding:5px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">${p.days_held}d</td><td style="padding:5px 8px;font-family:var(--mono);border-bottom:1px solid rgba(255,255,255,.03)">₹${p.buy_price}</td><td style="padding:5px 8px;font-family:var(--mono);color:var(--bl);border-bottom:1px solid rgba(255,255,255,.03)">₹${p.ltp}</td><td style="padding:5px 8px;font-family:var(--mono);color:var(--re);font-weight:600;border-bottom:1px solid rgba(255,255,255,.03)">₹${Math.round(p.gain).toLocaleString('en-IN')}</td><td style="padding:5px 8px;border-bottom:1px solid rgba(255,255,255,.03)"><span style="font-size:10px;padding:2px 7px;border-radius:4px;background:var(--gd);color:var(--gr);border:1px solid rgba(24,212,144,.3);font-family:var(--mono)">HARVEST</span></td></tr>`).join('')}</tbody>
        </table>`: '<div style="color:var(--t3);font-size:11px;padding:8px">No LTCL positions</div>'}`;
        const hp = document.getElementById('taxHarvestPlan');
        if (hp) hp.innerHTML = d.harvest_ltcl_plan?.length ?
          `<div style="background:var(--gd);border-radius:8px;padding:10px 14px;font-size:12px;color:var(--gr);line-height:1.8">Book these LTCL positions before ${d.harvest_deadline} to offset your LTCG and save ₹${(d.tax_saved_if_harvest / 1000).toFixed(1)}K in tax:<br><br>${d.harvest_ltcl_plan.map(p => `<strong>${p.ticker}</strong> — ₹${Math.abs(Math.round(p.gain)).toLocaleString('en-IN')} loss, held ${p.days_held} days`).join('<br>')}</div>` :
          '<div style="color:var(--gr);font-size:12px;padding:10px">✓ No LTCL harvesting needed — your LTCG is within the ₹1.25L exemption limit</div>';
      } catch (e) { if (wrap) wrap.innerHTML = `<div style="color:var(--re);font-size:12px;padding:12px">Error: ${e.message}</div>`; }
    }

    /* ══ SCREENER SYNC ══════════════════════════════════════════════════════ */
    async function runScreenerSync() {
      const btn = document.getElementById('screenerSyncBtn');
      if (btn) { btn.disabled = true; btn.textContent = 'Syncing… (~2 min)'; }
      try {
        const d = await (await _fa('/portfolio/screener-sync', { method: 'POST' })).json();
        alert(`✓ Screener sync complete: ${d.updated?.length || 0} stocks updated, ${d.failed?.length || 0} failed`);
      } catch (e) { alert('Sync failed: ' + e.message); }
      finally { if (btn) { btn.disabled = false; btn.textContent = '↻ Sync now'; } }
    }

    /* ══ HOOK go() ══════════════════════════════════════════════════════════ */
    const _featBaseGo = window.go;
    window.go = function (id, el) {
      if (_featBaseGo) _featBaseGo(id, el);
      if (id === 'sipopt') { setTimeout(() => { loadSipOptimizer(); loadTxnTable(); }, 100); }
      if (id === 'xirr') { setTimeout(loadXirr, 100); }
      if (id === 'taxharvest') { setTimeout(loadTaxHarvest, 100); }
      if (id === 'settings') { setTimeout(injectTelegramSettings, 250); }
    };

    console.log('✅ Features loaded: Telegram · SIP Optimizer · XIRR · Tax · Screener');
  </script>


  <!-- ATHENA S-1: market clock, cash ledger, income, live actions -->
  <script>
    const _AC = 'http://localhost:8000', _actok = () => localStorage.getItem('asos_token');
    async function _ac(p, o = {}) { return fetch(_AC + p, { ...o, headers: { 'Authorization': `Bearer ${_actok()}`, 'Content-Type': 'application/json', ...(o.headers || {}) } }); }

    /* ── Market clock: IST + weekends + NSE holidays (fixes B-2) ── */
    async function updateMarketClock() {
      try {
        const d = await (await fetch(_AC + '/clock')).json();
        const pill = document.getElementById('marketStatusPill');
        if (pill) {
          pill.className = 'tpill ' + (d.status === 'open' ? 'tpill-g' : d.status === 'pre-open' ? 'tpill-a' : 'tpill-r');
          pill.innerHTML = (d.status === 'open' ? '<span class="blink"></span>' : '') +
            d.label + ' · ' + d.next_session_label + ' ' + d.next_session;
        }
        const clk = document.getElementById('sidebarClock');
        if (clk) clk.textContent = d.ist + ' IST · ' + d.date;
      } catch (e) { }
    }
    updateMarketClock(); setInterval(updateMarketClock, 30000);

    /* ── Cash ledger pill (fixes B-1) ── */
    async function updateCashPill() {
      try {
        const d = await (await _ac('/cash/summary')).json();
        const pill = document.getElementById('topRightPill');
        if (pill) {
          if (d.show_pill) { pill.style.display = ''; pill.textContent = d.pill_text; }
          else pill.style.display = 'none';
        }
        const v = document.getElementById('dmPendingVal');
        const l = document.getElementById('dmPendingLbl');
        if (v) v.textContent = d.pending_total > 0 ? '₹' + (d.pending_total / 1e5).toFixed(2) + 'L' :
          (d.idle_cash > 0 ? '₹' + (d.idle_cash / 1e5).toFixed(2) + 'L' : '₹0');
        if (l) l.textContent = d.pending_total > 0 ? 'Pending T+1' : (d.idle_cash > 0 ? 'Idle cash — deploy' : 'No pending cash');
      } catch (e) { }
    }
    updateCashPill(); setInterval(updateCashPill, 60000);

    /* ── Income tracker (Arnab's prime goal) ── */
    async function updateIncome() {
      try {
        const d = await (await _ac('/income/summary')).json();
        const o = document.getElementById('incOpt'), oe = document.getElementById('incOptT');
        const q = document.getElementById('incEq'), qe = document.getElementById('incEqT');
        if (o) o.textContent = '₹' + (d.option_income / 1000).toFixed(1) + 'K';
        if (oe) oe.textContent = d.option_pct + '% of ₹' + (d.option_target / 1000) + 'K target';
        if (q) q.textContent = '₹' + (d.equity_realized / 1000).toFixed(1) + 'K';
        if (qe) qe.textContent = 'target ₹' + (d.equity_target / 1000) + 'K · ' + d.month;
      } catch (e) { }
    }
    updateIncome();

    /* ── Live daily actions (fixes B-5) ── */
    async function loadTodayActions() {
      const el = document.getElementById('todayActions'); if (!el) return;
      try {
        const d = await (await _ac('/actions/today')).json();
        if (!d.actions?.length) { el.innerHTML = '<div style="color:var(--gr);font-size:12px;padding:10px">✓ All clear — no actions needed today</div>'; return; }
        el.innerHTML = d.actions.map(a => `
        <div style="display:flex;gap:10px;align-items:flex-start;padding:10px;background:var(--s2);border-radius:var(--r);margin-bottom:6px;border-left:3px solid ${a.priority === 1 ? 'var(--re)' : a.priority === 2 ? 'var(--am)' : 'var(--bl)'}">
          <input type="checkbox" onchange="markAction(${a.id},'done')" style="margin-top:3px;cursor:pointer">
          <div style="flex:1">
            <div style="font-size:13px;font-weight:600">${a.title}</div>
            <div style="font-size:11px;color:var(--t2)">${a.detail}</div>
          </div>
          <button onclick="markAction(${a.id},'dismissed')" style="background:none;border:none;color:var(--t3);cursor:pointer;font-size:14px">✕</button>
        </div>`).join('');
      } catch (e) { el.innerHTML = '<div style="color:var(--t3);font-size:12px;padding:10px">Actions unavailable</div>'; }
    }
    async function markAction(id, st) { await _ac(`/actions/${id}/${st}`, { method: 'POST' }); loadTodayActions(); }
    window.markAction = markAction;
    setTimeout(loadTodayActions, 800);
  </script>


  <!-- Settings page assembly: Zerodha card restore + ordering -->
  <script>
    (function () {
      const _sBaseGo = window.go;
      window.go = function (id, el) {
        if (_sBaseGo) _sBaseGo(id, el);
        if (id === 'settings') {
          // Order matters: Zerodha card first, then GLM, then Telegram insert after it
          setTimeout(async () => {
            try { if (typeof _injectSettings === 'function') await _injectSettings(); } catch (e) { }
          }, 50);
        }
      };
      // If user lands directly on settings (e.g. after Zerodha redirect)
      setTimeout(async () => {
        const pg = document.getElementById('settings');
        if (pg && pg.classList.contains('on')) {
          try { if (typeof _injectSettings === 'function') await _injectSettings(); } catch (e) { }
        }
      }, 1200);
    })();
  </script>

</body>

</html>